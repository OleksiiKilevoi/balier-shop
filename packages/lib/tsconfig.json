{
  "extends": "../../tsconfig.base.json",
  "include": ["src/**/*.ts"],
  "compilerOptions": {
    // DOM for the client-side modules (admin/forms, cart/store, cartPopup,
    // phone). Workers runtime types come from src/env.d.ts, not the ambient
    // workers-types package — that one collides with the DOM lib.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"]
  }
}
