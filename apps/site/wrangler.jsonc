{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Must match the Worker that Workers Builds actually deploys to. It does not
  // say `balier`: the live dev Worker is `balier-dev`, and a mismatch here means
  // `pnpm deploy` silently creates a *second*, empty Worker under the config's
  // name instead of updating the running one. Phase 5 stands the store up again
  // on the client's account, and that Worker gets its own name.
  "name": "balier-dev",
  // Custom domain for the dev deployment, on `mlosko.dev` (bought 2026-08-04 to
  // unblock Cloudflare Access and Email Sending, both of which need a zone on
  // this account — `*.workers.dev` cannot be an Access application hostname).
  // Cloudflare creates the DNS record and the certificate itself, but only once
  // the zone reads Active: deploying this route before that fails.
  //
  // The `workers.dev` URL keeps working alongside it. `/admin` there stays 403,
  // because no Access policy can cover a `workers.dev` hostname and the in-app
  // JWT check in `src/middleware.ts` refuses an unauthenticated request anyway.
  // That gap is precisely why `docs/CONVENTIONS.md` asks for the second check.
  "routes": [{ "pattern": "balier.mlosko.dev", "custom_domain": true }],
  // Explicit, not incidental: adding `routes` makes wrangler disable the
  // `workers.dev` URL by default anyway, and one hostname is what we want —
  // `balier-dev.<subdomain>.workers.dev` was a second public surface that no
  // Access policy could cover. Older notes in `docs/STATE.md` that name it as
  // the live test URL predate this. Set it to `true` to bring it back.
  "workers_dev": false,
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // Product photography, prepared at the right size before upload — one file is
  // one object is one URL, nothing is resized here. Served through the app Worker
  // at `/media/**`, never over the bucket's public `r2.dev` URL (rate-limited,
  // and documented as unsuitable for production).
  //   wrangler r2 bucket create balier-media
  //
  // `remote: true` points this binding at the real bucket **in local development
  // too**, and is the reason the panel's uploads exist anywhere but this laptop.
  // Without it, `pnpm dev` binds MEDIA to Miniflare's simulated bucket under
  // `.wrangler/state/v3/r2/`, so a photo uploaded through `/admin/products/…`
  // was written to disk while its `product_images` row went to the *real* Neon
  // database — a row pointing at an object no deployed Worker could ever serve.
  // Local R2 and remote Postgres is the one combination that silently produces
  // broken data rather than a broken screen.
  //
  // The flag is local-development only; a deployed Worker always had the real
  // bucket. The cost is that dev writes are real writes: an upload made while
  // testing puts an object in the production bucket and it stays there.
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "balier-media",
      "remote": true
    }
  ],
  // Cloudflare Email Sending — order-confirmation emails to customers
  // (`src/lib/notify/email.ts`). Requires Workers Paid (enabled 2026-08-04).
  // Sending is enabled on `mail.mlosko.dev`, a dedicated subdomain rather than
  // the apex, so `mlosko.dev` keeps its MX records free for real inbound mail.
  // Sends fail closed with `E_SENDER_NOT_VERIFIED` (caught, logged, never thrown
  // into checkout — same best-effort contract as `NotifierPort`) until
  // `wrangler email sending enable mail.mlosko.dev` has run and its DNS records
  // are in place. Phase 5 swaps the sender to `balier.ua` on the client account.
  "send_email": [{ "name": "EMAIL" }],
  // Secrets are NOT set here. Locally they live in `.dev.vars`; in production
  // they are set with `wrangler secret put <NAME>` from this directory.
  //   DATABASE_URL, MONOBANK_TOKEN, TURNSTILE_SECRET_KEY,
  //   TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID
  //
  // ADMIN_SESSION_SECRET belongs to the admin Worker (`apps/admin`) now, and
  // NOVAPOSHTA_API_KEY to the cron Worker — neither is read here.
  "vars": {
    "PUBLIC_SITE_URL": "https://balier.ua",
    // `from` address for order-confirmation emails. Not `PUBLIC_` — server-only,
    // never sent to the client. See the `send_email` binding comment above:
    // this does nothing until the domain is onboarded.
    "ORDER_EMAIL_FROM": "noreply@mail.mlosko.dev",
    // Telegram account the product page's «Замовити через Телеграм» deep-links
    // to. Public by definition — it ends up in an href. PLACEHOLDER: the real
    // manager account is a Phase 0 item and does not exist yet, so this handle
    // is a guess and the button currently points at nothing. `orderDeepLink`
    // validates it, so an empty value hides the button rather than breaking it.
    "PUBLIC_TELEGRAM_MANAGER": "balier_ua",
    // Turnstile site key — public by definition, it was embedded in the
    // checkout page's HTML. The paired secret (`TURNSTILE_SECRET_KEY`) is a
    // Worker secret, never here.
    // CURRENTLY UNUSED: Turnstile is commented out (2026-08-05, on request) —
    // see the `Turnstile:` markers in `src/pages/checkout.astro`. Both values
    // are kept set so uncommenting is all it takes to bring it back.
    "PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAEF8vF0-cXNWdOOY"
  },

  // CACHE is not created yet — nothing needs it. RATE_LIMIT backs the
  // per-IP counters in `src/middleware.ts` (`wrangler kv namespace create
  // RATE_LIMIT`, 2026-08-04).
  //   wrangler kv namespace create CACHE
  "kv_namespaces": [{ "binding": "RATE_LIMIT", "id": "8ef01313c48a4dcea67fc75f2b50129f" }]
}
