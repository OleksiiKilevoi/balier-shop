{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Must match the Worker that Workers Builds actually deploys to. A mismatch
  // does not error — `wrangler deploy` silently creates a *second*, empty
  // Worker under the config's name and leaves the live one untouched.
  // Production Worker on the client's Cloudflare account (docs/plans/launch.md,
  // L2/L3). The retired dev deployment was `balier-dev` on `balier.mlosko.dev`.
  "name": "balier",
  // Custom domain. Cloudflare creates the DNS record and the certificate
  // itself, but only once the `balier.com.ua` zone reads Active on the account —
  // deploying this route before that fails.
  "routes": [{ "pattern": "balier.com.ua", "custom_domain": true }],
  // Explicit, not incidental: adding `routes` makes wrangler disable the
  // `workers.dev` URL by default anyway, and one hostname is what we want — a
  // `workers.dev` URL would be a second public surface. `true` brings it back.
  "workers_dev": false,
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // Product photography, prepared at the right size before upload — one file is
  // one object is one URL, nothing is resized here. Served through the app Worker
  // at `/media/**`, never over the bucket's public `r2.dev` URL (rate-limited,
  // and documented as unsuitable for production).
  //   wrangler r2 bucket create balier-media
  //
  // `remote: true` points this binding at the real bucket **in local development
  // too**. Without it, `pnpm dev` binds MEDIA to Miniflare's simulated bucket
  // under `.wrangler/state/v3/r2/`, so a photo uploaded through the panel is
  // written to disk while its `product_images` row goes to the *real* database
  // — local R2 and remote Postgres is the one combination that silently
  // produces broken data rather than a broken screen. The cost is that dev
  // writes are real writes. `CLOUDFLARE_VITE_FORCE_LOCAL=true pnpm dev` forces
  // the isolated behaviour for a session without editing this file.
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "balier-media",
      "remote": true
    }
  ],
  // Cloudflare Email Sending — order-confirmation emails to customers
  // (`@balier/lib/notify/email`). Requires Workers Paid. Sending is enabled on
  // a dedicated subdomain rather than the apex, so `balier.com.ua` keeps its MX
  // records free for the client's real inbound mail:
  //   wrangler email sending enable mail.balier.com.ua   (+ the dashboard's DNS
  //   auto-onboard button — wrangler's OAuth token has no DNS-edit scope)
  // Sends fail closed with `E_SENDER_NOT_VERIFIED` (caught, logged, never
  // thrown into checkout — same best-effort contract as `NotifierPort`) until
  // those DNS records exist.
  "send_email": [{ "name": "EMAIL" }],
  // Secrets are NOT set here. Locally they live in `.dev.vars`; in production
  // they are set with `wrangler secret put <NAME>` from this directory:
  //   DATABASE_URL, MONOBANK_TOKEN, TURNSTILE_SECRET_KEY (only if Turnstile
  //   is switched back on), TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID
  //
  // ADMIN_SESSION_SECRET belongs to the admin Worker (`apps/admin`), and
  // NOVAPOSHTA_API_KEY to the admin and cron Workers — none is read here.
  //
  // Everything in `vars` is the COMPLETE set of plaintext variables: Workers
  // Builds sends this block on every push and a variable added in the
  // dashboard as Text is silently dropped by the next deploy. Anything
  // sensitive is an encrypted Secret, never a var (docs/OVERVIEW.md).
  "vars": {
    "PUBLIC_SITE_URL": "https://balier.com.ua",
    // `from` address for order-confirmation emails. Not `PUBLIC_` — server-only,
    // never sent to the client. Does nothing until the sender subdomain above
    // is onboarded.
    "ORDER_EMAIL_FROM": "noreply@mail.balier.com.ua",
    // Telegram account the product page's «Замовити через Телеграм» deep-links
    // to. Public by definition — it ends up in an href. EMPTY ON PURPOSE until
    // the client names the manager account (launch.md L0): `orderDeepLink`
    // validates it, and an empty value hides the button rather than shipping a
    // link to a stranger.
    "PUBLIC_TELEGRAM_MANAGER": "balierua",
    // Turnstile site key — public by definition, it was embedded in the
    // checkout page's HTML. The paired secret (`TURNSTILE_SECRET_KEY`) is a
    // Worker secret, never here.
    // CURRENTLY UNUSED: Turnstile is commented out (2026-08-05, on request,
    // and off at launch by decision) — see the `Turnstile:` markers in
    // `src/pages/checkout.astro`. Bringing it back means a new widget on the
    // client's account for `balier.com.ua`; this key belongs to the retired dev
    // widget and is kept only so the var stays typed.
    "PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAEF8vF0-cXNWdOOY",
    // Sentry (`docs/plans/sentry.md`) — a DSN is a public project identifier,
    // not a secret. One project (`balier`) for all three Workers; the wrapper
    // in `src/middleware.ts` tags events `worker:site`. The Sentry org stays
    // ours after launch by decision; only the environment tag changed.
    "SENTRY_DSN": "https://10cc802695139cc28dd32cf305de6f34@o4504565189378049.ingest.us.sentry.io/4511881341370368",
    "SENTRY_ENVIRONMENT": "production"
  },

  // RATE_LIMIT backs the per-IP counters in `src/middleware.ts`, and the admin
  // Worker shares the same namespace on purpose (one login budget). Created on
  // the client's account at launch.md L2:
  //   wrangler kv namespace create RATE_LIMIT
  // and the id it prints goes here AND in `apps/admin/wrangler.jsonc`. The
  // placeholder below makes a deploy fail loudly rather than bind to nothing.
  // CACHE is not created — nothing needs it.
  "kv_namespaces": [{ "binding": "RATE_LIMIT", "id": "5a26a4dd230e4874ad6f3fb8c349bc52" }]
}
