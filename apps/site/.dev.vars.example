# Copy to `.dev.vars` and fill in. Read by wrangler for local dev of the
# storefront Worker. `.dev.vars` is gitignored — never commit it.
#
# In production these are set with: wrangler secret put <NAME>  (from this dir)

# Neon pooled connection string (EU Frankfurt project)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/balier?sslmode=require"

# Monobank Acquiring. Use the TEST token until Phase 5.
# https://api.monobank.ua/docs/acquiring.html
MONOBANK_TOKEN=""


# Telegram bot for new-order notifications
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# monobank «Покупка частинами» — all three, or the option is off. Sandbox values
# (from monobank's public docs) shown; production keys come from the bank and
# go in with `wrangler secret put`, never in this file's committed copy.
MONO_PARTS_URL="https://u2-demo-ext.mono.st4g3.com"
MONO_PARTS_STORE_ID="test_store_with_confirm"
MONO_PARTS_SECRET="secret_98765432--123-123"
