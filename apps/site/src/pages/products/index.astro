---
import { env } from 'cloudflare:workers';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Container from '~/components/Container.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import ProductCard from '~/components/ProductCard.astro';
import CategoryNav from '~/components/CategoryNav.astro';
import { createDb } from '@balier/lib/db';
import { listActiveProducts } from '@balier/lib/db/queries/products';
import { listActiveCategories } from '@balier/lib/db/queries/categories';
import { pluralUk } from '@balier/lib/i18n/plural';

export const prerender = false;

// Per request — never a module-scope singleton, every request is a fresh isolate.
const db = createDb(env.DATABASE_URL);
const [products, categories] = await Promise.all([listActiveProducts(db), listActiveCategories(db)]);

/**
 * The first row is two cards on a phone, so only those two skip lazy loading.
 * Eagerly loading four would fetch two full-size photos below the fold on the
 * viewport that can least afford them — the audience arrives from Instagram.
 */
const EAGER_CARDS = 2;

// Built here rather than as two adjacent expressions in the markup — the
// whitespace between those is collapsed away and the count runs into the noun.
const countLabel = `${products.length} ${pluralUk(products.length, {
  one: 'товар',
  few: 'товари',
  many: 'товарів',
})}`;
---

<BaseLayout
  title="Товари"
  description="Шкіряні сумки та гаманці ручної роботи. Обмежені партії, доставка Новою Поштою по всій Україні."
>
  <Container class="py-8 sm:py-12">
    <Breadcrumbs items={[{ label: 'Головна', href: '/' }, { label: 'Товари' }]} />

    <header class="mt-5 sm:mt-6">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl">Наша колекція</h1>
      <p class="text-ink-muted mt-1.5 text-sm">{countLabel}</p>
    </header>

    {/* Sidebar + grid from lg; below that the nav is a chip row above the grid. */}
    <div class="mt-6 sm:mt-8 lg:grid lg:grid-cols-[12rem_minmax(0,1fr)] lg:gap-10">
      <CategoryNav
        categories={categories}
        current={null}
        total={products.length}
        class="lg:sticky lg:top-24 lg:self-start"
      />
    {
      products.length > 0 ? (
        /* Two columns down to 320px: one full-width card per row wastes the
           screen, and three squeezes the title to two words a line. Four columns
           wait for xl now that the sidebar takes 12rem of lg's width. */
        <div class="mt-5 grid grid-cols-2 gap-3 sm:gap-5 md:grid-cols-3 lg:mt-0 lg:gap-6 xl:grid-cols-4">
          {products.map((product, index) => (
            <ProductCard
              slug={product.slug}
              title={product.title}
              category={product.categoryTitle}
              price={product.price}
              imageUrl={product.imageUrl}
              imageAlt={product.imageAlt}
              swatches={product.swatches}
              soldOut={!product.inStock}
              eager={index < EAGER_CARDS}
            />
          ))}
        </div>
      ) : (
        <p class="text-ink-muted mt-5 lg:mt-0">Товарів поки немає. Зазирніть, будь ласка, трохи пізніше.</p>
      )
    }
    </div>
  </Container>
</BaseLayout>
