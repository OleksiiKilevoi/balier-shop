---
import { env } from 'cloudflare:workers';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Container from '~/components/Container.astro';
import Button from '~/components/Button.astro';
import ProductGallery from '~/components/ProductGallery.astro';
import QuantityStepper from '~/components/QuantityStepper.astro';
import { createDb } from '@balier/lib/db';
import { getProductBySlug } from '@balier/lib/db/queries/products';
import { DELIVERY_DAYS, PARCEL_TARIFFS } from '@balier/lib/novaposhta/parcel';
import { getProductReviews } from '@balier/lib/db/queries/reviews';
import { listCompanionOffers } from '@balier/lib/db/queries/cart';
import {
  PARTS_AD_LEGAL,
  PARTS_COUNTS,
  PARTS_MIN_TOTAL,
  PARTS_NAME,
  monoPartsFromEnv,
} from '@balier/lib/monoparts';
import { pluralUk } from '@balier/lib/i18n/plural';
import { formatPrice } from '@balier/lib/money';
import { orderDeepLink } from '@balier/lib/telegram';
import { MAX_ITEM_QUANTITY } from '@balier/lib/validation/cart';

export const prerender = false;

const db = createDb(env.DATABASE_URL);
const [product, reviews] = await Promise.all([
  getProductBySlug(db, Astro.params.slug ?? ''),
  getProductReviews(db, Astro.params.slug ?? ''),
]);
if (!product) return Astro.rewrite('/404');

const companions = await listCompanionOffers(db, product.id, product.companionDiscountPercent);


const reviewDate = new Intl.DateTimeFormat('uk-UA', { day: 'numeric', month: 'long', year: 'numeric' });
const stars = (rating: number) => '★'.repeat(rating) + '☆'.repeat(5 - rating);

// Guaranteed by the query — every product has at least one active variant — but
// `noUncheckedIndexedAccess` is right to make us say so.
const [defaultVariant] = product.variants;
if (!defaultVariant) return Astro.rewrite('/404');

/** Monthly payment at the most parts, rounded up to whole hryvnias; null when not offered. */
const partsFrom =
  monoPartsFromEnv(env) && defaultVariant.price >= PARTS_MIN_TOTAL
    ? Math.ceil(defaultVariant.price / Math.max(...PARTS_COUNTS) / 100) * 100
    : null;

/**
 * A variant is a colour × size. The page shows one row of colours and one of
 * sizes — each only when there is more than one to choose from — and the
 * script resolves the pair back to a variant.
 */
const colours = [
  ...new Map(
    product.variants.flatMap((variant) =>
      variant.colorName ? [[variant.colorName, { name: variant.colorName, hex: variant.colorHex }] as const] : [],
    ),
  ).values(),
];
const sizes = [...new Set(product.variants.flatMap((variant) => (variant.size ? [variant.size] : [])))];
const hasColourChoice = colours.length > 1;
const hasSizeChoice = sizes.length > 1;
/** What the script needs to resolve a colour and a size to a variant. */
const variantData = product.variants.map((variant) => ({
  id: variant.id,
  sku: variant.sku,
  price: variant.price,
  inStock: variant.inStock,
  colour: variant.colorName,
  size: variant.size,
  dimensions: variant.dimensions ?? product.dimensions,
}));
const defaultLabel = variantLabel(
  hasColourChoice ? defaultVariant.colorName : null,
  hasSizeChoice ? defaultVariant.size : null,
);
const defaultDimensions = defaultVariant.dimensions ?? product.dimensions;

const detailLines =
  product.details
    ?.split('\n')
    .map((line) => line.trim())
    .filter(Boolean) ?? [];

const productUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const manager = env.PUBLIC_TELEGRAM_MANAGER;

/**
 * Rendered server-side for the default variant, then rebuilt by the script below
 * as the colour and quantity change. Null when no manager is configured, in
 * which case the button is simply not rendered.
 */
const telegramHref = orderDeepLink(manager, {
  title: product.title,
  sku: defaultVariant.sku,
  price: defaultVariant.price,
  quantity: 1,
  url: productUrl,
  variantName: defaultLabel,
});

const inStock = defaultVariant.inStock;

/**
 * Structured data for the product rich result. Prices are the default
 * variant's, in hryvnias (schema.org wants a decimal, not kopiykas); images
 * are absolute because the crawler resolves nothing. Colour variants are not
 * modelled as separate offers — one price, one SKU, one availability flag is
 * what the page itself shows before a swatch is picked.
 */
const origin = (Astro.site ?? Astro.url).origin;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: product.title,
    description: product.metaDescription ?? product.description ?? undefined,
    sku: defaultVariant.sku,
    image: product.images.map((image) => new URL(image.url, origin).href),
    brand: { '@type': 'Brand', name: 'BÁLIER' },
    // No `category`: Google reads it against its own product taxonomy and flags
    // a free-text name as invalid. The BreadcrumbList below carries the category.
    offers: {
      '@type': 'Offer',
      url: productUrl,
      priceCurrency: 'UAH',
      price: (defaultVariant.price / 100).toFixed(2),
      availability: inStock ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock',
      itemCondition: 'https://schema.org/NewCondition',
      // Nova Poshta branch to branch, paid by the recipient: the carrier's
      // tariff for this product's box (`PARCEL_TARIFFS`), stated, never charged.
      shippingDetails: {
        '@type': 'OfferShippingDetails',
        shippingRate: {
          '@type': 'MonetaryAmount',
          value: (PARCEL_TARIFFS[product.parcelSize] / 100).toFixed(2),
          currency: 'UAH',
        },
        shippingDestination: { '@type': 'DefinedRegion', addressCountry: 'UA' },
        deliveryTime: {
          '@type': 'ShippingDeliveryTime',
          handlingTime: {
            '@type': 'QuantitativeValue',
            minValue: DELIVERY_DAYS.handling.min,
            maxValue: DELIVERY_DAYS.handling.max,
            unitCode: 'DAY',
          },
          transitTime: {
            '@type': 'QuantitativeValue',
            minValue: DELIVERY_DAYS.transit.min,
            maxValue: DELIVERY_DAYS.transit.max,
            unitCode: 'DAY',
          },
        },
      },
      // The terms on /returns: the buyer sends the return by Nova Poshta at
      // their own cost — `ReturnFeesCustomerResponsibility`, which needs no
      // amount (`ReturnShippingFees` would demand a fixed one).
      hasMerchantReturnPolicy: {
        '@type': 'MerchantReturnPolicy',
        applicableCountry: 'UA',
        returnPolicyCountry: 'UA',
        returnPolicyCategory: 'https://schema.org/MerchantReturnFiniteReturnWindow',
        merchantReturnDays: 14,
        returnMethod: 'https://schema.org/ReturnByMail',
        returnFees: 'https://schema.org/ReturnFeesCustomerResponsibility',
        merchantReturnLink: `${origin}/returns`,
      },
    },
    // Only published reviews, and only when there is at least one — an empty
    // aggregateRating is invalid structured data.
    ...(reviews.count > 0
      ? {
          aggregateRating: {
            '@type': 'AggregateRating',
            ratingValue: reviews.average,
            reviewCount: reviews.count,
            bestRating: 5,
            worstRating: 1,
          },
          review: reviews.reviews.slice(0, 10).map((review) => ({
            '@type': 'Review',
            author: { '@type': 'Person', name: review.authorName },
            datePublished: review.publishedAt.toISOString().slice(0, 10),
            reviewRating: { '@type': 'Rating', ratingValue: review.rating, bestRating: 5 },
            ...(review.body ? { reviewBody: review.body } : {}),
          })),
        }
      : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Головна', item: `${origin}/` },
      { '@type': 'ListItem', position: 2, name: 'Товари', item: `${origin}/products` },
      ...(product.categoryTitle && product.categorySlug
        ? [
            {
              '@type': 'ListItem',
              position: 3,
              name: product.categoryTitle,
              item: `${origin}/products/category/${product.categorySlug}`,
            },
          ]
        : []),
      {
        '@type': 'ListItem',
        position: product.categoryTitle && product.categorySlug ? 4 : 3,
        name: product.title,
        item: productUrl,
      },
    ],
  },
];
import { variantLabel } from '@balier/lib/products/variant';
---

<BaseLayout
  title={product.metaTitle ?? product.title}
  description={product.metaDescription ?? product.description ?? undefined}
  ogImage={product.images[0]?.url}
  noindex={product.hiddenFromSearch}
>
  <script type="application/ld+json" slot="head" is:inline set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />
  <Container class="py-6 sm:py-10 lg:py-14">
    {/* One column on a phone: the gallery leads, then everything that decides
        the purchase. The mockup's side-by-side split needs both halves ~550px,
        so it only arrives at lg. */}
    <div
      class="grid gap-8 lg:grid-cols-2 lg:gap-12"
      data-product
      data-title={product.title}
      data-url={productUrl}
      data-manager={manager}
      data-variants={JSON.stringify(variantData)}
      data-colour-choice={String(hasColourChoice)}
      data-size-choice={String(hasSizeChoice)}
    >
      <ProductGallery images={product.images} title={product.title} />

      {/* min-w-0 for the same reason as the gallery: a grid item's automatic
          minimum size is its content, so one unbreakable child would widen the
          whole column rather than being allowed to shrink or wrap. */}
      <div class="min-w-0">
        <h1 class="text-2xl sm:text-3xl lg:text-4xl">{product.title}</h1>
        {
          reviews.count > 0 && (
            <a href="#reviews" class="text-ink-muted mt-2 inline-flex items-center gap-2 text-sm underline-offset-2 hover:underline">
              <span class="text-brand" aria-hidden="true">{stars(Math.round(reviews.average))}</span>
              <span>
                {reviews.average.toFixed(1)} · {reviews.count}{' '}
                {pluralUk(reviews.count, { one: 'відгук', few: 'відгуки', many: 'відгуків' })}
              </span>
            </a>
          )
        }

        {/* The pill links to the category listing when one exists; the visual
            stays on the inner span so the phone-sized hit area (min-h-touch,
            compacting at md like the footer links) does not inflate the pill.
            -my-2 gives most of that height back to the layout. */}
        {
          product.categoryTitle &&
            (product.categorySlug ? (
              <p class="mt-3">
                <a
                  href={`/products/category/${product.categorySlug}`}
                  class="-my-2 inline-flex min-h-touch items-center md:my-0 md:min-h-0"
                >
                  <span class="bg-tag text-tag-ink hover:bg-tag/70 rounded-full px-3 py-1 text-xs transition-colors">
                    {product.categoryTitle}
                  </span>
                </a>
              </p>
            ) : (
              <p class="mt-3">
                <span class="bg-tag text-tag-ink rounded-full px-3 py-1 text-xs">
                  {product.categoryTitle}
                </span>
              </p>
            ))
        }

        <p class="mt-5">
          <span class="price text-2xl sm:text-3xl" data-price-display>
            {formatPrice(defaultVariant.price)}
          </span>
        </p>

        {/* The purchase block sits under the price, before the copy: on a phone
            the colour picker, the quantity and the buttons must be one screen
            with the price, not a scroll away below the details (owner,
            2026-09-20). Always rendered so the script has one place to read
            the current variant from; `hidden` when there is nothing to choose
            between. */}
        <div
          role="group"
          aria-label="Колір"
          class="border-line mt-6 border-t pt-5"
          hidden={!hasColourChoice}
        >
          <p class="text-sm">
            Колір: <span class="text-ink-muted" data-colour-label>{defaultVariant.colorName}</span>
          </p>
          <div class="mt-3 flex flex-wrap gap-2">
            {
              colours.map((colour) => (
                <button
                  type="button"
                  data-colour={colour.name}
                  aria-pressed={colour.name === defaultVariant.colorName ? 'true' : 'false'}
                  class="border-line-strong rounded-btn aria-pressed:border-brand aria-pressed:bg-tag/60 inline-flex min-h-touch items-center gap-2 border px-3 text-sm transition-colors md:min-h-10"
                >
                  <span
                    class="border-line-strong size-4 shrink-0 rounded-full border"
                    style={colour.hex ? `background-color:${colour.hex}` : undefined}
                    aria-hidden="true"
                  />
                  {colour.name}
                </button>
              ))
            }
          </div>
        </div>

        {/* Sizes of the chosen colour; a size that colour is not made in is
            disabled rather than hidden, so the row does not jump. */}
        <div
          role="group"
          aria-label="Розмір"
          class:list={['mt-5', !hasColourChoice && 'border-line mt-6 border-t pt-5']}
          hidden={!hasSizeChoice}
        >
          <p class="text-sm">
            Розмір: <span class="text-ink-muted" data-size-label>{defaultVariant.size}</span>
          </p>
          <div class="mt-3 flex flex-wrap gap-2">
            {
              sizes.map((size) => (
                <button
                  type="button"
                  data-size={size}
                  aria-pressed={size === defaultVariant.size ? 'true' : 'false'}
                  class="border-line-strong rounded-btn aria-pressed:border-brand aria-pressed:bg-tag/60 disabled:text-ink-muted inline-flex min-h-touch min-w-12 items-center justify-center border px-3 text-sm transition-colors disabled:cursor-not-allowed disabled:line-through md:min-h-10"
                >
                  {size}
                </button>
              ))
            }
          </div>
        </div>

        <p class="text-ink-muted mt-4 text-sm" data-stock-note hidden={inStock}>
          Немає в наявності.
        </p>

        <div class="border-line mt-6 flex items-center gap-4 border-t pt-6">
          <span class="text-sm">Кількість</span>
          {/* The cart's own per-line ceiling — availability is a yes/no on the
              variant, so there is no smaller number to clamp to. */}
          <QuantityStepper max={MAX_ITEM_QUANTITY} />
        </div>

        {/* Full-width stacked CTAs: on a phone these are the bottom of the page
            and the only thing that matters on it. */}
        <div class="mt-5 space-y-3">
          <Button variant="primary" size="lg" block data-add-to-cart disabled={!inStock}>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <g fill="none" stroke="currentColor" stroke-width="1.5">
                <path
                  d="M3.864 16.455c-.858-3.432-1.287-5.147-.386-6.301S6.148 9 9.685 9h4.63c3.538 0 5.306 0 6.207 1.154s.472 2.87-.386 6.301c-.546 2.183-.818 3.274-1.632 3.91c-.814.635-1.939.635-4.189.635h-4.63c-2.25 0-3.375 0-4.189-.635c-.814-.636-1.087-1.727-1.632-3.91Z"
                ></path>
                <path
                  d="m19.5 9.5l-.71-2.605c-.274-1.005-.411-1.507-.692-1.886A2.5 2.5 0 0 0 17 4.172C16.56 4 16.04 4 15 4M4.5 9.5l.71-2.605c.274-1.005.411-1.507.692-1.886A2.5 2.5 0 0 1 7 4.172C7.44 4 7.96 4 9 4"
                ></path>
                <path d="M9 4a1 1 0 0 1 1-1h4a1 1 0 1 1 0 2h-4a1 1 0 0 1-1-1Z"></path>
              </g>
            </svg>
            Додати до кошика
          </Button>

          {
            telegramHref && (
              <Button
                variant="telegram"
                size="lg"
                block
                href={telegramHref}
                target="_blank"
                rel="noopener"
                data-telegram
              >
                <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                  <path
                    d="M17.5 3 2.5 9l4.5 1.5L16 5l-7 6.5V16l2.5-3 3.5 2.5L17.5 3Z"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linejoin="round"
                  />
                </svg>
                Замовити через Телеграм
              </Button>
            )
          }
        </div>

        {/* «Покупка частинами» (`@balier/lib/monoparts`) — said where the price
            is read, only when it is configured and this price reaches it. */}
        {partsFrom !== null && (
          <div class="mt-3">
            <p class="text-ink-muted text-sm">
              {PARTS_NAME} — від {formatPrice(partsFrom)} на місяць.{' '}
              <a href="/chastynamy" class="underline underline-offset-2">Умови</a>
            </p>
            {/* monobank's two required legal texts, verbatim; 12px against the
                name's 14px — the rule is at least half its size. */}
            {PARTS_AD_LEGAL.map((text) => (
              <p class="text-ink-muted mt-1 text-xs">{text}</p>
            ))}
          </div>
        )}

        {/* The upsell: the companions the manager picked for this product, at
            their bundle price. The price is a promise the cart keeps — it is
            computed from the same rule by `/api/cart` and at checkout. */}
        {
          companions.length > 0 && (
            <div class="border-line mt-6 border-t pt-5">
              <h2 class="text-sm">
                До комплекту
                {companions.some((companion) => companion.bundleUnitPrice < companion.unitPrice) && (
                  <span class="text-ink-muted"> — разом дешевше</span>
                )}
              </h2>
              <ul class="mt-3 space-y-3">
                {companions.map((companion) => (
                  <li class="flex items-center gap-4">
                    {companion.imageUrl && (
                      <img
                        src={companion.imageUrl}
                        alt=""
                        width="64"
                        height="64"
                        loading="lazy"
                        class="rounded-btn bg-paper-raised h-16 w-16 shrink-0 object-cover"
                      />
                    )}
                    <div class="min-w-0 flex-1">
                      <a
                        href={`/products/${companion.productSlug}`}
                        class="text-ink block text-sm underline-offset-2 hover:underline"
                      >
                        {companion.productTitle}
                      </a>
                      <p class="mt-1 text-sm">
                        {companion.bundleUnitPrice < companion.unitPrice && (
                          <s class="text-ink-muted mr-2">{formatPrice(companion.unitPrice)}</s>
                        )}
                        <span class="price">{formatPrice(companion.bundleUnitPrice)}</span>
                      </p>
                    </div>
                    <Button variant="secondary" size="sm" data-add-companion={companion.variantId}>
                      + Додати
                    </Button>
                  </li>
                ))}
              </ul>
            </div>
          )
        }

        {product.description && (
          <p class="text-ink-muted border-line mt-8 border-t pt-6">{product.description}</p>
        )}

        {
          detailLines.length > 0 && (
            <ul class="text-ink-muted mt-4 space-y-1.5 text-sm">
              {detailLines.map((line) => (
                <li class="flex gap-2">
                  <span class="text-brand" aria-hidden="true">
                    •
                  </span>
                  <span>{line}</span>
                </li>
              ))}
            </ul>
          )
        }

        {/* Both are a conversation, not a checkout option (roadmap Phase 6):
            two lines pointing at the pages that explain them. */}
        <p class="text-ink-muted mt-4 text-sm">
          Інші кольори — під замовлення, дивіться{' '}
          <a href="/palette" class="text-brand hover:text-brand-hover underline-offset-2 transition-colors hover:underline">
            палітру шкіри
          </a>
          . Тиснення або гравірування ініціалів, дати чи зображення —{' '}
          <a href="/personalization" class="text-brand hover:text-brand-hover underline-offset-2 transition-colors hover:underline">
            персоналізація
          </a>
          .
        </p>

        {/* The chosen size's own measurements when it has them. */}
        <div class="border-line mt-6 border-t pt-5" data-dimensions-block hidden={!defaultDimensions}>
          <h2 class="text-sm">Розміри</h2>
          <p class="text-ink-muted mt-1 text-sm" data-dimensions>{defaultDimensions}</p>
        </div>

      </div>
    </div>

    {
      reviews.count > 0 && (
        <section id="reviews" class="border-line mt-12 max-w-3xl border-t pt-8">
          <h2 class="text-2xl">Відгуки</h2>
          <ul class="mt-6 space-y-6">
            {reviews.reviews.map((review) => (
              <li class="border-line border-b pb-6 last:border-b-0">
                <p class="text-brand" aria-label={`Оцінка ${review.rating} з 5`}>
                  {stars(review.rating)}
                </p>
                {review.body && <p class="text-ink mt-2 whitespace-pre-line">{review.body}</p>}
                <p class="text-ink-muted mt-2 text-sm">
                  {review.authorName} · {reviewDate.format(review.publishedAt)} · Перевірена покупка
                </p>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </Container>
</BaseLayout>

<script>
  import { formatPrice } from '@balier/lib/money';
  import { orderDeepLink } from '@balier/lib/telegram';
  import { openCartPopup } from '@balier/lib/cartPopup';
  import { addToCart } from '@balier/lib/cart/store';
  import { track } from '~/lib/analytics';
  import { variantLabel } from '@balier/lib/products/variant';

  const root = document.querySelector<HTMLElement>('[data-product]');

  if (root) {
    interface VariantData {
      id: string;
      sku: string;
      price: number;
      inStock: boolean;
      colour: string | null;
      size: string | null;
      dimensions: string | null;
    }
    const variants = JSON.parse(root.dataset.variants ?? '[]') as VariantData[];
    const colourButtons = [...root.querySelectorAll<HTMLButtonElement>('button[data-colour]')];
    const sizeButtons = [...root.querySelectorAll<HTMLButtonElement>('button[data-size]')];
    const priceDisplay = root.querySelector<HTMLElement>('[data-price-display]');
    const colourLabel = root.querySelector<HTMLElement>('[data-colour-label]');
    const sizeLabel = root.querySelector<HTMLElement>('[data-size-label]');
    const dimensionsBlock = root.querySelector<HTMLElement>('[data-dimensions-block]');
    const dimensionsText = root.querySelector<HTMLElement>('[data-dimensions]');
    const quantity = root.querySelector<HTMLInputElement>('input[data-quantity]');
    const addButton = root.querySelector<HTMLButtonElement>('[data-add-to-cart]');
    const telegram = root.querySelector<HTMLAnchorElement>('a[data-telegram]');
    const stockNote = root.querySelector<HTMLElement>('[data-stock-note]');

    const title = root.dataset.title ?? '';
    const url = root.dataset.url ?? '';
    const manager = root.dataset.manager ?? '';
    const showsColour = root.dataset.colourChoice === 'true';
    const showsSize = root.dataset.sizeChoice === 'true';

    /** The pressed colour and size — the variant every action on the page applies to. */
    let current: VariantData | undefined = variants[0];

    /**
     * A colour and a size back to a variant. The exact pair when it exists;
     * otherwise the other axis gives way — picking a colour that has no «L»
     * lands on that colour's first size, preferring one in stock.
     */
    const resolve = (colour: string | null, size: string | null): VariantData | undefined => {
      const exact = variants.find((v) => v.colour === colour && v.size === size);
      if (exact) return exact;
      const sameColour = variants.filter((v) => v.colour === colour);
      return sameColour.find((v) => v.inStock) ?? sameColour[0] ?? variants[0];
    };

    /** Re-derives everything that depends on the chosen variant and quantity. */
    const render = () => {
      const variant = current;
      if (!variant) return;

      for (const button of colourButtons) {
        button.setAttribute('aria-pressed', String(button.dataset.colour === variant.colour));
      }
      for (const button of sizeButtons) {
        button.setAttribute('aria-pressed', String(button.dataset.size === variant.size));
        button.disabled = !variants.some((v) => v.colour === variant.colour && v.size === button.dataset.size);
      }
      if (colourLabel) colourLabel.textContent = variant.colour ?? '';
      if (sizeLabel) sizeLabel.textContent = variant.size ?? '';
      if (dimensionsText) dimensionsText.textContent = variant.dimensions ?? '';
      if (dimensionsBlock) dimensionsBlock.hidden = !variant.dimensions;

      if (priceDisplay) priceDisplay.textContent = formatPrice(variant.price);
      if (addButton) addButton.disabled = !variant.inStock;
      if (stockNote) stockNote.hidden = variant.inStock;

      if (telegram) {
        const href = orderDeepLink(manager, {
          title,
          sku: variant.sku,
          price: variant.price,
          quantity: Number(quantity?.value) || 1,
          url,
          variantName: variantLabel(showsColour ? variant.colour : null, showsSize ? variant.size : null),
        });
        if (href) telegram.href = href;
      }
    };

    const choose = (next: VariantData | undefined) => {
      const colourChanged = next?.colour !== current?.colour;
      current = next;
      // The gallery shows the chosen colour's photos — every size of that
      // colour shares them, whichever variant row they were uploaded to.
      if (colourChanged && next) {
        document.dispatchEvent(
          new CustomEvent('product:variant', {
            detail: {
              variantIds: variants.filter((v) => v.colour === next.colour).map((v) => v.id),
            },
          }),
        );
      }
      render();
    };

    for (const button of colourButtons) {
      button.addEventListener('click', () => choose(resolve(button.dataset.colour ?? null, current?.size ?? null)));
    }
    for (const button of sizeButtons) {
      button.addEventListener('click', () => choose(resolve(current?.colour ?? null, button.dataset.size ?? null)));
    }

    document.addEventListener('quantity:change', render);

    /**
     * Adding keeps the customer on the page — the popup that follows is the
     * confirmation, with the full cart and a straight line to checkout, so
     * browsing is never interrupted by a redirect to a cart they did not ask
     * to see.
     *
     * Only the variant id and the quantity are stored. What that costs is
     * resolved from the database by `/api/cart` when the popup opens, so
     * nothing priced here can be carried forward as truth.
     */
    if (addButton) {
      addButton.addEventListener('click', () => {
        const variantId = current?.id;
        if (!variantId) return;

        addToCart(variantId, Number(quantity?.value) || 1);
        track('Add to cart', { source: 'product', product: location.pathname.split('/').pop() ?? '' });
        openCartPopup();
      });
    }

    for (const button of root.querySelectorAll<HTMLButtonElement>('[data-add-companion]')) {
      button.addEventListener('click', () => {
        const variantId = button.dataset.addCompanion;
        if (!variantId) return;
        addToCart(variantId, 1);
        track('Add to cart', { source: 'companion', product: location.pathname.split('/').pop() ?? '' });
        openCartPopup();
      });
    }
  }
</script>
