---
// TURNSTILE DISABLED (2026-08-05, on request) — commented out, not deleted.
// To restore, uncomment every block marked `Turnstile:` in this file, plus
// `turnstileToken` in `src/lib/validation/checkout.ts` and the captcha check
// in `src/pages/api/checkout.ts`. `src/lib/turnstile/` is untouched.
// Turnstile: import { env } from 'cloudflare:workers';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Container from '~/components/Container.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import Button from '~/components/Button.astro';
import {
  MAX_ADDRESS_LENGTH,
  MAX_COMMENT_LENGTH,
  MAX_CUSTOMER_NAME,
  MIN_ADDRESS_LENGTH,
} from '@balier/lib/validation/checkout';

export const prerender = false;

// Turnstile: const turnstileSiteKey = env.PUBLIC_TURNSTILE_SITE_KEY;

const inputClass =
  'border-line-strong bg-paper-raised text-ink placeholder:text-ink-muted rounded-btn h-touch w-full min-w-0 appearance-none border px-4 text-base sm:h-11 sm:text-sm';
const phoneInputClass = inputClass.replace('px-4', 'pl-16 pr-4');
---

{/* Same reasoning as /cart: per-visitor, worth nothing to a crawler. */}
<BaseLayout title="Оформлення замовлення" noindex>
  <Container class="py-8 sm:py-12">
    <Breadcrumbs
      items={[{ label: 'Головна', href: '/' }, { label: 'Кошик', href: '/cart' }, { label: 'Оформлення' }]}
    />

    <h1 class="mt-5 text-3xl sm:mt-6 sm:text-4xl lg:text-5xl">Оформлення замовлення</h1>

    <div data-checkout>
      <div data-state="loading" class="mt-8">
        <p class="text-ink-muted">Завантажуємо кошик…</p>
      </div>

      <div data-state="error" class="mt-8" hidden>
        <p class="text-ink">Не вдалося завантажити кошик.</p>
        <p class="text-ink-muted mt-2 text-sm">
          Перевірте зʼєднання та спробуйте ще раз — товари з кошика нікуди не зникли.
        </p>
        <Button type="button" variant="secondary" class="mt-6 w-full sm:w-auto" data-retry>
          Спробувати ще раз
        </Button>
      </div>

      <div data-state="empty" class="mt-8" hidden>
        <p class="text-ink">У кошику порожньо — нема чого оформлювати.</p>
        <Button href="/products" class="mt-6 w-full sm:w-auto">Перейти до каталогу</Button>
      </div>

      <div data-state="form" hidden>
        <div class="mt-6 grid gap-8 sm:mt-8 lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-10">
          <form data-checkout-form class="min-w-0 space-y-8" novalidate>
            <fieldset class="space-y-4">
              <legend class="text-lg sm:text-xl">Контактні дані</legend>

              <div>
                <label for="customerName" class="text-ink-soft mb-1.5 block text-sm">Ім’я та прізвище</label>
                <input
                  id="customerName"
                  name="customerName"
                  type="text"
                  autocomplete="name"
                  required
                  minlength="2"
                  maxlength={MAX_CUSTOMER_NAME}
                  class={inputClass}
                />
              </div>

              <div>
                <label for="customerPhone" class="text-ink-soft mb-1.5 block text-sm">Телефон</label>
                <div class="relative">
                  <span
                    class="text-ink pointer-events-none absolute inset-y-0 left-4 flex items-center text-base sm:text-sm"
                    aria-hidden="true"
                  >
                    +380
                  </span>
                  <input
                    id="customerPhone"
                    name="customerPhone"
                    type="tel"
                    inputmode="numeric"
                    autocomplete="tel"
                    placeholder="XX XXX XX XX"
                    required
                    class={phoneInputClass}
                    data-phone-input
                  />
                </div>
              </div>

              <div>
                <label for="customerEmail" class="text-ink-soft mb-1.5 block text-sm">
                  Email <span class="text-ink-muted">(необов’язково)</span>
                </label>
                <input
                  id="customerEmail"
                  name="customerEmail"
                  type="email"
                  autocomplete="email"
                  class={inputClass}
                />
              </div>
            </fieldset>

            <fieldset class="space-y-4">
              <legend class="text-lg sm:text-xl">Доставка</legend>

              {/* Nova Poshta only — the delivery mockup/decision never quotes a
                  price, so this step is only about where, not how much. */}
              <div class="flex flex-col gap-2 sm:flex-row sm:flex-wrap" role="radiogroup" aria-label="Спосіб доставки">
                <label class="border-line-strong has-checked:border-brand has-checked:bg-brand/5 rounded-btn flex min-h-touch flex-1 cursor-pointer items-center gap-2 border px-4 text-sm">
                  <input type="radio" name="deliveryMethod" value="np_warehouse" checked data-delivery-method />
                  Відділення Нової Пошти
                </label>
                <label class="border-line-strong has-checked:border-brand has-checked:bg-brand/5 rounded-btn flex min-h-touch flex-1 cursor-pointer items-center gap-2 border px-4 text-sm">
                  <input type="radio" name="deliveryMethod" value="np_postomat" data-delivery-method />
                  Поштомат
                </label>
                <label class="border-line-strong has-checked:border-brand has-checked:bg-brand/5 rounded-btn flex min-h-touch flex-1 cursor-pointer items-center gap-2 border px-4 text-sm">
                  <input type="radio" name="deliveryMethod" value="np_courier" data-delivery-method />
                  Курʼєром
                </label>
              </div>

              <div class="relative">
                <label for="settlementQuery" class="text-ink-soft mb-1.5 block text-sm">Населений пункт</label>
                <input
                  id="settlementQuery"
                  type="text"
                  autocomplete="off"
                  placeholder="Почніть вводити назву міста…"
                  required
                  class={inputClass}
                  data-settlement-query
                />
                <ul
                  data-settlement-results
                  role="listbox"
                  aria-label="Знайдені населені пункти"
                  class="border-line bg-paper-raised rounded-card absolute inset-x-0 top-full z-10 mt-1 max-h-64 overflow-y-auto border shadow-lg"
                  hidden
                ></ul>
              </div>

              <div data-warehouse-field hidden class="relative">
                <label for="warehouseQuery" class="text-ink-soft mb-1.5 block text-sm">Відділення / поштомат</label>
                <input
                  id="warehouseQuery"
                  type="text"
                  autocomplete="off"
                  placeholder="Спочатку оберіть населений пункт"
                  required
                  disabled
                  class={inputClass}
                  data-warehouse-query
                />
                <ul
                  data-warehouse-results
                  role="listbox"
                  aria-label="Знайдені відділення"
                  class="border-line bg-paper-raised rounded-card absolute inset-x-0 top-full z-10 mt-1 max-h-64 overflow-y-auto border shadow-lg"
                  hidden
                ></ul>
              </div>

              <div data-address-field hidden>
                <label for="npAddress" class="text-ink-soft mb-1.5 block text-sm">Вулиця, будинок, квартира</label>
                <input
                  id="npAddress"
                  name="npAddress"
                  type="text"
                  minlength={MIN_ADDRESS_LENGTH}
                  maxlength={MAX_ADDRESS_LENGTH}
                  class={inputClass}
                  data-np-address
                />
              </div>

              <p class="text-ink-muted text-xs">Вартість доставки оплачує отримувач за тарифами Нової Пошти.</p>
            </fieldset>

            <fieldset class="space-y-3">
              <legend class="text-lg sm:text-xl">Оплата</legend>

              <label class="border-line-strong has-checked:border-brand has-checked:bg-brand/5 rounded-btn flex min-h-touch cursor-pointer items-center gap-2 border px-4 text-sm">
                <input type="radio" name="paymentMethod" value="card" checked data-payment-method />
                Карткою онлайн
              </label>
              <label
                class="border-line-strong has-checked:border-brand has-checked:bg-brand/5 rounded-btn flex min-h-touch cursor-pointer items-center gap-2 border px-4 text-sm has-disabled:cursor-not-allowed has-disabled:opacity-50"
                data-cod-label
              >
                <input type="radio" name="paymentMethod" value="cod" data-payment-method />
                Готівкою при отриманні
              </label>
              <p class="text-ink-muted text-xs" data-cod-over-limit hidden></p>
            </fieldset>

            <fieldset>
              <label for="comment" class="text-ink-soft mb-1.5 block text-sm">
                Коментар до замовлення <span class="text-ink-muted">(необов’язково)</span>
              </label>
              <textarea
                id="comment"
                name="comment"
                rows="3"
                maxlength={MAX_COMMENT_LENGTH}
                class={`${inputClass} min-h-[64px] py-3`}
              ></textarea>
            </fieldset>

            {/* Turnstile: the widget itself.
            <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-action="checkout" data-turnstile-widget></div>
            */}

            <p class="text-ink hidden text-sm" data-submit-error role="alert"></p>

            <Button type="submit" size="lg" block data-submit>Підтвердити замовлення</Button>
          </form>

          <aside
            class="border-line bg-paper-raised rounded-card border p-5 sm:p-6 lg:sticky lg:top-[calc(var(--spacing-header)+1.5rem)] lg:self-start"
            aria-labelledby="summary-heading"
          >
            <h2 id="summary-heading" class="text-lg sm:text-xl">Ваше замовлення</h2>

            <ul data-summary-lines class="border-line mt-4 divide-y divide-(--color-line) border-t text-sm"></ul>

            <div class="border-line mt-4 flex items-baseline justify-between gap-4 border-t pt-4">
              <span class="text-ink font-medium">Разом</span>
              <span class="price text-xl sm:text-2xl" data-total></span>
            </div>
          </aside>
        </div>
      </div>
    </div>
  </Container>
</BaseLayout>

{/* Turnstile: renders the widget declared above (`.cf-turnstile[data-sitekey]`)
    and populates its hidden `cf-turnstile-response` input — read directly off
    the form's `FormData` in the submit handler below, no separate global.
<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
*/}

<script>
  import type { CartLine, CartSummary } from '@balier/lib/cart';
  import { fetchCartSummary } from '@balier/lib/cart/client';
  import { checkoutNoticeText, codOverLimitText, settlementLabel } from '@balier/lib/i18n/checkout';
  import { formatPrice } from '@balier/lib/money';
  import { applyPhoneMask, isCompletePhoneDigits, phoneDigitsFromInput } from '@balier/lib/phone';
  import { cartItems, clearCart } from '@balier/lib/cart/store';

  interface SettlementResult {
    ref: string;
    name: string;
    area: string | null;
    region: string | null;
    type: string | null;
  }

  interface WarehouseResult {
    ref: string;
    number: string | null;
    description: string;
  }

  // Turnstile:
  // declare global {
  //   interface Window {
  //     // Loaded by the external `api.js` script above.
  //     turnstile?: { reset(widgetId?: string): void };
  //   }
  // }
  //
  // const resetTurnstile = () => window.turnstile?.reset();

  const root = document.querySelector<HTMLElement>('[data-checkout]');
  const form = root?.querySelector<HTMLFormElement>('[data-checkout-form]');

  if (root && form) {
    const panels = new Map<string, HTMLElement>();
    for (const panel of root.querySelectorAll<HTMLElement>('[data-state]')) {
      if (panel.dataset.state) panels.set(panel.dataset.state, panel);
    }
    const showState = (name: string) => {
      for (const [key, panel] of panels) panel.hidden = key !== name;
    };

    const retry = root.querySelector<HTMLButtonElement>('[data-retry]');
    const summaryLines = root.querySelector<HTMLUListElement>('[data-summary-lines]');
    const totalOutput = root.querySelector<HTMLElement>('[data-total]');
    const submitButton = form.querySelector<HTMLButtonElement>('[data-submit]');
    const submitError = form.querySelector<HTMLElement>('[data-submit-error]');

    const phoneInput = form.querySelector<HTMLInputElement>('[data-phone-input]');

    const settlementQuery = form.querySelector<HTMLInputElement>('[data-settlement-query]');
    const settlementResults = form.querySelector<HTMLUListElement>('[data-settlement-results]');
    const warehouseField = form.querySelector<HTMLElement>('[data-warehouse-field]');
    const warehouseQuery = form.querySelector<HTMLInputElement>('[data-warehouse-query]');
    const warehouseResultsList = form.querySelector<HTMLUListElement>('[data-warehouse-results]');
    const addressField = form.querySelector<HTMLElement>('[data-address-field]');
    const npAddress = form.querySelector<HTMLInputElement>('[data-np-address]');
    const codLabel = form.querySelector<HTMLElement>('[data-cod-label]');
    const codOverLimitNote = form.querySelector<HTMLElement>('[data-cod-over-limit]');

    let cart: CartSummary | null = null;
    let codLimitKopiykas = 0;
    let selectedSettlement: SettlementResult | null = null;
    let selectedWarehouse: WarehouseResult | null = null;
    let settlementSearchDebounce: number | undefined;
    let warehouseSearchDebounce: number | undefined;

    const currentDeliveryMethod = () =>
      form.querySelector<HTMLInputElement>('[data-delivery-method]:checked')?.value ?? 'np_warehouse';

    phoneInput?.addEventListener('input', () => applyPhoneMask(phoneInput));

    const paintSummary = (summary: CartSummary) => {
      if (!summaryLines || !totalOutput) return;

      summaryLines.replaceChildren(
        ...summary.lines.map((line: CartLine) => {
          const item = document.createElement('li');
          item.className = 'flex items-start justify-between gap-3 py-2.5';

          const label = document.createElement('div');
          label.className = 'min-w-0';
          const title = document.createElement('p');
          title.className = 'text-ink truncate';
          title.textContent = line.productTitle;
          label.appendChild(title);

          if (line.variantName) {
            const variant = document.createElement('p');
            variant.className = 'text-ink-muted text-xs';
            variant.textContent = `${line.variantName} · ${line.quantity} шт.`;
            label.appendChild(variant);
          } else {
            const qty = document.createElement('p');
            qty.className = 'text-ink-muted text-xs';
            qty.textContent = `${line.quantity} шт.`;
            label.appendChild(qty);
          }

          const price = document.createElement('span');
          price.className = 'price shrink-0';
          price.textContent = formatPrice(line.lineTotal);

          // `.append()` on `Element` is shadowed by the same HTMLRewriter
          // global-type merge noted above — `appendChild` isn't, so it stays
          // the DOM one.
          item.appendChild(label);
          item.appendChild(price);
          return item;
        }),
      );

      totalOutput.textContent = formatPrice(summary.total);
    };

    const paintCodAvailability = () => {
      if (!cart || !codLabel || !codOverLimitNote) return;
      const codRadio = codLabel.querySelector<HTMLInputElement>('input[value="cod"]');
      const overLimit = cart.total > codLimitKopiykas;

      if (codRadio) codRadio.disabled = overLimit;
      codOverLimitNote.hidden = !overLimit;
      if (overLimit) codOverLimitNote.textContent = codOverLimitText(codLimitKopiykas);
      if (overLimit && codRadio?.checked) {
        const cardRadio = form.querySelector<HTMLInputElement>('input[name="paymentMethod"][value="card"]');
        if (cardRadio) cardRadio.checked = true;
      }
    };

    const updateDeliveryFieldVisibility = () => {
      const method = currentDeliveryMethod();
      const isCourier = method === 'np_courier';
      if (warehouseField) warehouseField.hidden = isCourier;
      if (warehouseQuery) warehouseQuery.required = !isCourier;
      if (addressField) addressField.hidden = !isCourier;
      if (npAddress) npAddress.required = isCourier;
    };

    const clearWarehouses = () => {
      selectedWarehouse = null;
      if (warehouseQuery) {
        warehouseQuery.value = '';
        warehouseQuery.disabled = !selectedSettlement;
        warehouseQuery.placeholder = selectedSettlement
          ? 'Почніть вводити номер або адресу…'
          : 'Спочатку оберіть населений пункт';
      }
      if (warehouseResultsList) {
        warehouseResultsList.hidden = true;
        warehouseResultsList.replaceChildren();
      }
    };

    const paintWarehouseResults = (results: WarehouseResult[]) => {
      if (!warehouseResultsList) return;
      warehouseResultsList.replaceChildren(
        ...results.map((warehouse) => {
          const item = document.createElement('li');
          item.setAttribute('role', 'option');
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'hover:bg-tag w-full px-4 py-2.5 text-left text-sm';
          button.textContent = warehouse.description;
          button.addEventListener('click', () => {
            selectedWarehouse = warehouse;
            if (warehouseQuery) warehouseQuery.value = warehouse.description;
            warehouseResultsList.hidden = true;
          });
          item.appendChild(button);
          return item;
        }),
      );
      warehouseResultsList.hidden = results.length === 0;
    };

    // Unlike the settlement search (26 791 rows nationwide, needs 2+ typed
    // characters to be worth a query), a warehouse search is already scoped
    // to one settlement — even an empty query is a cheap, useful "browse the
    // first N" default, so this fires on focus too, not just on input.
    const loadWarehouses = (query: string) => {
      if (!selectedSettlement || !warehouseQuery) return;
      const method = currentDeliveryMethod();
      if (method === 'np_courier') return;

      window.clearTimeout(warehouseSearchDebounce);
      warehouseSearchDebounce = window.setTimeout(async () => {
        try {
          const response = await fetch(
            `/api/checkout/np-warehouses?settlementRef=${encodeURIComponent(selectedSettlement!.ref)}&kind=${method}&q=${encodeURIComponent(query)}`,
          );
          paintWarehouseResults((await response.json()) as WarehouseResult[]);
        } catch {
          // A failed lookup just leaves the list empty — the customer can retype.
        }
      }, 300);
    };

    warehouseQuery?.addEventListener('focus', () => {
      if (!selectedSettlement) return;
      loadWarehouses(warehouseQuery.value.trim());
    });

    warehouseQuery?.addEventListener('input', () => {
      selectedWarehouse = null;
      loadWarehouses(warehouseQuery.value.trim());
    });

    const paintSettlementResults = (results: SettlementResult[]) => {
      if (!settlementResults) return;
      settlementResults.replaceChildren(
        ...results.map((settlement) => {
          const item = document.createElement('li');
          item.setAttribute('role', 'option');
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'hover:bg-tag w-full px-4 py-2.5 text-left text-sm';
          button.textContent = settlementLabel(settlement);
          button.addEventListener('click', () => {
            selectedSettlement = settlement;
            if (settlementQuery) settlementQuery.value = settlementLabel(settlement);
            settlementResults.hidden = true;
            clearWarehouses();
          });
          item.appendChild(button);
          return item;
        }),
      );
      settlementResults.hidden = results.length === 0;
    };

    settlementQuery?.addEventListener('input', () => {
      selectedSettlement = null;
      clearWarehouses();
      window.clearTimeout(settlementSearchDebounce);
      const value = settlementQuery.value.trim();
      if (value.length < 2) {
        if (settlementResults) settlementResults.hidden = true;
        return;
      }
      settlementSearchDebounce = window.setTimeout(async () => {
        try {
          const response = await fetch(`/api/checkout/np-settlements?q=${encodeURIComponent(value)}`);
          paintSettlementResults((await response.json()) as SettlementResult[]);
        } catch {
          // A failed lookup just leaves the list empty — the customer can retype.
        }
      }, 300);
    });

    for (const radio of form.querySelectorAll<HTMLInputElement>('[data-delivery-method]')) {
      radio.addEventListener('change', () => {
        updateDeliveryFieldVisibility();
        clearWarehouses();
      });
    }

    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Node)) return;
      if (settlementResults && !settlementResults.hidden && !form.contains(event.target)) {
        settlementResults.hidden = true;
      }
      if (warehouseResultsList && !warehouseResultsList.hidden && !form.contains(event.target)) {
        warehouseResultsList.hidden = true;
      }
    });

    const load = async () => {
      if (cartItems.get().length === 0) {
        showState('empty');
        return;
      }

      showState('loading');
      try {
        const [summary, limitsResponse] = await Promise.all([
          fetchCartSummary(),
          fetch('/api/checkout/limits'),
        ]);
        const { codLimitKopiykas: limit } = (await limitsResponse.json()) as {
          codLimitKopiykas: number;
        };

        if (summary.lines.length === 0) {
          showState('empty');
          return;
        }

        cart = summary;
        codLimitKopiykas = limit;
        paintSummary(summary);
        paintCodAvailability();
        updateDeliveryFieldVisibility();
        showState('form');
      } catch (error) {
        console.error(error);
        showState('error');
      }
    };

    retry?.addEventListener('click', () => void load());

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!cart || !form.reportValidity()) return;

      const phoneDigits = phoneDigitsFromInput(phoneInput?.value ?? '');
      if (!isCompletePhoneDigits(phoneDigits)) {
        if (submitError) {
          submitError.textContent = 'Введіть повний номер телефону.';
          submitError.hidden = false;
        }
        return;
      }

      const deliveryMethod = currentDeliveryMethod();
      if (deliveryMethod === 'np_courier' && !selectedSettlement) {
        if (submitError) {
          submitError.textContent = 'Оберіть населений пункт.';
          submitError.hidden = false;
        }
        return;
      }
      if (deliveryMethod !== 'np_courier' && (!selectedSettlement || !selectedWarehouse)) {
        if (submitError) {
          submitError.textContent = 'Оберіть населений пункт і відділення.';
          submitError.hidden = false;
        }
        return;
      }

      const data = new FormData(form);

      // Turnstile:
      // const turnstileToken = String(data.get('cf-turnstile-response') ?? '');
      // if (!turnstileToken) {
      //   if (submitError) {
      //     submitError.textContent = 'Пройдіть перевірку безпеки нижче.';
      //     submitError.hidden = false;
      //   }
      //   return;
      // }

      const delivery =
        deliveryMethod === 'np_courier'
          ? {
              deliveryMethod,
              npSettlementRef: selectedSettlement!.ref,
              npSettlementName: selectedSettlement!.name,
              npAddress: String(data.get('npAddress') ?? ''),
            }
          : {
              deliveryMethod,
              npSettlementRef: selectedSettlement!.ref,
              npSettlementName: selectedSettlement!.name,
              npWarehouseRef: selectedWarehouse!.ref,
              npWarehouseName: selectedWarehouse!.description,
            };

      const payload = {
        customerName: String(data.get('customerName') ?? ''),
        customerPhone: `+380${phoneDigits}`,
        customerEmail: String(data.get('customerEmail') ?? ''),
        delivery,
        paymentMethod: String(data.get('paymentMethod') ?? 'card'),
        comment: String(data.get('comment') ?? ''),
        items: cartItems.get(),
        // Turnstile: turnstileToken,
      };

      if (submitButton) submitButton.disabled = true;
      if (submitError) submitError.hidden = true;

      try {
        const response = await fetch('/api/checkout', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(payload),
        });

        const body = (await response.json()) as {
          orderNumber?: string;
          redirectUrl?: string;
          error?: string;
          notices?: { variantId: string; reason: 'unavailable' | 'out_of_stock' | 'reduced'; title: string | null }[];
        };

        if (response.ok && body.redirectUrl) {
          clearCart();
          window.location.href = body.redirectUrl;
          return;
        }

        if (body.error === 'cart_changed' && body.notices) {
          if (submitError) {
            submitError.textContent = body.notices.map(checkoutNoticeText).join(' ');
            submitError.hidden = false;
          }
          await load();
          return;
        }

        if (body.error === 'cod_over_limit') {
          if (submitError) {
            submitError.textContent = codOverLimitText(codLimitKopiykas);
            submitError.hidden = false;
          }
          return;
        }

        // Turnstile:
        // if (body.error === 'captcha_failed') {
        //   if (submitError) {
        //     submitError.textContent = 'Перевірка безпеки не пройдена. Спробуйте ще раз.';
        //     submitError.hidden = false;
        //   }
        //   return;
        // }

        window.location.href = '/checkout/failure';
      } catch (error) {
        console.error(error);
        if (submitError) {
          submitError.textContent = 'Не вдалося оформити замовлення. Спробуйте ще раз.';
          submitError.hidden = false;
        }
      } finally {
        if (submitButton) submitButton.disabled = false;
        // Turnstile: resetTurnstile();
      }
    });

    void load();
  }
</script>
