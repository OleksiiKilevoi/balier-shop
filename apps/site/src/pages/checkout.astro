---
import { env } from 'cloudflare:workers';
import * as Sentry from '@sentry/cloudflare';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Container from '~/components/Container.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import Button from '~/components/Button.astro';
import { visitorCity } from '~/lib/geo';
import { createDb } from '@balier/lib/db';
import { settlementSuggestions } from '@balier/lib/db/queries/novaposhta';
import { settlementLabel } from '@balier/lib/i18n/checkout';
import { MAX_COMMENT_LENGTH, MAX_CUSTOMER_NAME } from '@balier/lib/validation/checkout';

export const prerender = false;

/**
 * The one-tap chips under the settlement input. Rendered server-side rather
 * than fetched: they are the same for nearly everyone, they must be on screen
 * before the customer touches the field to be worth anything, and the geo one
 * needs the request that only exists here.
 *
 * A failure here must not take the checkout page down — an empty chip row is a
 * missing convenience, while an unreachable database on this page is a lost
 * order. Everything the form actually needs is loaded client-side.
 */
let suggestions: Awaited<ReturnType<typeof settlementSuggestions>> = [];
try {
  suggestions = await settlementSuggestions(
    createDb(env.DATABASE_URL),
    visitorCity(Astro.request),
  );
} catch (error) {
  console.error('Settlement suggestions unavailable:', error);
  Sentry.captureException(error);
}

const inputClass =
  'border-line-strong bg-paper-raised text-ink placeholder:text-ink-muted rounded-btn h-touch w-full min-w-0 appearance-none border px-4 text-base sm:h-11 sm:text-sm';
const phoneInputClass = inputClass.replace('px-4', 'pl-16 pr-4');
import { PARTS_AD_LEGAL, PARTS_NAME } from '@balier/lib/monoparts';
---

{/* Same reasoning as /cart: per-visitor, worth nothing to a crawler. */}
<BaseLayout title="Оформлення замовлення" noindex>
  <Container class="py-8 sm:py-12">
    <Breadcrumbs
      items={[{ label: 'Головна', href: '/' }, { label: 'Кошик', href: '/cart' }, { label: 'Оформлення' }]}
    />

    <h1 class="mt-5 text-3xl sm:mt-6 sm:text-4xl lg:text-5xl">Оформлення замовлення</h1>

    <div data-checkout>
      <div data-state="loading" class="mt-8">
        <p class="text-ink-muted">Завантажуємо кошик…</p>
      </div>

      <div data-state="error" class="mt-8" hidden>
        <p class="text-ink">Не вдалося завантажити кошик.</p>
        <p class="text-ink-muted mt-2 text-sm">
          Перевірте зʼєднання та спробуйте ще раз — товари з кошика нікуди не зникли.
        </p>
        <Button type="button" variant="secondary" class="mt-6 w-full sm:w-auto" data-retry>
          Спробувати ще раз
        </Button>
      </div>

      <div data-state="empty" class="mt-8" hidden>
        <p class="text-ink">У кошику порожньо — нема чого оформлювати.</p>
        <Button href="/products" class="mt-6 w-full sm:w-auto">Перейти до каталогу</Button>
      </div>

      <div data-state="form" hidden>
        <div class="mt-6 grid gap-8 sm:mt-8 lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-10">
          <form data-checkout-form class="min-w-0 space-y-8" novalidate>
            <fieldset class="space-y-4">
              <legend class="text-lg sm:text-xl">Контактні дані</legend>

              <div>
                <label for="customerName" class="text-ink-soft mb-1.5 block text-sm">Ім’я та прізвище</label>
                <input
                  id="customerName"
                  name="customerName"
                  type="text"
                  autocomplete="name"
                  required
                  minlength="2"
                  maxlength={MAX_CUSTOMER_NAME}
                  class={inputClass}
                />
              </div>

              <div>
                <label for="customerPhone" class="text-ink-soft mb-1.5 block text-sm">Телефон</label>
                <div class="relative">
                  <span
                    class="text-ink pointer-events-none absolute inset-y-0 left-4 flex items-center text-base sm:text-sm"
                    aria-hidden="true"
                  >
                    +380
                  </span>
                  <input
                    id="customerPhone"
                    name="customerPhone"
                    type="tel"
                    inputmode="numeric"
                    autocomplete="tel"
                    placeholder="XX XXX XX XX"
                    required
                    class={phoneInputClass}
                    data-phone-input
                  />
                </div>
              </div>

              <div>
                <label for="customerEmail" class="text-ink-soft mb-1.5 block text-sm">
                  Email <span class="text-ink-muted">(необов’язково)</span>
                </label>
                <input
                  id="customerEmail"
                  name="customerEmail"
                  type="email"
                  autocomplete="email"
                  class={inputClass}
                />
              </div>

              {/* Typed from the letter the popup sent. The summary previews the
                  percentage, the server is the judge at submit. */}
              <div>
                <label for="promoCode" class="text-ink-soft mb-1.5 block text-sm">
                  Промокод <span class="text-ink-muted">(необов’язково)</span>
                </label>
                <input
                  id="promoCode"
                  name="promoCode"
                  type="text"
                  autocomplete="off"
                  autocapitalize="characters"
                  spellcheck="false"
                  placeholder="BALIER-XXXXX"
                  class={`${inputClass} uppercase tracking-[0.08em]`}
                  data-promo-input
                />
                <p class="text-ink mt-1.5 hidden text-xs" data-promo-error role="alert"></p>
              </div>
            </fieldset>

            <fieldset class="space-y-4">
              <legend class="text-lg sm:text-xl">Доставка</legend>

              {/* Nova Poshta only — the delivery mockup/decision never quotes a
                  price, so this step is only about where, not how much. */}
              <div class="flex flex-col gap-2 sm:flex-row sm:flex-wrap" role="radiogroup" aria-label="Спосіб доставки">
                <label class="border-line-strong has-checked:border-brand has-checked:bg-brand/5 rounded-btn flex min-h-touch flex-1 cursor-pointer items-center gap-2 border px-4 text-sm">
                  <input type="radio" name="deliveryMethod" value="np_warehouse" checked data-delivery-method />
                  Відділення Нової Пошти
                </label>
                <label class="border-line-strong has-checked:border-brand has-checked:bg-brand/5 rounded-btn flex min-h-touch flex-1 cursor-pointer items-center gap-2 border px-4 text-sm">
                  <input type="radio" name="deliveryMethod" value="np_postomat" data-delivery-method />
                  Поштомат
                </label>
              </div>

              <div class="relative">
                <label for="settlementQuery" class="text-ink-soft mb-1.5 block text-sm">Населений пункт</label>
                <input
                  id="settlementQuery"
                  type="text"
                  autocomplete="off"
                  placeholder="Почніть вводити назву міста…"
                  required
                  class={inputClass}
                  data-settlement-query
                />
                <ul
                  data-settlement-results
                  role="listbox"
                  aria-label="Знайдені населені пункти"
                  class="border-line bg-paper-raised rounded-card absolute inset-x-0 top-full z-10 mt-1 max-h-64 overflow-y-auto border shadow-lg"
                  hidden
                ></ul>

                {
                  suggestions.length > 0 && (
                    <div
                      data-settlement-suggestions
                      class="mt-2 flex flex-wrap gap-1.5"
                      aria-label="Популярні міста"
                    >
                      {suggestions.map((suggestion) => (
                        <button
                          type="button"
                          data-settlement-suggestion
                          data-ref={suggestion.ref}
                          data-name={suggestion.name}
                          data-area={suggestion.area ?? ''}
                          data-region={suggestion.region ?? ''}
                          data-type={suggestion.type ?? ''}
                          title={settlementLabel(suggestion)}
                          class="border-line-strong bg-paper-raised text-ink-soft hover:border-brand hover:text-brand inline-flex cursor-pointer items-center gap-1 rounded-full border px-3 py-1.5 text-xs transition-colors"
                        >
                          {suggestion.fromLocation && (
                            <svg
                              viewBox="0 0 24 24"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="2"
                              aria-hidden="true"
                              class="size-3.5 shrink-0"
                            >
                              <path d="M12 21s-7-6.2-7-11a7 7 0 1 1 14 0c0 4.8-7 11-7 11Z" />
                              <circle cx="12" cy="10" r="2.5" />
                            </svg>
                          )}
                          {suggestion.name}
                        </button>
                      ))}
                    </div>
                  )
                }
              </div>

              <div data-warehouse-field class="relative">
                {/* Both the label and the dropdown's accessible name follow the
                    selected method — see `applyDeliveryMethod`. The markup
                    carries the branch wording because that radio ships checked. */}
                <label
                  for="warehouseQuery"
                  class="text-ink-soft mb-1.5 block text-sm"
                  data-warehouse-label>Відділення</label
                >
                <input
                  id="warehouseQuery"
                  type="text"
                  autocomplete="off"
                  placeholder="Спочатку оберіть населений пункт"
                  required
                  disabled
                  class={inputClass}
                  data-warehouse-query
                />
                <ul
                  data-warehouse-results
                  role="listbox"
                  aria-label="Знайдені відділення"
                  class="border-line bg-paper-raised rounded-card absolute inset-x-0 top-full z-10 mt-1 max-h-64 overflow-y-auto border shadow-lg"
                  hidden
                ></ul>
              </div>

              <p class="text-ink-muted text-xs">Вартість доставки оплачує отримувач за тарифами Нової Пошти.</p>
            </fieldset>

            <fieldset class="space-y-3">
              <legend class="text-lg sm:text-xl">Оплата</legend>

              <label class="border-line-strong has-checked:border-brand has-checked:bg-brand/5 rounded-btn flex min-h-touch cursor-pointer items-center gap-2 border px-4 text-sm">
                <input type="radio" name="paymentMethod" value="card" checked data-payment-method />
                Карткою онлайн
              </label>
              {/* Shown by the script only when `/api/checkout/limits` says
                  «частинами» is configured and the cart reaches its minimum. */}
              <label
                class="border-line-strong has-checked:border-brand has-checked:bg-brand/5 rounded-btn flex min-h-touch cursor-pointer items-center gap-2 border px-4 py-2 text-sm"
                data-parts-label
                hidden
              >
                <input type="radio" name="paymentMethod" value="parts" data-payment-method />
                <span>
                  {PARTS_NAME} ·
                  <a href="/chastynamy" target="_blank" class="text-ink-muted text-xs underline underline-offset-2">умови</a>
                  <span class="text-ink-muted block text-xs" data-parts-hint></span>
                  {/* monobank's two required legal texts, at 12px against the
                      name's 14px — the rule is at least half its size. */}
                  {PARTS_AD_LEGAL.map((text) => (
                    <span class="text-ink-muted mt-1 block text-xs">{text}</span>
                  ))}
                </span>
              </label>
              <label
                class="border-line-strong has-checked:border-brand has-checked:bg-brand/5 rounded-btn flex min-h-touch cursor-pointer items-center gap-2 border px-4 text-sm has-disabled:cursor-not-allowed has-disabled:opacity-50"
                data-cod-label
              >
                <input type="radio" name="paymentMethod" value="cod" data-payment-method />
                Готівкою при отриманні
              </label>
              <p class="text-ink-muted text-xs" data-cod-over-limit hidden></p>
            </fieldset>

            <fieldset>
              <label for="comment" class="text-ink-soft mb-1.5 block text-sm">
                Коментар до замовлення <span class="text-ink-muted">(необов’язково)</span>
              </label>
              <textarea
                id="comment"
                name="comment"
                rows="3"
                maxlength={MAX_COMMENT_LENGTH}
                class={`${inputClass} min-h-[64px] py-3`}
              ></textarea>
            </fieldset>

            <p class="text-ink hidden text-sm" data-submit-error role="alert"></p>

            <Button type="submit" size="lg" block data-submit>Підтвердити замовлення</Button>
          </form>

          <aside
            class="border-line bg-paper-raised rounded-card border p-5 sm:p-6 lg:sticky lg:top-[calc(var(--spacing-header)+1.5rem)] lg:self-start"
            aria-labelledby="summary-heading"
          >
            <h2 id="summary-heading" class="text-lg sm:text-xl">Ваше замовлення</h2>

            <ul data-summary-lines class="border-line mt-4 divide-y divide-(--color-line) border-t text-sm"></ul>

            {/* Companions of what is in the cart, not yet added — filled by the
                script from `/api/cart`'s `offers`. */}
            <div class="border-line mt-4 border-t pt-4" data-offers hidden>
              <p class="text-ink text-sm font-medium">Додайте до замовлення</p>
              <ul class="mt-3 space-y-3 text-sm" data-offer-list></ul>
            </div>

            <div class="border-line mt-4 flex items-baseline justify-between gap-4 border-t pt-4 text-sm" data-discount-row hidden>
              <span class="text-ink-muted" data-discount-label>Знижка</span>
              <span class="price" data-discount></span>
            </div>

            <div class="border-line mt-4 flex items-baseline justify-between gap-4 border-t pt-4">
              <span class="text-ink font-medium">Разом</span>
              <span class="price text-xl sm:text-2xl" data-total></span>
            </div>
          </aside>
        </div>
      </div>
    </div>
  </Container>
</BaseLayout>

<script>
  import type { CartLine, CartSummary } from '@balier/lib/cart';
  import { fetchCartSummary } from '@balier/lib/cart/client';
  import { PROMO_ERROR_TEXT, checkoutNoticeText, codOverLimitText, settlementLabel } from '@balier/lib/i18n/checkout';
  import { campaignCode, discountFor, normalizePromoCode } from '@balier/lib/orders/promo';
  import { formatPrice } from '@balier/lib/money';
  import { applyPhoneMask, isCompletePhoneDigits, phoneDigitsFromInput } from '@balier/lib/phone';
  import { addToCart, cartItems, clearCart } from '@balier/lib/cart/store';
  import { track } from '~/lib/analytics';
  import { fold, foldQuery } from '@balier/lib/novaposhta/normalize';
  import { ATTRIBUTION_STORAGE_KEY, type Attribution } from '@balier/lib/attribution';

  /** What `BaseLayout` kept about where this buyer came from; never blocks the order. */
  function readAttribution(): Attribution | undefined {
    try {
      const raw = localStorage.getItem(ATTRIBUTION_STORAGE_KEY);
      return raw ? (JSON.parse(raw) as Attribution) : undefined;
    } catch {
      return undefined;
    }
  }

  interface SettlementResult {
    ref: string;
    name: string;
    area: string | null;
    region: string | null;
    type: string | null;
  }

  interface WarehouseResult {
    ref: string;
    description: string;
  }
  type WarehouseRow = [ref: string, description: string];

  const root = document.querySelector<HTMLElement>('[data-checkout]');
  const form = root?.querySelector<HTMLFormElement>('[data-checkout-form]');

  if (root && form) {
    const panels = new Map<string, HTMLElement>();
    for (const panel of root.querySelectorAll<HTMLElement>('[data-state]')) {
      if (panel.dataset.state) panels.set(panel.dataset.state, panel);
    }
    const showState = (name: string) => {
      for (const [key, panel] of panels) panel.hidden = key !== name;
    };

    const retry = root.querySelector<HTMLButtonElement>('[data-retry]');
    const summaryLines = root.querySelector<HTMLUListElement>('[data-summary-lines]');
    const totalOutput = root.querySelector<HTMLElement>('[data-total]');
    const submitButton = form.querySelector<HTMLButtonElement>('[data-submit]');
    const submitError = form.querySelector<HTMLElement>('[data-submit-error]');

    const phoneInput = form.querySelector<HTMLInputElement>('[data-phone-input]');

    const settlementQuery = form.querySelector<HTMLInputElement>('[data-settlement-query]');
    const settlementResults = form.querySelector<HTMLUListElement>('[data-settlement-results]');
    const warehouseLabel = form.querySelector<HTMLLabelElement>('[data-warehouse-label]');
    const warehouseQuery = form.querySelector<HTMLInputElement>('[data-warehouse-query]');
    const warehouseResultsList = form.querySelector<HTMLUListElement>('[data-warehouse-results]');
    const codLabel = form.querySelector<HTMLElement>('[data-cod-label]');
    const promoInput = form.querySelector<HTMLInputElement>('[data-promo-input]');
    const promoError = form.querySelector<HTMLElement>('[data-promo-error]');
    const discountRow = root.querySelector<HTMLElement>('[data-discount-row]');
    const discountLabel = root.querySelector<HTMLElement>('[data-discount-label]');
    const discountOutput = root.querySelector<HTMLElement>('[data-discount]');
    const codOverLimitNote = form.querySelector<HTMLElement>('[data-cod-over-limit]');

    let cart: CartSummary | null = null;
    let codLimitKopiykas = 0;
    /** «Частинами» as `/api/checkout/limits` reports it; null = not offered. */
    let partsOffer: { minTotalKopiykas: number; maxCount: number } | null = null;
    const partsLabel = form.querySelector<HTMLElement>('[data-parts-label]');
    const partsHint = form.querySelector<HTMLElement>('[data-parts-hint]');
    /** Percent the promo is running at, or null when it is off. */
    let promoPercent: number | null = null;
    let selectedSettlement: SettlementResult | null = null;
    let selectedWarehouse: WarehouseResult | null = null;
    let settlementSearchDebounce: number | undefined;

    /**
     * Short, because the lookups behind it are edge-cached now and usually
     * answer in a few milliseconds — the old 300 ms was sized for a query that
     * always went to the database.
     */
    const SEARCH_DEBOUNCE_MS = 150;

    /**
     * At most one request in flight per picker. Without this the responses
     * race: type «київ» quickly and the reply for «ки» can land *after* the one
     * for «київ», leaving the dropdown showing results for a prefix the
     * customer has already finished typing past.
     */
    const inFlight: { settlement?: AbortController; warehouse?: AbortController } = {};

    /**
     * Answers already received this session. Backspacing through a query walks
     * back over prefixes we just asked about, and those cannot have changed
     * while the customer was typing.
     */
    const lookupCache = new Map<string, unknown>();

    /** Resolves to `null` whenever the result should not be painted. */
    async function lookup<T>(picker: 'settlement' | 'warehouse', url: string): Promise<T | null> {
      // Anything still in flight is answering a question the customer has
      // already moved on from — including when this call is a cache hit.
      inFlight[picker]?.abort();
      inFlight[picker] = undefined;

      const cached = lookupCache.get(url);
      if (cached !== undefined) return cached as T;

      const controller = new AbortController();
      inFlight[picker] = controller;

      try {
        const response = await fetch(url, { signal: controller.signal });
        if (!response.ok) return null;

        const body = (await response.json()) as T;
        lookupCache.set(url, body);
        return body;
      } catch {
        // Aborted, offline, or malformed — leave the list as it is rather than
        // blanking it. The customer can keep typing.
        return null;
      }
    }

    const currentDeliveryMethod = () =>
      form.querySelector<HTMLInputElement>('[data-delivery-method]:checked')?.value ?? 'np_warehouse';

    phoneInput?.addEventListener('input', () => applyPhoneMask(phoneInput));

    const paintSummary = (summary: CartSummary) => {
      if (!summaryLines || !totalOutput) return;

      summaryLines.replaceChildren(
        ...summary.lines.map((line: CartLine) => {
          const item = document.createElement('li');
          item.className = 'flex items-start justify-between gap-3 py-2.5';

          const label = document.createElement('div');
          label.className = 'min-w-0';
          const title = document.createElement('p');
          title.className = 'text-ink truncate';
          title.textContent = line.productTitle;
          label.appendChild(title);

          if (line.variantName) {
            const variant = document.createElement('p');
            variant.className = 'text-ink-muted text-xs';
            variant.textContent = `${line.variantName} · ${line.quantity} шт.`;
            label.appendChild(variant);
          } else {
            const qty = document.createElement('p');
            qty.className = 'text-ink-muted text-xs';
            qty.textContent = `${line.quantity} шт.`;
            label.appendChild(qty);
          }

          if (line.bundleUnits > 0 && line.bundleUnitPrice < line.unitPrice) {
            const bundle = document.createElement('p');
            bundle.className = 'text-brand text-xs';
            bundle.textContent = `${line.bundleUnits} шт. — ціна в наборі`;
            label.appendChild(bundle);
          }

          const price = document.createElement('span');
          price.className = 'price shrink-0';
          price.textContent = formatPrice(line.lineTotal);

          // `.append()` on `Element` is shadowed by the same HTMLRewriter
          // global-type merge noted above — `appendChild` isn't, so it stays
          // the DOM one.
          item.appendChild(label);
          item.appendChild(price);
          return item;
        }),
      );

      paintOffers(summary);
      paintTotal(summary);
    };

    /** One row per offer: photo, name, bundle price, «+ Додати». */
    const paintOffers = (summary: CartSummary) => {
      const block = root.querySelector<HTMLElement>('[data-offers]');
      const list = root.querySelector<HTMLElement>('[data-offer-list]');
      if (!block || !list) return;
      block.hidden = summary.offers.length === 0;
      list.replaceChildren(
        ...summary.offers.map((offer) => {
          const item = document.createElement('li');
          item.className = 'flex items-center gap-3';

          if (offer.imageUrl) {
            const image = document.createElement('img');
            image.src = offer.imageUrl;
            image.alt = '';
            image.width = 48;
            image.height = 48;
            image.className = 'rounded-btn h-12 w-12 shrink-0 object-cover';
            item.appendChild(image);
          }

          const label = document.createElement('div');
          label.className = 'min-w-0 flex-1';
          const title = document.createElement('p');
          title.className = 'text-ink truncate';
          title.textContent = offer.productTitle;
          const price = document.createElement('p');
          price.className = 'text-xs';
          if (offer.bundleUnitPrice < offer.unitPrice) {
            const full = document.createElement('s');
            full.className = 'text-ink-muted mr-1.5';
            full.textContent = formatPrice(offer.unitPrice);
            price.appendChild(full);
          }
          const bundle = document.createElement('span');
          bundle.className = 'price';
          bundle.textContent = formatPrice(offer.bundleUnitPrice);
          price.appendChild(bundle);
          label.appendChild(title);
          label.appendChild(price);

          const add = document.createElement('button');
          add.type = 'button';
          add.className =
            'border-line-strong text-ink hover:bg-paper rounded-btn min-h-touch shrink-0 border px-3 text-sm sm:min-h-9';
          add.textContent = '+ Додати';
          add.addEventListener('click', async () => {
            add.disabled = true;
            addToCart(offer.variantId, 1);
            track('Add to cart', { source: 'checkout' });
            await refresh();
          });

          item.appendChild(label);
          item.appendChild(add);
          return item;
        }),
      );
    };

    /**
     * A preview, not a verdict: any code-shaped entry shows the running
     * percentage off so the customer sees what they will pay; whether the
     * code is real and unspent is the server's call at submit.
     */
    const paintTotal = (summary: CartSummary) => {
      if (!totalOutput) return;
      const code = normalizePromoCode(promoInput?.value ?? '');
      const percent = code === '' ? null : (campaignCode(code)?.percent ?? promoPercent);
      const discount = percent !== null ? discountFor(summary.total, percent) : 0;
      if (discountRow && discountOutput && discountLabel) {
        discountRow.hidden = discount === 0;
        discountLabel.textContent = `Знижка ${percent ?? 0} %`;
        discountOutput.textContent = `−${formatPrice(discount)}`;
      }
      totalOutput.textContent = formatPrice(summary.total - discount);
    };

    promoInput?.addEventListener('input', () => {
      if (promoError) promoError.hidden = true;
      if (cart) paintTotal(cart);
    });

    /** Offered from the minimum up; below it the option disappears and card is picked. */
    const paintPartsAvailability = () => {
      if (!cart || !partsLabel) return;
      const available = partsOffer !== null && cart.total >= partsOffer.minTotalKopiykas;
      partsLabel.hidden = !available;
      const radio = partsLabel.querySelector<HTMLInputElement>('input[value="parts"]');
      if (!available && radio?.checked) {
        const cardRadio = form.querySelector<HTMLInputElement>('input[name="paymentMethod"][value="card"]');
        if (cardRadio) cardRadio.checked = true;
      }
      if (available && partsHint && partsOffer) {
        partsHint.textContent = `від ${formatPrice(Math.ceil(cart.total / partsOffer.maxCount / 100) * 100)} на місяць · підтвердження в застосунку monobank`;
      }
    };

    const paintCodAvailability = () => {
      paintPartsAvailability();
      if (!cart || !codLabel || !codOverLimitNote) return;
      const codRadio = codLabel.querySelector<HTMLInputElement>('input[value="cod"]');
      const overLimit = cart.total > codLimitKopiykas;

      if (codRadio) codRadio.disabled = overLimit;
      codOverLimitNote.hidden = !overLimit;
      if (overLimit) codOverLimitNote.textContent = codOverLimitText(codLimitKopiykas);
      if (overLimit && codRadio?.checked) {
        const cardRadio = form.querySelector<HTMLInputElement>('input[name="paymentMethod"][value="card"]');
        if (cardRadio) cardRadio.checked = true;
      }
    };

    /**
     * A branch and a parcel locker are picked from the same field, so the only
     * thing telling the customer which one they are about to choose is this
     * label — «Відділення / поштомат» named both at once and neither in
     * particular. The dropdown's accessible name follows it, since a screen
     * reader gets no help from the visible label alone.
     */
    const applyDeliveryMethod = () => {
      const isPostomat = currentDeliveryMethod() === 'np_postomat';
      if (warehouseLabel) warehouseLabel.textContent = isPostomat ? 'Поштомат' : 'Відділення';
      if (warehouseResultsList) {
        warehouseResultsList.setAttribute(
          'aria-label',
          isPostomat ? 'Знайдені поштомати' : 'Знайдені відділення',
        );
      }
    };

    const clearWarehouses = () => {
      selectedWarehouse = null;
      if (warehouseQuery) {
        warehouseQuery.value = '';
        warehouseQuery.disabled = !selectedSettlement;
        warehouseQuery.placeholder = selectedSettlement
          ? 'Почніть вводити номер або адресу…'
          : 'Спочатку оберіть населений пункт';
      }
      if (warehouseResultsList) {
        warehouseResultsList.hidden = true;
        warehouseResultsList.replaceChildren();
      }
    };

    const paintWarehouseResults = (results: WarehouseResult[]) => {
      if (!warehouseResultsList) return;
      warehouseResultsList.replaceChildren(
        ...results.map((warehouse) => {
          const item = document.createElement('li');
          item.setAttribute('role', 'option');
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'hover:bg-tag w-full px-4 py-2.5 text-left text-sm';
          button.textContent = warehouse.description;
          button.addEventListener('click', () => {
            selectedWarehouse = warehouse;
            if (warehouseQuery) warehouseQuery.value = warehouse.description;
            warehouseResultsList.hidden = true;
          });
          item.appendChild(button);
          return item;
        }),
      );
      warehouseResultsList.hidden = results.length === 0;
    };

    /**
     * The whole list for the chosen settlement and kind is downloaded once
     * (edge-cached a day, kept by `lookup` for the page's life) and searched
     * here, so typing costs no request. Matching is the server's old rule:
     * the folded query as a substring of the folded description, which also
     * carries the number («№12»). The folded text is computed once per list.
     */
    const foldedLists = new WeakMap<WarehouseRow[], string[]>();
    const WAREHOUSE_RESULT_LIMIT = 50;

    const loadWarehouses = async (query: string) => {
      if (!selectedSettlement || !warehouseQuery) return;
      const method = currentDeliveryMethod();
      // `v` is the row format — a new one must not meet an hour-old cached list.
      const rows = await lookup<WarehouseRow[]>(
        'warehouse',
        `/api/checkout/np-warehouses?settlementRef=${encodeURIComponent(selectedSettlement.ref)}&kind=${method}&v=2`,
      );
      if (!rows) return;

      let folded = foldedLists.get(rows);
      if (!folded) {
        folded = rows.map((row) => fold(row[1]));
        foldedLists.set(rows, folded);
      }
      const needle = foldQuery(query);
      const results: WarehouseResult[] = [];
      for (let i = 0; i < rows.length && results.length < WAREHOUSE_RESULT_LIMIT; i++) {
        if (needle && !folded[i]!.includes(needle)) continue;
        const [ref, description] = rows[i]!;
        results.push({ ref, description });
      }
      paintWarehouseResults(results);
    };

    warehouseQuery?.addEventListener('focus', () => {
      if (!selectedSettlement) return;
      loadWarehouses(warehouseQuery.value.trim());
    });

    warehouseQuery?.addEventListener('input', () => {
      selectedWarehouse = null;
      loadWarehouses(warehouseQuery.value.trim());
    });

    /**
     * The one way a settlement gets chosen — by the dropdown and by the
     * suggestion chips alike, so the two can never drift into settling
     * different amounts of state.
     */
    const selectSettlement = (settlement: SettlementResult) => {
      selectedSettlement = settlement;
      if (settlementQuery) settlementQuery.value = settlementLabel(settlement);
      if (settlementResults) settlementResults.hidden = true;
      clearWarehouses();
    };

    for (const chip of form.querySelectorAll<HTMLButtonElement>('[data-settlement-suggestion]')) {
      chip.addEventListener('click', () => {
        selectSettlement({
          ref: chip.dataset.ref ?? '',
          name: chip.dataset.name ?? '',
          // Rendered as '' when the column is NULL; the label builder wants null.
          area: chip.dataset.area || null,
          region: chip.dataset.region || null,
          type: chip.dataset.type || null,
        });
        // Straight on to the branch picker — choosing the city was the point
        // of the chip, so making them tap the next field too would waste it.
        warehouseQuery?.focus();
      });
    }

    const paintSettlementResults = (results: SettlementResult[]) => {
      if (!settlementResults) return;
      settlementResults.replaceChildren(
        ...results.map((settlement) => {
          const item = document.createElement('li');
          item.setAttribute('role', 'option');
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'hover:bg-tag w-full px-4 py-2.5 text-left text-sm';
          button.textContent = settlementLabel(settlement);
          button.addEventListener('click', () => selectSettlement(settlement));
          item.appendChild(button);
          return item;
        }),
      );
      settlementResults.hidden = results.length === 0;
    };

    settlementQuery?.addEventListener('input', () => {
      selectedSettlement = null;
      clearWarehouses();
      window.clearTimeout(settlementSearchDebounce);
      const value = settlementQuery.value.trim();
      if (value.length < 2) {
        if (settlementResults) settlementResults.hidden = true;
        return;
      }
      settlementSearchDebounce = window.setTimeout(async () => {
        const results = await lookup<SettlementResult[]>(
          'settlement',
          `/api/checkout/np-settlements?q=${encodeURIComponent(value)}`,
        );
        if (results) paintSettlementResults(results);
      }, SEARCH_DEBOUNCE_MS);
    });

    for (const radio of form.querySelectorAll<HTMLInputElement>('[data-delivery-method]')) {
      radio.addEventListener('change', () => {
        applyDeliveryMethod();
        clearWarehouses();
      });
    }

    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Node)) return;
      if (settlementResults && !settlementResults.hidden && !form.contains(event.target)) {
        settlementResults.hidden = true;
      }
      if (warehouseResultsList && !warehouseResultsList.hidden && !form.contains(event.target)) {
        warehouseResultsList.hidden = true;
      }
    });

    const load = async () => {
      if (cartItems.get().length === 0) {
        showState('empty');
        return;
      }

      showState('loading');
      try {
        const [summary, limitsResponse] = await Promise.all([
          fetchCartSummary(),
          fetch('/api/checkout/limits'),
        ]);
        const { codLimitKopiykas: limit, promo, parts } = (await limitsResponse.json()) as {
          codLimitKopiykas: number;
          promo: { percent: number } | null;
          parts: { minTotalKopiykas: number; maxCount: number } | null;
        };
        promoPercent = promo?.percent ?? null;
        partsOffer = parts;

        if (summary.lines.length === 0) {
          showState('empty');
          return;
        }

        cart = summary;
        codLimitKopiykas = limit;
        paintSummary(summary);
        paintCodAvailability();
        applyDeliveryMethod();
        showState('form');
      } catch (error) {
        console.error(error);
        showState('error');
      }
    };

    retry?.addEventListener('click', () => void load());

    /** Re-price after the cart changed on this page, without leaving the form. */
    const refresh = async () => {
      try {
        const summary = await fetchCartSummary();
        cart = summary;
        paintSummary(summary);
        paintCodAvailability();
      } catch (error) {
        console.error(error);
      }
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!cart || !form.reportValidity()) return;

      const phoneDigits = phoneDigitsFromInput(phoneInput?.value ?? '');
      if (!isCompletePhoneDigits(phoneDigits)) {
        if (submitError) {
          submitError.textContent = 'Введіть повний номер телефону.';
          submitError.hidden = false;
        }
        return;
      }

      const deliveryMethod = currentDeliveryMethod();
      if (!selectedSettlement || !selectedWarehouse) {
        if (submitError) {
          submitError.textContent =
            deliveryMethod === 'np_postomat'
              ? 'Оберіть населений пункт і поштомат.'
              : 'Оберіть населений пункт і відділення.';
          submitError.hidden = false;
        }
        return;
      }

      const data = new FormData(form);

      const delivery = {
        deliveryMethod,
        npSettlementRef: selectedSettlement.ref,
        npSettlementName: selectedSettlement.name,
        npWarehouseRef: selectedWarehouse.ref,
        npWarehouseName: selectedWarehouse.description,
      };

      const payload = {
        customerName: String(data.get('customerName') ?? ''),
        customerPhone: `+380${phoneDigits}`,
        customerEmail: String(data.get('customerEmail') ?? ''),
        delivery,
        paymentMethod: String(data.get('paymentMethod') ?? 'card'),
        comment: String(data.get('comment') ?? ''),
        promoCode: String(data.get('promoCode') ?? ''),
        items: cartItems.get(),
        attribution: readAttribution(),
      };

      if (submitButton) submitButton.disabled = true;
      if (submitError) submitError.hidden = true;

      try {
        const response = await fetch('/api/checkout', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(payload),
        });

        const body = (await response.json()) as {
          orderNumber?: string;
          redirectUrl?: string;
          error?: string;
          notices?: { variantId: string; reason: 'unavailable' | 'out_of_stock'; title: string | null }[];
        };

        if (response.ok && body.redirectUrl) {
          track('Order placed', { payment: payload.paymentMethod });
          clearCart();
          // stonks sends the event as an image request, which the navigation
          // below would abort; a beat lets it leave. Invisible to the buyer.
          await new Promise((resolve) => setTimeout(resolve, 150));
          window.location.href = body.redirectUrl;
          return;
        }

        if (body.error === 'cart_changed' && body.notices) {
          if (submitError) {
            submitError.textContent = body.notices.map(checkoutNoticeText).join(' ');
            submitError.hidden = false;
          }
          await load();
          return;
        }

        if (body.error === 'parts_unavailable') {
          if (submitError) {
            submitError.textContent = 'Покупка Частинами зараз недоступна для цього замовлення. Оберіть оплату карткою.';
            submitError.hidden = false;
          }
          return;
        }

        if (body.error === 'cod_over_limit') {
          if (submitError) {
            submitError.textContent = codOverLimitText(codLimitKopiykas);
            submitError.hidden = false;
          }
          return;
        }

        if (body.error === 'promo_invalid' || body.error === 'promo_used' || body.error === 'promo_not_first') {
          if (promoError) {
            promoError.textContent = PROMO_ERROR_TEXT[body.error];
            promoError.hidden = false;
          }
          promoInput?.focus();
          return;
        }

        window.location.href = '/checkout/failure';
      } catch (error) {
        console.error(error);
        if (submitError) {
          submitError.textContent = 'Не вдалося оформити замовлення. Спробуйте ще раз.';
          submitError.hidden = false;
        }
      } finally {
        if (submitButton) submitButton.disabled = false;
      }
    });

    void load();
  }
</script>
