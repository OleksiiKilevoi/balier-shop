---
/**
 * Swipeable, gapless product gallery.
 *
 * The track is a CSS scroll-snap container, so the swipe is the browser's own —
 * native momentum, native rubber-banding, and it works with no JavaScript at all.
 * Script only mirrors the scroll position into the dots and thumbnails, and
 * drives the reverse direction when a thumbnail is clicked.
 *
 * Phone gets dots — a 320px viewport has no room for a thumbnail strip beside a
 * swipeable image; the mockup's strip takes over from `sm:` up. Note this does
 * not save any bytes: the carousel holds every photo, and the browser fetches
 * them regardless of `loading="lazy"` because they sit inside the scroll port.
 * Getting the payload down is the export-size decision in roadmap.md, not a
 * markup change.
 *
 * Listens for `product:variant` (the chosen colour's variant ids) so choosing a colour swaps the gallery —
 * `product_images.variant_id` is NULL for photos shared by every variant and set
 * for photos belonging to one colour only.
 */
interface GalleryImage {
  variantId: string | null;
  url: string;
  alt: string | null;
  width: number | null;
  height: number | null;
}

interface Props {
  images: readonly GalleryImage[];
  /** Fallback alt text when a row has none. */
  title: string;
}

const { images, title } = Astro.props;
---

{/* min-w-0: this is a grid item, and its automatic minimum size would otherwise
    be the *content* width of the scroll containers inside it — a 5-thumbnail
    strip then widens the whole column past a 320px viewport. `overflow-x` only
    zeroes that for flex/grid items, which these blocks are not. */}
<div data-gallery class="min-w-0">
  {
    images.length > 0 ? (
      <ul
        data-gallery-track
        tabindex="0"
        aria-label={`Фотографії: ${title}`}
        class="border-line rounded-card relative flex snap-x snap-mandatory overflow-x-auto overscroll-x-contain border"
      >
        {images.map((image, index) => (
          /* No gap, and each slide is exactly one viewport wide — the snap lands
             edge to edge with nothing of the neighbour showing. */
          <li
            data-slide
            data-variant-id={image.variantId ?? ''}
            class="bg-line/40 aspect-3/4 w-full shrink-0 snap-center snap-always"
          >
            <img
              src={image.url}
              alt={index === 0 ? (image.alt ?? title) : ''}
              width={image.width ?? undefined}
              height={image.height ?? undefined}
              loading={index === 0 ? 'eager' : 'lazy'}
              fetchpriority={index === 0 ? 'high' : undefined}
              decoding="async"
              draggable="false"
              class="h-full w-full object-cover"
            />
          </li>
        ))}
      </ul>
    ) : (
      <div class="border-line bg-line/40 rounded-card text-ink-muted flex aspect-3/4 items-center justify-center border text-sm">
        Фото незабаром
      </div>
    )
  }

  {
    images.length > 1 && (
      <Fragment>
        {/* Indicators, not controls — swiping is the interaction, so these carry
            no touch target and no tab stop. */}
        <div data-gallery-dots class="mt-3 flex justify-center gap-1.5 sm:hidden" aria-hidden="true">
          {images.map((image, index) => (
            <span
              data-dot
              data-variant-id={image.variantId ?? ''}
              data-active={index === 0 ? 'true' : 'false'}
              class="bg-line-strong data-[active=true]:bg-brand h-1.5 w-1.5 rounded-full transition-all data-[active=true]:w-4"
            />
          ))}
        </div>

        <ul class="mt-4 hidden gap-3 overflow-x-auto pb-1 sm:flex" data-gallery-thumbs>
          {images.map((image, index) => (
            <li data-variant-id={image.variantId ?? ''} class="shrink-0">
              <button
                type="button"
                data-thumb
                data-index={String(index)}
                aria-pressed={index === 0 ? 'true' : 'false'}
                aria-label={`Показати фото ${index + 1}`}
                class="rounded-card border-line aria-pressed:border-brand not-aria-pressed:hover:border-line-strong group block size-20 cursor-pointer overflow-hidden border-2 transition-colors"
              >
                <img
                  src={image.url}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover transition-opacity duration-150 group-hover:opacity-80"
                />
              </button>
            </li>
          ))}
        </ul>
      </Fragment>
    )
  }
</div>

<style>
  /* The swipe is the affordance; a scrollbar under the photo is just noise. */
  [data-gallery-track] {
    scrollbar-width: none;
  }

  [data-gallery-track]::-webkit-scrollbar {
    display: none;
  }

  [data-gallery-thumbs] {
    scrollbar-width: thin;
  }
</style>

<script>
  const gallery = document.querySelector<HTMLElement>('[data-gallery]');
  const track = gallery?.querySelector<HTMLElement>('[data-gallery-track]');

  if (gallery && track) {
    const slides = [...track.querySelectorAll<HTMLElement>('li[data-slide]')];
    const dots = [...gallery.querySelectorAll<HTMLElement>('[data-dot]')];
    const thumbs = [...gallery.querySelectorAll<HTMLButtonElement>('button[data-thumb]')];

    const markActive = (index: number) => {
      for (const [position, dot] of dots.entries()) {
        dot.dataset.active = String(position === index);
      }
      for (const [position, thumb] of thumbs.entries()) {
        thumb.setAttribute('aria-pressed', String(position === index));
      }
    };

    const scrollToSlide = (index: number, behavior: ScrollBehavior = 'smooth') => {
      const slide = slides[index];
      // The track is `relative`, so offsetLeft is measured from its padding edge
      // and is unaffected by how far it is already scrolled.
      if (slide) track.scrollTo({ left: slide.offsetLeft, behavior });
    };

    /**
     * The scroll position is the source of truth for which slide is showing —
     * a swipe, a thumbnail click and a keyboard arrow all end up here, so there
     * is only one place that decides what "active" means.
     */
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const index = slides.indexOf(entry.target as HTMLElement);
          if (index !== -1) markActive(index);
        }
      },
      { root: track, threshold: 0.6 },
    );

    for (const slide of slides) observer.observe(slide);

    for (const thumb of thumbs) {
      thumb.addEventListener('click', () => scrollToSlide(Number(thumb.dataset.index)));
    }

    document.addEventListener('product:variant', (event) => {
      // Every variant of the chosen colour — its sizes share its photos.
      const { variantIds } = (event as CustomEvent<{ variantIds: string[] }>).detail;

      // Empty owner = shared by every variant, so it stays throughout.
      const belongs = (element: HTMLElement) => {
        const owner = element.dataset.variantId ?? '';
        return owner === '' || variantIds.includes(owner);
      };

      let first = -1;
      for (const [index, slide] of slides.entries()) {
        const visible = belongs(slide);
        slide.hidden = !visible;
        if (visible && first === -1) first = index;

        const dot = dots[index];
        if (dot) dot.hidden = !visible;

        const thumbItem = thumbs[index]?.closest('li');
        if (thumbItem) thumbItem.hidden = !visible;
      }

      if (first !== -1) {
        // Instant: this is a change of subject, not a swipe through a strip.
        scrollToSlide(first, 'auto');
        markActive(first);
      }
    });
  }
</script>
