---
import type { HTMLAttributes } from 'astro/types';

type Variant = 'primary' | 'secondary' | 'telegram' | 'ghost';
type Size = 'sm' | 'md' | 'lg';

type Props = {
  variant?: Variant;
  size?: Size;
  /** Renders an <a> instead of a <button>. */
  href?: string;
  /** Stretches to the container width — used for the product page CTAs. */
  block?: boolean;
  class?: string;
} & Omit<HTMLAttributes<'button'> & HTMLAttributes<'a'>, 'size'>;

const {
  variant = 'primary',
  size = 'md',
  href,
  block = false,
  class: className,
  ...rest
} = Astro.props;

// shadcn/ui's button, minus React: same base, same four roles (default,
// outline, secondary-as-Telegram, ghost), our touch-height sizes.
const base =
  'inline-flex shrink-0 cursor-pointer items-center justify-center gap-2 rounded-btn text-center font-medium whitespace-nowrap transition-all duration-150 disabled:pointer-events-none disabled:opacity-50';

const variants: Record<Variant, string> = {
  primary: 'bg-brand text-white shadow-xs hover:bg-brand/90',
  secondary: 'border border-line bg-paper-raised text-ink shadow-xs hover:bg-tag hover:text-ink',
  telegram: 'bg-telegram text-white shadow-xs hover:bg-telegram-hover',
  ghost: 'text-ink-muted hover:bg-tag hover:text-ink',
};

// `sm` is the only size that falls under the 44px touch minimum, so it renders
// at full height on touch widths and compacts to the mockup size from `md:` up.
//
// `lg` is a *minimum* height, not a fixed one: «Замовити через Телеграм» needs
// ~267px on one line and a 320px viewport gives the label 198px, so it wraps to
// two lines there. With a fixed `h-13` that second line would spill out of the
// button. The padding also loosens only from `sm:` up, where the mockup's
// one-line version actually fits.
const sizes: Record<Size, string> = {
  sm: 'h-touch px-4 text-sm md:h-9',
  md: 'h-touch px-6 text-sm',
  lg: 'min-h-13 px-5 py-2.5 text-base sm:px-7',
};

const Tag = href ? 'a' : 'button';
---

<Tag
  href={href}
  class:list={[base, variants[variant], sizes[size], block && 'w-full', className]}
  {...rest}
>
  <slot />
</Tag>
