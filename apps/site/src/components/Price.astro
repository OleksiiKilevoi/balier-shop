---
import { formatPrice, type Kopiykas } from '@balier/lib/money';

interface Props {
  /** Kopiykas. */
  amount: Kopiykas;
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const { amount, size = 'md', class: className } = Astro.props;

const sizes = {
  sm: 'text-sm',
  md: 'text-base',
  lg: 'text-2xl',
} as const;
---

<p class:list={['flex items-baseline gap-2', className]}>
  <span class:list={['price', sizes[size]]}>{formatPrice(amount)}</span>
</p>
