---
import Container from './Container.astro';

const nav = [
  { href: '/products', label: 'Товари' },
  { href: '/about', label: 'Про нас' },
  { href: '/care', label: 'Догляд' },
  { href: '/personalization', label: 'Персоналізація' },
];

const pathname = Astro.url.pathname;
const isActive = (href: string) => pathname === href || pathname.startsWith(`${href}/`);
---

<header class="border-line bg-paper sticky top-0 z-40 border-b">
  <Container class="flex h-header items-center gap-2 sm:gap-4">
    <a href="/" class="font-display text-ink text-[1.75rem] font-semibold tracking-[0.18em]"> BÁLIER </a>

    <nav aria-label="Головне меню" class="hidden flex-1 justify-center md:flex">
      <ul class="flex items-center gap-8 text-sm">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class="hover:text-brand aria-[current=page]:text-brand text-ink-soft transition-colors aria-[current=page]:font-medium"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {/* Icon controls are sized to --spacing-touch rather than padded around the
        glyph — the gap tightens instead, so the row still reads as the mockup. */}
    <div class="ml-auto flex items-center gap-0.5 sm:gap-1 md:ml-0">
      <a
        href="/search"
        class="text-ink-soft hover:text-brand flex size-touch items-center justify-center transition-colors"
        aria-label="Пошук"
      >
        <svg width="19" height="19" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <circle cx="9" cy="9" r="6" stroke="currentColor" stroke-width="1.5"></circle>
          <path d="m13.5 13.5 3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
          ></path>
        </svg>
      </a>

      <a
        href="/cart"
        class="text-ink-soft hover:text-brand relative flex size-touch items-center justify-center transition-colors"
        aria-label="Кошик"
        data-cart-link
      >
        {/* The badge hangs off the glyph, not off the 44px hit area. */}
        <span class="relative flex">
          <svg width="21" height="21" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <g fill="none" stroke="currentColor" stroke-width="1.5">
              <path
                d="M3.864 16.455c-.858-3.432-1.287-5.147-.386-6.301S6.148 9 9.685 9h4.63c3.538 0 5.306 0 6.207 1.154s.472 2.87-.386 6.301c-.546 2.183-.818 3.274-1.632 3.91c-.814.635-1.939.635-4.189.635h-4.63c-2.25 0-3.375 0-4.189-.635c-.814-.636-1.087-1.727-1.632-3.91Z"
              ></path>
              <path
                d="m19.5 9.5l-.71-2.605c-.274-1.005-.411-1.507-.692-1.886A2.5 2.5 0 0 0 17 4.172C16.56 4 16.04 4 15 4M4.5 9.5l.71-2.605c.274-1.005.411-1.507.692-1.886A2.5 2.5 0 0 1 7 4.172C7.44 4 7.96 4 9 4"
              ></path>
              <path d="M9 4a1 1 0 0 1 1-1h4a1 1 0 1 1 0 2h-4a1 1 0 0 1-1-1Z"></path>
            </g>
          </svg>
          {/* A visual echo of the link's own accessible name, which the script
              keeps in step — announcing a bare number on its own tells a screen
              reader user nothing about what it counts. */}
          <span
            class="bg-brand absolute -top-1.5 -right-2 hidden h-4 min-w-4 items-center justify-center rounded-full px-1 text-[0.625rem] font-medium text-white"
            data-cart-count
            aria-hidden="true"></span>
        </span>
      </a>

      <button
        type="button"
        class="text-ink-soft flex size-touch items-center justify-center md:hidden"
        aria-label="Відкрити меню"
        aria-expanded="false"
        aria-controls="mobile-nav"
        data-menu-toggle
      >
        <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" fill="none">
          <path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.5"></path>
        </svg>
      </button>
    </div>
  </Container>

  {/* Absolutely positioned against the sticky header (its containing block),
      so the opening panel overlays the page instead of growing the header and
      pushing `<main>` down. Closed state is `grid-rows-[0fr]` + `opacity-0`
      rather than `hidden`, so the open/close is an animated height+fade instead
      of an instant cut; `inert` keeps the collapsed links out of tab order
      without a `display: none` jump. */}
  <nav
    id="mobile-nav"
    aria-label="Мобільне меню"
    inert
    class="border-line bg-paper absolute inset-x-0 top-full grid grid-rows-[0fr] overflow-hidden border-t opacity-0 transition-[grid-template-rows,opacity] duration-300 ease-out md:hidden"
  >
    <div class="min-h-0 overflow-hidden">
      <Container class="max-h-[calc(100dvh-var(--spacing-header))] overflow-y-auto">
        <ul class="flex flex-col py-2 text-base">
          {
            nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                  class="text-ink-soft aria-[current=page]:text-brand flex min-h-touch items-center justify-center text-center aria-[current=page]:font-medium"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </Container>
    </div>
  </nav>
</header>

<script>
  import { cartCountLabel } from '@balier/lib/i18n/cart';
  import { cartCount } from '@balier/lib/cart/store';

  const cartLink = document.querySelector<HTMLAnchorElement>('[data-cart-link]');
  const badge = cartLink?.querySelector<HTMLElement>('[data-cart-count]');

  if (cartLink && badge) {
    /**
     * The badge follows the *stored* cart, which is quantities only — no request
     * is made to price it on every page. It converges on what is actually
     * available the moment /cart or checkout revalidates.
     *
     * `hidden` and `inline-flex` are toggled as a pair rather than relying on one
     * display utility beating the other in the stylesheet.
     */
    cartCount.subscribe((count) => {
      badge.textContent = count > 99 ? '99+' : String(count);
      badge.classList.toggle('hidden', count === 0);
      badge.classList.toggle('inline-flex', count > 0);
      cartLink.setAttribute('aria-label', cartCountLabel(count));
    });
  }

  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const panel = document.querySelector<HTMLElement>('#mobile-nav');

  if (toggle && panel) {
    const OPEN = ['grid-rows-[1fr]', 'opacity-100'];
    const CLOSED = ['grid-rows-[0fr]', 'opacity-0'];

    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Закрити меню' : 'Відкрити меню');
      panel.classList.remove(...(open ? CLOSED : OPEN));
      panel.classList.add(...(open ? OPEN : CLOSED));
      panel.toggleAttribute('inert', !open);
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });

    // The panel is `md:hidden`, so on rotation to a tablet width it disappears
    // while `aria-expanded` would otherwise stay stuck on "true".
    const desktop = window.matchMedia('(width >= 48rem)');
    desktop.addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>
