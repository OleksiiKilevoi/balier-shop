---
import Container from './Container.astro';

const year = new Date().getFullYear();

const columns = [
  {
    title: 'Магазин',
    links: [{ href: '/products', label: 'Усі товари' }],
  },
  {
    title: 'Про нас',
    links: [
      { href: '/about', label: 'Наша історія' },
      { href: '/care', label: 'Догляд за шкірою' },
      { href: '/personalization', label: 'Персоналізація' },
      { href: '/palette', label: 'Палітра шкіри' },
    ],
  },
  {
    title: 'Обслуговування',
    links: [
      { href: '/delivery', label: 'Доставка' },
      { href: '/returns', label: 'Повернення та обмін' },
      { href: '/corporate', label: 'Для бізнесу' },
      { href: '/contacts', label: "Зв'язатися з нами" },
    ],
  },
];

// Kept out of the columns above and put in the bottom bar, where a shopper
// looks for them. They are also a hard requirement of the Monobank Acquiring
// application, so they must be reachable from every page.
const legal = [
  { href: '/offer', label: 'Публічна оферта' },
  { href: '/privacy', label: 'Політика конфіденційності' },
];
---

<footer class="bg-espresso mt-16 py-12 text-white/75 sm:mt-24 sm:py-14">
  {/* Three columns, not the mockup's four — the newsletter signup that filled the
      fourth is not a release feature (see roadmap.md). */}
  <Container class="grid gap-8 sm:grid-cols-2 sm:gap-10 lg:grid-cols-3">
    {
      columns.map((column) => (
        <nav aria-label={column.title}>
          <p class="font-display mb-2 text-lg font-bold text-white sm:mb-3">{column.title}</p>
          {/* Padded to a comfortable row height instead of relying on `space-y`,
              which leaves 20px-tall links between untappable gaps. */}
          <ul class="text-sm">
            {column.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="flex min-h-touch items-center transition-colors hover:text-white md:min-h-0 md:py-1.5"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }

  </Container>

  <Container class="mt-10 border-t border-white/10 pt-6 text-xs sm:mt-12">
    <nav aria-label="Правова інформація" class="flex flex-col sm:flex-row sm:gap-6">
      {
        legal.map((link) => (
          <a
            href={link.href}
            class="flex min-h-touch items-center transition-colors hover:text-white md:min-h-0 md:py-1"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div
      class="mt-1 flex flex-col gap-1 sm:mt-4 sm:flex-row sm:items-center sm:justify-between sm:gap-2"
    >
      <p>© {year} Balier. Усі права захищено.</p>
      <div class="flex items-center gap-1 md:gap-4">
        <a
          href="https://www.instagram.com/balier.ua/"
          rel="me noopener"
          target="_blank"
          aria-label="Instagram"
          class="flex min-h-touch min-w-touch items-center justify-center transition-colors hover:text-white md:min-h-0 md:min-w-0"
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.5"
            ></rect>
            <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.5"></circle>
            <circle cx="17.25" cy="6.75" r="1" fill="currentColor"></circle>
          </svg>
        </a>
        <a
          href="https://www.facebook.com/balier.ua/"
          rel="me noopener"
          target="_blank"
          aria-label="Facebook"
          class="flex min-h-touch min-w-touch items-center justify-center transition-colors hover:text-white md:min-h-0 md:min-w-0"
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"></circle>
            <path
              d="M13.5 21v-7h2.25l.35-2.75H13.5V9.5c0-.8.25-1.35 1.4-1.35h1.35V5.7A17 17 0 0 0 14.3 5.6c-2 0-3.3 1.2-3.3 3.45v2.2H8.75V14H11v7"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linejoin="round"
            ></path>
          </svg>
        </a>
        <a
          href="https://t.me/balierua"
          rel="me noopener"
          target="_blank"
          aria-label="Telegram"
          class="flex min-h-touch min-w-touch items-center justify-center transition-colors hover:text-white md:min-h-0 md:min-w-0"
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"></circle>
            <path
              d="m7 11.6 9.2-3.6c.5-.2.9.1.7.8l-1.6 7.3c-.1.5-.5.6-.9.4l-2.5-1.8-1.2 1.2c-.2.2-.3.2-.5.2l.2-2.6 4.5-4.1c.2-.2 0-.3-.3-.1l-5.6 3.5-2.4-.8c-.5-.2-.5-.5.4-.4Z"
              stroke="currentColor"
              stroke-width="1.2"
              stroke-linejoin="round"
            ></path>
          </svg>
        </a>
        <a
          href="https://viber.me/380986026626"
          rel="noopener"
          target="_blank"
          aria-label="Viber"
          class="flex min-h-touch min-w-touch items-center justify-center transition-colors hover:text-white md:min-h-0 md:min-w-0"
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="M12 3.5c-4.4 0-8 2.6-8 7.2 0 2.4 1 4.3 2.6 5.5v3.8l3.1-2.2c.7.1 1.5.2 2.3.2 4.4 0 8-2.6 8-7.3S16.4 3.5 12 3.5Z"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linejoin="round"
            ></path>
            <path
              d="M9.4 8.3c.3-.3.8-.3 1 0l.9 1.2c.2.3.2.7-.1.9l-.5.5c.5 1 1.3 1.8 2.3 2.3l.5-.5c.3-.3.7-.3.9-.1l1.2.9c.3.2.3.7 0 1l-.6.6c-.5.5-1.3.6-2 .3-2-.9-3.6-2.5-4.5-4.5-.3-.7-.2-1.5.3-2l.6-.6Z"
              stroke="currentColor"
              stroke-width="1.2"
              stroke-linejoin="round"
            ></path>
          </svg>
        </a>
      </div>
    </div>
  </Container>
</footer>
