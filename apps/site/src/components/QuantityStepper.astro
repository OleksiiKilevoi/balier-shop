---
/**
 * −/value/+ control. Self-contained: it clamps its own value and announces
 * changes with a bubbling `quantity:change`, so the product page (and the cart
 * page in Phase 3) only has to listen.
 *
 * `max` is set by the caller and may be rewritten at runtime when the chosen
 * variant has a different amount available.
 */
interface Props {
  max: number;
  name?: string;
  class?: string;
}

const { max, name = 'quantity', class: className } = Astro.props;
---

<div
  class:list={[
    'border-line-strong rounded-btn inline-flex items-center border bg-white',
    className,
  ]}
  data-stepper
>
  <button
    type="button"
    data-step="-1"
    class="text-ink-soft hover:text-brand flex size-touch items-center justify-center transition-colors disabled:opacity-40 md:size-10 cursor-pointer"
    aria-label="Зменшити кількість"
  >
    <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
      <path d="M2 7h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
    </svg>
  </button>

  {/* text-base until md: under 16px iOS Safari zooms the viewport on focus and
      never zooms back — and this is the field right above the buy button. */}
  <input
    type="number"
    name={name}
    value="1"
    min="1"
    max={max}
    step="1"
    inputmode="numeric"
    autocomplete="off"
    data-quantity
    aria-label="Кількість"
    class="text-ink w-10 border-0 bg-transparent p-0 text-center text-base font-medium tabular-nums outline-none md:text-sm"
  />

  <button
    type="button"
    data-step="1"
    class="text-ink-soft hover:text-brand flex size-touch items-center justify-center transition-colors disabled:opacity-40 md:size-10 cursor-pointer"
    aria-label="Збільшити кількість"
  >
    <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
      <path d="M7 2v10M2 7h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
      ></path>
    </svg>
  </button>
</div>

<style>
  /* The native spinners fight the −/+ buttons for the same job and make the
     field wider than the mockup on desktop. */
  input[type='number'] {
    appearance: textfield;
  }

  input[type='number']::-webkit-outer-spin-button,
  input[type='number']::-webkit-inner-spin-button {
    appearance: none;
    margin: 0;
  }
</style>

<script>
  /**
   * Delegated from `document` rather than bound per element.
   *
   * The cart page clones its rows — steppers included — out of a `<template>`
   * after this module has run, and a per-element binding would leave every one
   * of those dead with nothing to show for it. Delegation costs three listeners
   * for the whole document and works the same for markup that arrives later.
   */

  /**
   * The single way the value changes. Deliberately dispatches a custom event
   * rather than `change`: re-dispatching the event we also listen for would loop.
   */
  const setValue = (stepper: HTMLElement, input: HTMLInputElement, next: number) => {
    const max = Math.max(Number(input.max) || 1, 1);
    const value = Math.min(Math.max(Math.round(next) || 1, 1), max);

    input.value = String(value);
    stepper.dispatchEvent(new CustomEvent('quantity:change', { bubbles: true, detail: { value } }));
  };

  /** The stepper and its field, from anywhere inside one. */
  const parts = (node: EventTarget | null) => {
    if (!(node instanceof Element)) return null;

    const stepper = node.closest<HTMLElement>('[data-stepper]');
    const input = stepper?.querySelector<HTMLInputElement>('input[data-quantity]');
    return stepper && input ? { stepper, input } : null;
  };

  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element)) return;

    const button = event.target.closest<HTMLButtonElement>('[data-stepper] button[data-step]');
    const found = button && parts(button);
    if (!button || !found) return;

    setValue(found.stepper, found.input, Number(found.input.value) + Number(button.dataset.step));
  });

  // `change` alone misses a typed value that is never blurred on mobile, where
  // the keyboard is dismissed rather than the field left. `blur` does not bubble,
  // so delegation listens for its bubbling counterpart.
  const reclamp = (event: Event) => {
    if (!(event.target instanceof HTMLInputElement) || !event.target.matches('[data-quantity]')) {
      return;
    }

    const found = parts(event.target);
    if (found) setValue(found.stepper, found.input, Number(found.input.value));
  };

  document.addEventListener('change', reclamp);
  document.addEventListener('focusout', reclamp);
</script>
