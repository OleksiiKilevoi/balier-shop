---
import type { CategoryNavItem } from '@balier/lib/db/queries/categories';

/**
 * Category navigation for the catalog pages. A sidebar list from `lg` up; below
 * it a grid of three tiles per row, every category visible at once (owner,
 * 2026-09-27 — the old scrolling chip row hid most of them off the edge).
 *
 * The same `<ul>` serves both: only the utility classes change per
 * breakpoint, so there is one markup, one set of links, one `aria-current`.
 */
interface Props {
  categories: CategoryNavItem[];
  /** The category page's slug; `null` on `/products` («Усі товари»). */
  current: string | null;
  /** All active products, for the «Усі товари» count. */
  total: number;
  class?: string;
}

const { categories, current, total, class: className } = Astro.props;

const items = [
  { href: '/products', label: 'Усі товари', count: total, active: current === null },
  ...categories.map((category) => ({
    href: `/products/category/${category.slug}`,
    label: category.title,
    count: category.productCount,
    active: category.slug === current,
  })),
];
---

<nav aria-label="Категорії" class:list={[className]}>
  <ul class="grid grid-cols-3 gap-2 text-xs sm:text-sm lg:flex lg:flex-col lg:gap-0.5">
    {
      items.map((item) => (
        <li class="min-w-0">
          <a
            href={item.href}
            aria-current={item.active ? 'page' : undefined}
            class="group border-line bg-paper-raised text-ink-soft hover:border-line-strong hover:text-ink aria-[current=page]:border-ink aria-[current=page]:bg-ink lg:hover:bg-tag lg:aria-[current=page]:border-transparent lg:aria-[current=page]:bg-tag lg:aria-[current=page]:text-ink rounded-btn flex h-full min-h-touch flex-col items-center justify-center gap-0.5 border px-2 py-2 text-center leading-tight transition-colors aria-[current=page]:font-medium aria-[current=page]:text-white lg:min-h-0 lg:w-full lg:flex-row lg:justify-between lg:gap-2 lg:border-transparent lg:bg-transparent lg:px-3 lg:py-2 lg:text-left"
          >
            {/* The label wraps — in a tile and in the sidebar alike — so a long
                name never pushes its count out. */}
            <span class="min-w-0">{item.label}</span>
            <span class="text-ink-muted shrink-0 group-aria-[current=page]:text-white/80 lg:group-aria-[current=page]:text-ink-muted text-xs tabular-nums">
              {item.count}
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>
