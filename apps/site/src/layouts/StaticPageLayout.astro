---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Container from '~/components/Container.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';

/**
 * The frame every hand-written content page shares: `/about`, `/care`,
 * `/delivery`, `/returns`, `/contacts` and the two legal pages.
 *
 * Only the frame lives here. The copy is plain markup in the page's slot and is
 * styled by the `prose-page` utility in `global.css`, so writing a page means
 * writing headings and paragraphs, not classes.
 *
 * Every page using this frame sets `prerender = true` — they are the only routes
 * in the app that are. Nothing on them is per-request: no DB, no `env`, no
 * cookies, and the header's active-nav and the canonical URL both derive from the
 * page's own path, which is known at build time. So they are built to
 * `dist/client/<path>/index.html` and served straight off the ASSETS binding,
 * without waking the Worker at all.
 *
 * The cost is that their HTML is frozen until the next deploy. That is fine for
 * copy, but note two things it freezes: `SITE_IS_INDEXABLE` in `BaseLayout` (the
 * Phase 5 flip needs a rebuild, which a deploy does anyway) and the footer's
 * `new Date().getFullYear()`, which will lag the SSR pages after a New Year until
 * something is deployed.
 */
interface Props {
  /** Also the `<h1>` and the last breadcrumb. */
  title: string;
  /** One sentence under the heading. Doubles as the meta description. */
  lead?: string;
  /** Override when the meta description should differ from the lead. */
  description?: string;
}

const { title, lead, description = lead } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <Container class="py-8 sm:py-12">
    <Breadcrumbs class="flex justify-center" items={[{ label: 'Головна', href: '/' }, { label: title }]} />

    {/* Capped to the same measure as the body copy so the heading breaks with
        it instead of running the full 82rem gutter on a desktop. The whole
        column sits in the middle of the page; the copy itself stays
        left-aligned inside it, only the title block is centred. */}
    <header class="mx-auto mt-5 max-w-[65ch] text-center sm:mt-6">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl">{title}</h1>
      {lead && <p class="text-ink-muted mt-3">{lead}</p>}
    </header>

    <div class="prose-page mx-auto mt-8">
      <slot />
    </div>
  </Container>
</BaseLayout>
