---
import { Font } from 'astro:assets';
import SiteHeader from '~/components/SiteHeader.astro';
import SiteFooter from '~/components/SiteFooter.astro';
import CartPopup from '~/components/CartPopup.astro';
import '~/styles/global.css';

/**
 * Pre-launch: every page is `noindex, nofollow`.
 *
 * The store is reachable at a public workers.dev URL while the catalog, the
 * checkout and the legal pages do not exist yet, and none of that should end up
 * in an index — a page pulled out of the index later still leaves a stale cached
 * copy behind. Flipping this to `true` is a Phase 5 launch step; see roadmap.md.
 *
 * Deliberately NOT paired with `Disallow` in robots.txt: a blocked crawler never
 * fetches the page, so it never sees this tag, and the URL can still be indexed
 * from external links. Allow the crawl, refuse the index.
 */
const SITE_IS_INDEXABLE = false;

interface Props {
  title: string;
  description?: string;
  /** Absolute or site-relative image for social cards. */
  ogImage?: string;
  /** Per-page override. Defaults to the site-wide setting above. */
  noindex?: boolean;
}

const { title, description, ogImage, noindex = !SITE_IS_INDEXABLE } = Astro.props;

const siteName = 'Balier';
const fullTitle = title === siteName ? title : `${title} — ${siteName}`;
// Without the trim, the prerendered pages and the SSR ones disagree: a built
// page's own pathname is the directory form it is emitted as (`/about/`), while
// the same route rendered per request sees `/about`. One route must advertise one
// canonical URL, and the no-slash form is the one every link on the site uses.
const path = Astro.url.pathname.replace(/(.)\/$/, '$1');
const canonical = new URL(path, Astro.site ?? Astro.url).href;
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site ?? Astro.url).href : undefined;
---

<html lang="uk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />

    {/* Only the display face is preloaded — it paints the LCP heading. Body
        text has a metric-matched fallback, so preloading Inter's three weights
        would compete with the hero for bandwidth without moving first paint. */}
    <Font cssVariable="--font-playfair" preload />
    <Font cssVariable="--font-inter" />

    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="uk_UA" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:url" content={canonical} />
    {description && <meta property="og:description" content={description} />}
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    <meta name="twitter:card" content="summary_large_image" />

    <slot name="head" />
  </head>

  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="bg-ink text-paper sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:px-4 focus:py-2"
    >
      Перейти до вмісту
    </a>

    <SiteHeader />

    <main id="main" class="flex-1">
      <slot />
    </main>

    <SiteFooter />
    <CartPopup />
  </body>
</html>
