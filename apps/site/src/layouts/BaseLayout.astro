---
import { Font } from 'astro:assets';
import SiteHeader from '~/components/SiteHeader.astro';
import SiteFooter from '~/components/SiteFooter.astro';
import CartPopup from '~/components/CartPopup.astro';
import PromoPopup from '~/components/PromoPopup.astro';
import { clampDescription, pageTitle } from '@balier/lib/seo';
import '~/styles/global.css';

/**
 * Flipped to `true` 2026-09-18 (launch L6): the catalog, checkout and legal
 * pages are live on balier.com.ua with the production Monobank merchant. Before
 * that every page was `noindex, nofollow` so nothing half-built could be cached
 * by an index. Pages that must never be indexed (cart, checkout, search, 404)
 * pass `noindex` themselves.
 *
 * Deliberately NOT paired with `Disallow` in robots.txt: a blocked crawler never
 * fetches the page, so it never sees this tag, and the URL can still be indexed
 * from external links. Allow the crawl, refuse the index.
 */
const SITE_IS_INDEXABLE = true;

interface Props {
  title: string;
  description?: string;
  /** Absolute or site-relative image for social cards. */
  ogImage?: string;
  /** Per-page override. Defaults to the site-wide setting above. */
  noindex?: boolean;
}

const { title, ogImage, noindex = !SITE_IS_INDEXABLE } = Astro.props;

const siteName = 'Balier';
const GTAG_IDS = [GA4_MEASUREMENT_ID, GOOGLE_ADS_ID].filter(Boolean);
// Shaped to what a search result shows: the brand suffix is skipped when the
// title names it or would overflow, the description is cut at a sentence.
const fullTitle = pageTitle(title);
const description = clampDescription(Astro.props.description);
// Without the trim, the prerendered pages and the SSR ones disagree: a built
// page's own pathname is the file it is emitted as (`/about.html` under
// `build.format: 'file'`, `/about/` under the directory format), while the same
// route rendered per request sees `/about`. One route must advertise one
// canonical URL, and the bare form is the one every link on the site uses.
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/(.)\/$/, '$1');
const canonical = new URL(path, Astro.site ?? Astro.url).href;
// Every page gets a share image: the page's own, or the brand's python leather.
const ogImageUrl = new URL(ogImage ?? '/images/og-default.jpg', Astro.site ?? Astro.url).href;
import { GOOGLE_ADS_ID } from '~/lib/googleAds';
import { GTM_ID } from '~/lib/googleTagManager';
import { GA4_MEASUREMENT_ID } from '~/lib/googleAnalytics';
---

<html lang="uk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/* Google Tag Manager — Google's snippet verbatim, the container ID from
        `~/lib/googleTagManager.ts`. As high in <head> as Google asks; its
        <noscript> half sits right after <body>. Production only. */}
    {import.meta.env.PROD && GTM_ID && (
      <script is:inline define:vars={{ id: GTM_ID }}>
        (function (w, d, s, l, i) {
          w[l] = w[l] || [];
          w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
          var f = d.getElementsByTagName(s)[0],
            j = d.createElement(s),
            dl = l != 'dataLayer' ? '&l=' + l : '';
          j.async = true;
          j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
          f.parentNode.insertBefore(j, f);
        })(window, document, 'script', 'dataLayer', id);
      </script>
    )}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />

    {/* Only the display face is preloaded — it paints the LCP heading. Body
        text has a metric-matched fallback, so preloading Inter's three weights
        would compete with the hero for bandwidth without moving first paint. */}
    <Font cssVariable="--font-cormorant" preload />
    <Font cssVariable="--font-source-sans" preload />

    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="uk_UA" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:url" content={canonical} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />

    {/* One Dollar Stats, added 2026-09-18 on request. Production builds only
        (`import.meta.env.PROD`), so `pnpm dev` and preview runs never count as
        visits. `is:inline` keeps Astro from bundling it. */}
    {import.meta.env.PROD && (
      <script is:inline defer src="https://assets.onedollarstats.com/stonks.js"></script>
    )}

    {/* gtag.js, loaded once for every ID that is set: GA4 from
        `~/lib/googleAnalytics.ts` and Google Ads from `~/lib/googleAds.ts`.
        Production only. The Ads purchase event fires from /checkout/success
        through the same `window.gtag`. */}
    {import.meta.env.PROD && GTAG_IDS.length > 0 && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GTAG_IDS[0]}`}></script>
        <script is:inline define:vars={{ ids: GTAG_IDS }}>
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () {
            window.dataLayer.push(arguments);
          };
          window.gtag('js', new Date());
          for (const id of ids) window.gtag('config', id);
        </script>
      </>
    )}

    <slot name="head" />
  </head>

  <body class="flex min-h-dvh flex-col">
    {import.meta.env.PROD && GTM_ID && (
      <noscript>
        <iframe
          src={`https://www.googletagmanager.com/ns.html?id=${GTM_ID}`}
          height="0"
          width="0"
          style="display:none;visibility:hidden"></iframe>
      </noscript>
    )}
    <a
      href="#main"
      class="bg-ink text-paper sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:px-4 focus:py-2"
    >
      Перейти до вмісту
    </a>

    <SiteHeader />

    <main id="main" class="flex-1">
      <slot />
    </main>

    <SiteFooter />
    <CartPopup />
    <PromoPopup />

    <script>
      // Where this visitor came from, for the order (`~/attribution.ts`).
      // Every page, so a landing on any of them counts; storage failures
      // (private mode, blocked site data) just mean an order without a source.
      import { ATTRIBUTION_STORAGE_KEY, nextAttribution, type Attribution } from '@balier/lib/attribution';

      try {
        const raw = localStorage.getItem(ATTRIBUTION_STORAGE_KEY);
        const stored = raw ? (JSON.parse(raw) as Attribution) : null;
        const next = nextAttribution(stored, {
          search: location.search,
          referrer: document.referrer,
          path: location.pathname,
          ownHost: location.hostname,
          now: new Date(),
        });
        if (next && next !== stored) localStorage.setItem(ATTRIBUTION_STORAGE_KEY, JSON.stringify(next));
      } catch {
        /* no storage — no source on the order, nothing else changes */
      }
    </script>
  </body>
</html>
