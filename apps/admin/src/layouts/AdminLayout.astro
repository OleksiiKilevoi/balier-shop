---
import { Font } from 'astro:assets';

import ThemeToggle from '~/components/ThemeToggle.astro';

import '~/styles/admin.css';

/**
 * Shell for `/**`. Deliberately not `BaseLayout` — the storefront header,
 * footer and cart popup have no place in the panel, and the admin pages must not
 * inherit the shop chrome as it changes.
 *
 * That separation is total: the panel loads `admin.css` and Geist, and the
 * storefront loads `global.css` with Playfair and Inter — no token, no font and
 * no component crosses between them, and no page loads both sides. `Container`
 * is not imported for the same reason — its `container-page` utility lives in
 * `global.css`; the panel has `admin-container`.
 *
 * Every route on this Worker is gated by `src/middleware.ts`, so the signed-in
 * identity is present on every screen except the login form itself — which is
 * what `bare` below is for. `noindex` is belt-and-braces on top of that.
 *
 * The theme switch below is the reason the old "no script at all" property no
 * longer holds: a chosen theme has to be remembered across requests, and nothing
 * but `localStorage` remembers it. It is one inline script — no framework, no
 * hydration, no extra request — so the panel still ships no JavaScript assets,
 * and every other page here is still plain forms and links. With JavaScript off
 * the switch hides itself and the panel follows the operating system exactly as
 * it did before. The same script also dismisses the burger menu on an outside
 * click or Escape, which is a courtesy on top of a menu that is a `<details>`
 * and therefore opens and closes without it.
 */

interface Props {
  title: string;
  /**
   * The login screen. Drops the section nav, the signed-in address and the
   * sign-out button — none of them mean anything before there is a session, and
   * a nav that bounces every link back to this page is worse than no nav. The
   * theme switch stays: it is a browser preference, not an admin one.
   */
  bare?: boolean;
}

const { title, bare = false } = Astro.props;
const admin = Astro.locals.admin;

/** The one business-specific string in the panel. Change it, and nothing else. */
const PANEL_NAME = 'Balier';

/**
 * Three rows for a manager, four for an admin.
 *
 * `/categories` is deliberately not one of them and is reached from the product
 * list instead: a fourth item starts wrapping this header onto a second line on
 * a narrow laptop, and categories are opened far less often than anything here.
 * «Користувачі» takes that fourth slot for admins only, which is what keeps the
 * budget: the role that sees four items is the smaller one, the manager's
 * header is unchanged, and the screen refuses a manager anyway — a nav item
 * everyone can see and only some can use is worse than one that is not there.
 * The burger below takes the phone off this budget entirely, since the nav is a
 * stacked list there.
 *
 * The role comes from the live row the gate read, never from the cookie, for
 * the same reason `/users` re-reads it: a demotion has to take the link away on
 * the next request, not at the end of the day.
 */
const NAV = [
  { href: '/orders', label: 'Замовлення' },
  { href: '/customers', label: 'Клієнти' },
  { href: '/products', label: 'Товари' },
  ...(Astro.locals.adminUser?.role === 'admin'
    ? [{ href: '/users', label: 'Користувачі' }]
    : []),
  { href: '/settings', label: 'Налаштування' },
];

const pathname = Astro.url.pathname;
---

<html lang="uk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {/* Paints the browser UI to match before the page does. The media queries
        are the no-JavaScript default; the script below re-points them at the
        chosen theme, which is why each carries the scheme it stands for. */}
    <meta name="theme-color" data-scheme="light" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" data-scheme="dark" content="#09090b" media="(prefers-color-scheme: dark)" />
    <title>{title} — {PANEL_NAME} admin</title>

    {/* The panel's one face. Downloaded and self-hosted at build time by Astro's
        font pipeline (see `astro.config.mjs`), so there is no request to Google
        and no third party in front of a signed-in screen. Preloaded because it
        is the only font here — every character on the page waits on it. */}
    <Font cssVariable="--font-geist" preload />

    {/* Inline and blocking on purpose: the stored theme has to be on <html>
        before the first paint, or the page shows the other one and then jumps.
        `is:inline` keeps Astro from turning it into a deferred module, which
        would defeat exactly that. The fade itself lives in `admin.css`. */}
    <script is:inline>
      (() => {
        const KEY = 'admin-theme';
        /** Two states, and that is the whole switch. */
        const NAMES = { light: 'світла', dark: 'темна' };

        const root = document.documentElement;
        const themeColors = document.querySelectorAll('meta[name="theme-color"][data-scheme]');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)');

        /** Storage throws when the browser blocks it; then the panel simply forgets. */
        const chosen = () => {
          try {
            const stored = localStorage.getItem(KEY);
            return stored === 'light' || stored === 'dark' ? stored : null;
          } catch {
            return null;
          }
        };

        /**
         * Until somebody picks a side, the operating system picks it for them —
         * so a first visit still lands on the right theme without the switch
         * having to carry a third state for it.
         */
        const read = () => chosen() || (prefersDark.matches ? 'dark' : 'light');

        const apply = (mode) => {
          root.dataset.theme = mode;
          // Keep the mobile browser chrome in step: exactly one meta applies.
          for (const meta of themeColors) {
            meta.setAttribute(
              'media',
              meta.getAttribute('data-scheme') === mode ? 'all' : 'not all',
            );
          }
        };

        apply(read());

        document.addEventListener('DOMContentLoaded', () => {
          // The burger menu closes itself when something else is clicked or
          // Escape is pressed. `<details>` does neither on its own, and a panel
          // that stays open over the page after a stray tap reads as stuck.
          const menu = document.querySelector('.admin-menu');
          if (menu) {
            document.addEventListener('click', (event) => {
              if (menu.open && !menu.contains(event.target)) menu.open = false;
            });

            document.addEventListener('keydown', (event) => {
              if (event.key !== 'Escape' || !menu.open) return;
              menu.open = false;
              menu.querySelector('summary')?.focus();
            });
          }

          // Two of them on a signed-in page — the header cluster and the menu —
          // and one on the login screen. All the same control, so all bound.
          const toggles = document.querySelectorAll('.admin-theme-toggle');
          if (!toggles.length) return;

          // The icon is CSS's job (it reads the same `data-theme`); the name the
          // control announces is this one's, and has to say where it stands now.
          const label = (mode) => {
            for (const toggle of toggles) {
              toggle.setAttribute('title', 'Тема: ' + NAMES[mode]);
              toggle.setAttribute('aria-label', 'Перемкнути тему. Зараз: ' + NAMES[mode]);
            }
          };
          label(read());

          const still = window.matchMedia('(prefers-reduced-motion: reduce)');

          // The cross-fade is the browser's, driven by the timing in `admin.css`.
          // Anything that cannot do it — an older browser, or an operator who has
          // asked for less motion — simply gets the swap.
          const change = (mode) => {
            const swap = () => {
              apply(mode);
              label(mode);
            };

            if (document.startViewTransition && !still.matches) {
              document.startViewTransition(swap);
            } else {
              swap();
            }
          };

          // Nothing chosen yet means the operating system is still deciding, so
          // it keeps deciding live, as the panel behaved before the switch
          // existed. The first click ends that for this browser.
          prefersDark.addEventListener('change', () => {
            if (chosen()) return;
            change(prefersDark.matches ? 'dark' : 'light');
          });

          for (const toggle of toggles) {
            toggle.addEventListener('click', () => {
              const next = read() === 'dark' ? 'light' : 'dark';
              try {
                localStorage.setItem(KEY, next);
              } catch {
                /* Not remembered, but the switch still works for this page. */
              }

              change(next);
            });
          }
        });
      })();
    </script>
  </head>

  <body class="flex min-h-dvh flex-col">
    {/* Sticky: the panel's screens are long, and the section switch should not
        require scrolling back to the top of a 40-row order list. */}
    <header class="border-border bg-canvas/85 sticky top-0 z-10 border-b backdrop-blur">
      <div class="admin-container flex min-h-touch flex-wrap items-center gap-x-6 gap-y-2 py-3">
        <a href="/" class="text-fg text-[0.9375rem] font-semibold tracking-tight">
          {PANEL_NAME}<span class="text-fg-subtle font-normal"> / адмін</span>
        </a>

        {/* Hidden on a phone, where the same links are stacked inside the menu
            below. Two navs would be two tab stops over the same destinations,
            so exactly one of them is ever in the layout. */}
        {
          !bare && (
            <nav aria-label="Розділи" class="hidden sm:block">
              <ul class="flex gap-1">
                {NAV.map((item) => {
                  const active = pathname.startsWith(item.href);
                  return (
                    <li>
                      <a
                        href={item.href}
                        aria-current={active ? 'page' : undefined}
                        class:list={[
                          'admin-badge min-h-8 px-3 text-sm',
                          active
                            ? 'bg-accent text-accent-fg'
                            : 'text-fg-muted hover:bg-surface-hover hover:text-fg',
                        ]}
                      >
                        {item.label}
                      </a>
                    </li>
                  );
                })}
              </ul>
            </nav>
          )
        }

        <div class="ml-auto flex min-w-0 items-center gap-3">
          {/* The login screen has nothing to put in a menu — no nav, no address,
              no session to end — so its theme switch stays in the header at every
              width and no burger is drawn at all. */}
          {bare && <ThemeToggle />}

          {
            !bare && (
              <>
                {/* The wide-screen cluster. `hidden` sits on this wrapper rather
                    than on the controls, so it cannot collide with the `display`
                    that `admin-icon-btn` sets on them. */}
                <div class="hidden min-w-0 items-center gap-3 sm:flex">
                  {admin && <span class="text-fg-subtle truncate text-xs">{admin.email}</span>}

                  <ThemeToggle />

                  {/* A form, not a link: `GET /logout` would be followed by
                      any prefetcher that saw it, and would sign the operator out
                      at random. As a POST it also picks up Astro's origin check
                      for free. */}
                  {admin && (
                    <form method="post" action="/logout">
                      <button
                        type="submit"
                        class="admin-icon-btn"
                        aria-label="Вийти з панелі"
                        title="Вийти"
                      >
                        <svg
                          width="16"
                          height="16"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.6"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                        >
                          <path d="M15 4h3a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-3" />
                          <path d="M10 8l-4 4 4 4M6 12h9" />
                        </svg>
                      </button>
                    </form>
                  )}
                </div>

                {/* The phone's copy of all of it. A `<details>`, so it opens and
                    closes with no script at all — the same bargain the rest of
                    the panel takes — and the script only adds the dismissals a
                    `<details>` has no opinion about. Styled in `admin.css`. */}
                <details class="admin-menu sm:hidden">
                  <summary aria-label="Меню панелі">
                    <svg
                      data-menu="open"
                      width="20"
                      height="20"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.6"
                      stroke-linecap="round"
                      aria-hidden="true"
                    >
                      <path d="M4 7h16M4 12h16M4 17h16" />
                    </svg>

                    <svg
                      data-menu="close"
                      width="20"
                      height="20"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.6"
                      stroke-linecap="round"
                      aria-hidden="true"
                    >
                      <path d="m6 6 12 12M18 6 6 18" />
                    </svg>
                  </summary>

                  <div class="admin-menu-panel">
                    <nav aria-label="Розділи">
                      <ul>
                        {NAV.map((item) => {
                          const active = pathname.startsWith(item.href);
                          return (
                            <li>
                              <a
                                href={item.href}
                                aria-current={active ? 'page' : undefined}
                                class:list={['admin-menu-link', active && 'is-active']}
                              >
                                {item.label}
                              </a>
                            </li>
                          );
                        })}
                      </ul>
                    </nav>

                    <div class="border-border mt-2 border-t pt-2">
                      {admin && (
                        <p class="text-fg-subtle truncate px-3 py-1 text-xs">{admin.email}</p>
                      )}

                      <div class="mt-1 flex items-center gap-2">
                        <ThemeToggle />

                        {admin && (
                          <form method="post" action="/logout" class="flex-1">
                            <button
                              type="submit"
                              class="admin-btn admin-btn-secondary w-full px-4"
                            >
                              Вийти
                            </button>
                          </form>
                        )}
                      </div>
                    </div>
                  </div>
                </details>
              </>
            )
          }
        </div>
      </div>
    </header>

    <main class="flex-1 py-8 sm:py-10">
      <div class="admin-container">
        <slot />
      </div>
    </main>
  </body>
</html>
