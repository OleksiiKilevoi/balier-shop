---
import type { OrderStatus } from '@balier/lib/db/schema';
import { ORDER_STATUS_LABELS } from '@balier/lib/i18n/admin';

/**
 * The order's status, scannable down a list.
 *
 * The tones come from `admin.css` and are named for what the row means to the
 * operator rather than for a colour, so the mapping below reads as a sentence:
 * money in, waiting on someone, moving, done, dead. Nothing here holds a colour
 * value — re-theming the panel is a change to `admin.css` alone.
 */

interface Props {
  status: OrderStatus;
  class?: string;
}

const { status, class: className } = Astro.props;

const TONES: Record<OrderStatus, string> = {
  // Money has actually arrived, or the order is otherwise confirmed.
  paid: 'admin-tone-positive',
  confirmed: 'admin-tone-positive',
  // Waiting on the customer.
  pending: 'admin-tone-attention',
  awaiting_payment: 'admin-tone-attention',
  // Waiting on us, or on the carrier.
  packed: 'admin-tone-progress',
  shipped: 'admin-tone-progress',
  // Finished.
  delivered: 'admin-tone-neutral',
  // Dead ends.
  cancelled: 'admin-tone-negative',
  refunded: 'admin-tone-negative',
};
---

<span class:list={['admin-badge', TONES[status], className]}>
  {ORDER_STATUS_LABELS[status]}
</span>
