---
/**
 * The theme switch, in both of the places the panel shows it: the header row on
 * a wide screen, and the burger menu on a narrow one.
 *
 * It is rendered twice rather than moved, because nothing can move an element
 * between two layouts — which is why the script in `AdminLayout` binds every
 * `.admin-theme-toggle` on the page instead of one id, and why this markup lives
 * in a component rather than being copied.
 *
 * Both icons ship and CSS shows the one matching `data-theme`, so the control is
 * correct in the first paint rather than after a script has had a chance to
 * touch it. `aria-label` is replaced on load with one naming the current mode;
 * what is written here is the pre-script fallback.
 */
---

<button type="button" class="admin-theme-toggle admin-icon-btn" aria-label="Перемкнути тему">
  <svg
    data-mode="light"
    width="16"
    height="16"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
    ></path>
  </svg>

  <svg
    data-mode="dark"
    width="16"
    height="16"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
  </svg>
</button>
