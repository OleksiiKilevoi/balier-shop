                reaches the server with the script running. */}
            <form
              method="post"
              action={selfUrl}
              enctype="multipart/form-data"
              data-form="image-add"
              class="border-border rounded-card mt-4 border p-4"
            >
              <input type="hidden" name="intent" value="image_add" />

              <div class="flex flex-wrap items-end gap-3">
                <div class="w-full sm:w-auto sm:flex-1">
                  <label for="file" class="text-fg-subtle text-xs">Файл</label>
                  <input
                    id="file"
                    name="file"
                    type="file"
                    accept="image/webp,image/avif,image/jpeg,image/png"
