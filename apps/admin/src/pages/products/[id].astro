                    class="h-4 w-4 shrink-0"
                    viewBox="0 0 16 16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="m4 6 4 4 4-4" />
                  </svg>
                </summary>
                <div class="mt-3">
                  <label for="metaTitle" class="text-fg-subtle text-xs">Заголовок</label>
                  <input
                    id="metaTitle"
                    name="metaTitle"
                    type="text"
                    value={redraw('product_save', 'metaTitle', detail.translation?.metaTitle)}
                    maxlength={200}
                    autocomplete="off"
                    class:list={['admin-field mt-1', invalid.has('metaTitle') && 'border-danger']}
                  />
                  <p class="text-fg-subtle mt-1 text-xs">Порожньо — береться назва товару.</p>
                </div>
                <div class="mt-3">
                  <label for="metaDescription" class="text-fg-subtle text-xs">Опис</label>
                  <textarea
                    id="metaDescription"
                    name="metaDescription"
                    rows="2"
                    maxlength={300}
                    class:list={[
                      'admin-field admin-textarea mt-1',
                      invalid.has('metaDescription') && 'border-danger',
                    ]}
                    set:text={redraw(
                      'product_save',
                      'metaDescription',
                      detail.translation?.metaDescription,
                    )}
                  />
                </div>
              </details>

              <div class="mt-6">
                <button type="submit" class="admin-btn admin-btn-primary">Зберегти</button>
              </div>
            </form>
          </section>

          {/* ----------------------------------------------------- варіанти --- */}
          <section class="admin-card mt-6 p-5">
            <h2 class="text-fg text-base font-semibold">Варіанти</h2>
            <p class="text-fg-muted mt-1 text-sm">
              Кожен варіант має свій артикул і власну наявність. Товар без кольорів — це один
              варіант із порожньою назвою кольору.
            </p>

            <ul class="mt-4 space-y-3">
              {variants.map((variant) => (
                <li
                  class:list={[
                    'border-border rounded-card border p-4',
                    !variant.isActive && 'opacity-40',
                    variantRowFailed(variant.id) && 'border-danger',
                  ]}
                >
                  <form method="post" action={selfUrl} data-form={`variant:${variant.id}`}>
                    <input type="hidden" name="intent" value="variant_save" />
                    <input type="hidden" name="variantId" value={variant.id} />

                    <div class="flex flex-wrap gap-3">
                      <div class="w-full sm:w-52">
                        <label for={`sku-${variant.id}`} class="text-fg-subtle text-xs">
                          Артикул
                        </label>
                        <input
                          id={`sku-${variant.id}`}
                          name="sku"
                          type="text"
