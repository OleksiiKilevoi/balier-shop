                </button>
              </div>

              {uploadIssue && (
                <p role="alert" class="text-danger mt-2 text-xs">
                  {ADMIN_UPLOAD_ERRORS[uploadIssue]}
                </p>
              )}
            </form>

            {images.length > 0 && (
              <ul class="mt-4 space-y-3">
                {images.map((image, index) => (
                  <li class="border-border rounded-card border p-4">
                    {/* Only the identity of the photo sits beside the thumbnail —
                        a name tag, and it is all that column is wide enough for.
                        The fields and the buttons below get the row's full width
                        at every size, which on a phone is the difference between
                        a 108px column that the danger button hangs out of and a
                        form that fits. */}
                    <div class="flex items-start gap-4">
                      <span class="bg-surface-hover border-border h-28 w-21 shrink-0 overflow-hidden rounded-md border">
                        <img
                          src={image.url}
                          alt={image.alt ?? ''}
