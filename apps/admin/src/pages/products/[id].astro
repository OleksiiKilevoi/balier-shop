                      <div class="w-full sm:w-36">
                        <label for={`priceOverride-${variant.id}`} class="text-fg-subtle text-xs">
                          Своя ціна
                        </label>
                        <div class="relative mt-1">
                          <input
                            id={`priceOverride-${variant.id}`}
                            name="priceOverride"
                            type="text"
                            inputmode="numeric"
                            value={redrawVariant(
                              variant.id,
                              'priceOverride',
                              toHryvnias(variant.priceOverride),
