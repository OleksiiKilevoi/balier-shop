                          place up the list, ready for the next press. */}
                      {index > 0 && (
                        <form
                          method="post"
                          action={selfUrl}
                          data-form={`image-up:${image.id}`}
                          class="flex-1 sm:flex-none"
                        >
                          <input type="hidden" name="intent" value="image_move" />
                          <input type="hidden" name="imageId" value={image.id} />
                          <input type="hidden" name="direction" value="up" />
                          <button type="submit" class="admin-btn admin-btn-secondary w-full px-4 sm:w-auto sm:px-6">
                            Вище
                          </button>
                        </form>
                      )}
                      {index < images.length - 1 && (
                        <form
                          method="post"
                          action={selfUrl}
                          data-form={`image-down:${image.id}`}
                          class="flex-1 sm:flex-none"
                        >
                          <input type="hidden" name="intent" value="image_move" />
                          <input type="hidden" name="imageId" value={image.id} />
                          <input type="hidden" name="direction" value="down" />
                          <button type="submit" class="admin-btn admin-btn-secondary w-full px-4 sm:w-auto sm:px-6">
                            Нижче
                          </button>
                        </form>
                      )}

                      {/* The one control here that destroys a row rather than
                          editing one — outlined red, and the only thing between
                          it and the click is that it sits apart from the two
                          above. On a phone that separation is the line break the
                          `basis-full` forces, rather than the gap. Unlike the
                          order screen's exits it is not behind a disclosure yet. */}
                      <form
                        method="post"
                        action={selfUrl}
                        data-form={`image-remove:${image.id}`}
                        class="basis-full sm:basis-auto"
                      >
                        <input type="hidden" name="intent" value="image_remove" />
                        <input type="hidden" name="imageId" value={image.id} />
                        <button type="submit" class="admin-btn admin-btn-danger w-full sm:w-auto">
                          Прибрати фото
                        </button>
                      </form>
                    </div>
                  </li>
                ))}
              </ul>
            )}
          </section>
        </>
      )
    }
  </div>

  {/*
    Empty until script has something to put in it, and hidden the rest of the
    time by having nothing to lay out. Styled in `admin.css`; the message it
    receives is the one rendered above, moved rather than rebuilt.
  */}
  <div id="product-toast" class="admin-toast-host" aria-live="polite" aria-atomic="true"></div>

  {/*
    The enhancement layer lives in `~/lib/forms` and is shared with
    `/categories` — every panel screen made of plain forms gets the same
    swap-in-place and the same toast from it. What stays here is the one thing
    that is only about *this* page: the colour swatches.
  */}
  <script>
    import { enhanceAdminForms } from '@balier/lib/admin/forms';
    import { EXPECTED_HEIGHT, MAX_UPLOAD_BYTES } from '@balier/lib/media/upload';

    const editor = document.getElementById('product-editor');
    const toastHost = document.getElementById('product-toast');

    if (editor && toastHost) {
      /** The only value a swatch can paint — same shape the schema accepts. */
      const HEX = /^#[0-9a-f]{6}$/;

      /*
       * The colour swatches, both directions. Delegated because every save
       * replaces the editor's contents, so a listener bound to a field would be
       * holding a detached node one click later. Nothing is initialised here
       * either — the server renders each swatch already painted, and this only
       * keeps it honest as it is typed in.
       *
       * Neither control is the truth. The text field is what gets submitted;
       * the circle is what gets read. A value that is not a hex paints nothing
       * rather than guessing at one, which is the same answer the server gives.
       */
      editor.addEventListener('input', (event) => {
        const target = event.target;
        if (!(target instanceof HTMLInputElement) || !editor) return;

        // The picker moved: write its answer into the field that is submitted.
        const fieldId = target.dataset.swatchFor;
        if (fieldId !== undefined) {
          const field = document.getElementById(fieldId);
          if (!(field instanceof HTMLInputElement)) return;
          field.value = target.value.toLowerCase();
          paint(target.parentElement, field.value);
          return;
        }

        // Somebody typed a hex: move the circle, and the picker with it, so it
        // opens on the colour that is in the field rather than the last one.
        if (target.dataset.swatchInput === undefined) return;
        const swatch = editor.querySelector(`[data-swatch-for="${CSS.escape(target.id)}"]`);
        if (!(swatch instanceof HTMLInputElement)) return;
        const value = target.value.trim().toLowerCase();
        if (HEX.test(value)) swatch.value = value;
        paint(swatch.parentElement, value);
      });

      // The rest of it — the swap in place, the toast, the focus and the
      // fallback to a real submit — is the same on every screen made of forms.
      enhanceAdminForms({ root: editor, toastHost, messageId: 'editor-message' });

      /*
       * Photos straight off a phone are 3–5 MB and 4000 px; the server takes
       * 1 MB and stores whatever it gets (no resizing there, by decision). So
       * the browser shrinks the file the moment it is picked: long side to
       * EXPECTED_HEIGHT, WebP where the browser can encode it, JPEG otherwise.
       * Anything that fails to decode is left alone and the server's own check
       * says what is wrong. Delegated for the same reason as the swatches.
       */
      editor.addEventListener('change', async (event) => {
        const input = event.target;
        if (!(input instanceof HTMLInputElement) || input.type !== 'file') return;
        const file = input.files?.[0];
        if (!file || !file.type.startsWith('image/')) return;
        const shrunk = await downscale(file);
        if (!shrunk) return;
        const list = new DataTransfer();
        list.items.add(shrunk);
        input.files = list.files;
      });

      /** A smaller copy of `file`, or null when it already fits or cannot be read. */
      async function downscale(file: File): Promise<File | null> {
        try {
          const bitmap = await createImageBitmap(file, { imageOrientation: 'from-image' });
          const longest = Math.max(bitmap.width, bitmap.height);
          if (longest <= EXPECTED_HEIGHT && file.size <= MAX_UPLOAD_BYTES) return null;
          const scale = Math.min(1, EXPECTED_HEIGHT / longest);
          const canvas = document.createElement('canvas');
          canvas.width = Math.round(bitmap.width * scale);
          canvas.height = Math.round(bitmap.height * scale);
          canvas.getContext('2d')?.drawImage(bitmap, 0, 0, canvas.width, canvas.height);
          bitmap.close();
          const encode = (type: string) =>
            new Promise<Blob | null>((resolve) => canvas.toBlob(resolve, type, 0.82));
          let blob = await encode('image/webp');
          let ext = 'webp';
          if (!blob || blob.type !== 'image/webp') {
            blob = await encode('image/jpeg');
            ext = 'jpg';
          }
          if (!blob) return null;
          const stem = file.name.replace(/\.[^.]+$/, '');
          return new File([blob], `${stem}.${ext}`, { type: blob.type });
        } catch {
          return null;
        }
      }

      /** Fills the circle, or marks it empty — `admin.css` draws both states. */
      function paint(swatch: HTMLElement | null, value: string) {
        if (!swatch) return;
        if (HEX.test(value)) {
          swatch.style.setProperty('--swatch', value);
          swatch.removeAttribute('data-empty');
        } else {
          swatch.style.removeProperty('--swatch');
          swatch.setAttribute('data-empty', '');
        }
      }
    }
  </script>
</AdminLayout>
