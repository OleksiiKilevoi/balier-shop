                      </div>
                    </div>

                    <form
                      method="post"
                      action={selfUrl}
                      data-form={`image:${image.id}`}
                      class="mt-4 flex flex-wrap items-end gap-3"
                    >
                      <input type="hidden" name="intent" value="image_save" />
                      <input type="hidden" name="imageId" value={image.id} />

                      <div class="w-full sm:flex-1">
                        <label for={`alt-${image.id}`} class="text-fg-subtle text-xs">
                          Опис
                        </label>
                        <input
                          id={`alt-${image.id}`}
                          name="alt"
                          type="text"
                          value={image.alt ?? ''}
                          maxlength={300}
                          autocomplete="off"
                          class="admin-field mt-1"
                        />
                      </div>

                      <div class="w-full sm:w-44">
                        <label for={`variant-${image.id}`} class="text-fg-subtle text-xs">
                          Належить
                        </label>
                        <div class="relative mt-1">
                          <select
                            id={`variant-${image.id}`}
                            name="variantId"
                            class="admin-field admin-select"
                          >
                            <option value="" selected={image.variantId === null}>
                              Спільне фото
                            </option>
                            {variants.map((variant) => (
                              <option value={variant.id} selected={variant.id === image.variantId}>
                                {variantLabel(variant)}
                              </option>
                            ))}
                          </select>
                          <svg
                            class="text-fg-subtle pointer-events-none absolute top-1/2 right-4 h-4 w-4 -translate-y-1/2"
                            viewBox="0 0 16 16"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                          >
                            <path d="m4 6 4 4 4-4" />
                          </svg>
                        </div>
                      </div>

                      <button
                        type="submit"
                        class="admin-btn admin-btn-secondary w-full shrink-0 sm:w-auto"
                      >
                        Зберегти
                      </button>
                    </form>

                    <div class="mt-3 flex flex-wrap items-center gap-2">
                      {/* Keyed to the photo rather than to the row it is in, so
                          reordering follows the photo: click «Вище» and the
