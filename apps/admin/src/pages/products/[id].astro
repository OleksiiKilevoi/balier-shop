          {/* --------------------------------------------------- зображення --- */}
          <section class="admin-card mt-6 p-5">
            <h2 class="text-fg text-base font-semibold">Зображення</h2>
            <p class="text-fg-muted mt-1 text-sm">{ADMIN_UPLOAD_HINT}</p>

            {/* `FormData` carries the file over `fetch` exactly as the browser
