                <div class="w-full sm:w-48">
                  <label for="new-image-variant" class="text-fg-subtle text-xs">Належить</label>
                  <div class="relative mt-1">
                    <select id="new-image-variant" name="variantId" class="admin-field admin-select">
                      <option value="">Спільне фото</option>
                      {variants.map((variant) => (
                        <option value={variant.id}>{variantLabel(variant)}</option>
                      ))}
                    </select>
                    <svg
                      class="text-fg-subtle pointer-events-none absolute top-1/2 right-4 h-4 w-4 -translate-y-1/2"
                      viewBox="0 0 16 16"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="m4 6 4 4 4-4" />
                    </svg>
                  </div>
                </div>

                <button type="submit" class="admin-btn admin-btn-primary w-full shrink-0 sm:w-auto">
