---
import { env } from 'cloudflare:workers';
import ColorField from '~/components/ColorField.astro';
import ProductStatusBadge from '~/components/ProductStatusBadge.astro';
import AdminLayout from '~/layouts/AdminLayout.astro';
import { createDb, createTxDb } from '@balier/lib/db';
import {
  addProductImage,
  addVariant,
  findAdminProduct,
  findProductIdBySlug,
  listCategoryOptions,
  moveProductImage,
  removeProductImage,
  setVariantActive,
  updateProduct,
  updateProductImage,
  updateVariant,
} from '@balier/lib/db/queries/adminProducts';
import type { CatalogFailure } from '@balier/lib/db/queries/adminProducts';
import { parcelSize, productStatus } from '@balier/lib/db/schema';
import {
  ADMIN_CATALOG_ERRORS,
  ADMIN_PRODUCT_MESSAGES,
  ADMIN_STOREFRONT_NOTES,
  ADMIN_UPLOAD_ERRORS,
  ADMIN_UPLOAD_HINT,
  PARCEL_SIZE_LABELS,
  PRODUCT_STATUS_HINTS,
  PRODUCT_STATUS_LABELS,
  formatAdminDateTime,
  formatFileSize,
} from '@balier/lib/i18n/admin';
import type { AdminProductMessage } from '@balier/lib/i18n/admin';
import { mediaKeyFromUrl, storeImage } from '@balier/lib/media';
import { MAX_REQUEST_BYTES, checkUploadedImage } from '@balier/lib/media/upload';
import type { UploadIssue } from '@balier/lib/media/upload';
import { formatPrice } from '@balier/lib/money';
import { suggestSku } from '@balier/lib/products/slug';
import { catalogFieldErrors, productActionSchema } from '@balier/lib/validation/catalog';
import type { CatalogField } from '@balier/lib/validation/catalog';

/**
 * The product editor — where a product actually gets made.
 *
 * Four independent sections, each its own `<form>` carrying a hidden `intent`,
 * each answered with a 303 back here. Every one of them is a plain form that
 * works with no script at all: the panel's no-script rule is over, but that made
 * script *allowed*, not required.
 *
 * A refusal re-renders with the submitted body instead of redirecting. The
 * settings screen carries one number and can afford to throw it away; this one
 * carries a description somebody wrote.
 *
 * NOTHING BELOW RELOADS THE PAGE. `enhanceAdminForms` from `~/lib/forms`
 * does that for every panel screen made of plain forms, and it changed not a
 * single server-side line here: every submit becomes a `fetch` of the exact POST
 * the browser would have made, `fetch` follows the 303 itself, and what comes
 * back replaces the editor in place. Saving one section therefore no longer
 * discards what is half-typed in another, and the sections stay separate saves
 * because they are separate decisions, not because a reload used to punish them.
 * The answer moves with it, into the fixed toast host at the bottom of this
 * file. Read that module for the whole of how it works.
 */
export const prerender = false;

const productId = Astro.params.id!;
const selfUrl = `/products/${encodeURIComponent(productId)}`;

const db = createDb(env.DATABASE_URL);

// The list links by id, but a storefront URL pasted onto this host arrives
// with the slug — and the uuid column answers that with a 500, not a 404
// (seen 2026-09-16). Resolve a slug to its editor address before anything
// below queries by id; anything else that is not an id is simply not found.
const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
if (!UUID.test(productId)) {
  const id = await findProductIdBySlug(db, productId);
  if (id) return Astro.redirect(`/products/${id}`, 301);
  return new Response('Not found', { status: 404 });
}

/* ------------------------------------------------------------- POST handling */

let invalid = new Set<CatalogField>();
let banner: AdminProductMessage | null = null;
let uploadIssue: UploadIssue | null = null;
/** Which form was refused, so only that one redraws from the body. */
let failedIntent: string | null = null;
let body: Record<string, string> = {};

function done(message: AdminProductMessage): Response {
  return Astro.redirect(`${selfUrl}?m=${message}`, 303);
}

/** Turns a query-layer refusal into the banner and, where it has one, a field. */
function refuse(reason: CatalogFailure, intent: string) {
  banner = reason;
  failedIntent = intent;
  if (reason === 'slug_taken') invalid.add('slug');
  if (reason === 'sku_taken') invalid.add('sku');
  if (reason === 'colour_name_required') invalid.add('colorName');
}

if (Astro.request.method === 'POST') {
  // Before `formData()`, which buffers the whole body: the per-file cap can
  // only be checked once the bytes are already in memory.
  const declaredLength = Number(Astro.request.headers.get('content-length') ?? 0);
  if (declaredLength > MAX_REQUEST_BYTES) {
    return new Response('Забагато даних у запиті', { status: 413 });
  }

  const form = await Astro.request.formData();

  /*
   * The file is pulled out before `Object.fromEntries`, because it is a `File`
   * rather than a string and its rules are about bytes and pixels, not shape.
   * Zod strips it either way — `imageAddSchema` does not declare it.
   */
  const file = form.get('file');
  const fields = Object.fromEntries(form) as Record<string, string>;
  body = fields;

  const parsed = productActionSchema.safeParse(fields);

  if (!parsed.success) {
    invalid = catalogFieldErrors(parsed.error);
    failedIntent = String(form.get('intent') ?? '');
    banner = 'bad_request';
  } else {
    const action = parsed.data;
    const { db: txDb, close } = createTxDb(env.DATABASE_URL);

    try {
      switch (action.intent) {
        case 'product_save': {
          const result = await updateProduct(txDb, productId, action);
          if (result.ok) return done('saved');
          refuse(result.reason, action.intent);
          break;
        }

        case 'variant_add': {
          const result = await addVariant(txDb, productId, action);
          if (result.ok) return done('variant_added');
          refuse(result.reason, action.intent);
          break;
        }

        case 'variant_save': {
          const result = await updateVariant(txDb, productId, action.variantId, action);
          if (result.ok) return done('variant_saved');
          refuse(result.reason, action.intent);
          break;
        }

        case 'variant_activate': {
          const result = await setVariantActive(txDb, productId, action.variantId, action.active);
          if (result.ok) return done(action.active ? 'variant_activated' : 'variant_deactivated');
          refuse(result.reason, action.intent);
          break;
        }

        case 'image_add': {
          if (!(file instanceof File) || file.size === 0) {
            uploadIssue = 'empty';
            break;
          }

          const bytes = await file.arrayBuffer();

          /*
           * The *decoded* format, not what the browser declared. Those differ
           * more often than they should — a `curl -F` upload arrives as
           * `application/octet-stream` and is still a perfectly good WebP — and
           * the binding throws outright on a file that is not an image at all,
           * which is what leaves `format` null and is refused as «unreadable».
           *
           * Width and height decide nothing any more (see `~/lib/media/upload`);
           * they are read here only to be stored, so the markup can reserve the
           * space and the page does not shift as photos load.
           */
          let format: string | null = null;
          let width: number | null = null;
          let height: number | null = null;
          try {
            const info = await env.IMAGES.info(
              new Response(bytes).body as ReadableStream<Uint8Array>,
            );
            format = info.format;
            if ('width' in info) {
              width = info.width;
              height = info.height;
            }
          } catch {
            // Left null; `checkUploadedImage` refuses on exactly that.
          }

          const issue = checkUploadedImage({ size: bytes.byteLength, format });
          if (issue) {
            uploadIssue = issue;
            break;
          }

          /*
           * `storeImage` reads the dimensions again for its own return value.
           * Two `info()` calls per upload rather than one, accepted so the
           * signature stays byte-identical to the one `pnpm media:ingest` calls
           * — the whole point of sharing it is that the two paths cannot drift.
           * `info()` is metadata, not a transformation, so it costs no quota.
           */
          const stored = await storeImage(
            { bucket: env.MEDIA, images: env.IMAGES },
            bytes,
            format!,
          );

          await addProductImage(txDb, productId, {
            url: stored.url,
            alt: action.alt,
            width: stored.width ?? width,
            height: stored.height ?? height,
            variantId: action.variantId,
          });

          return done('image_added');
        }

        case 'image_save': {
          const result = await updateProductImage(txDb, productId, action.imageId, {
            alt: action.alt,
            variantId: action.variantId,
          });
          if (result.ok) return done('image_saved');
          refuse(result.reason, action.intent);
          break;
        }

        case 'image_move': {
          const result = await moveProductImage(txDb, productId, action.imageId, action.direction);
          if (result.ok) return done('image_moved');
          refuse(result.reason, action.intent);
          break;
        }

        case 'image_remove': {
          const result = await removeProductImage(txDb, productId, action.imageId);
          if (result.ok) return done('image_removed');
          refuse(result.reason, action.intent);
          break;
        }
      }
    } finally {
      Astro.locals.cfContext?.waitUntil?.(close());
    }
  }
}

/* -------------------------------------------------------------- GET / render */

const [detail, categories] = await Promise.all([
  findAdminProduct(db, productId),
  listCategoryOptions(db),
]);

if (!detail) {
  Astro.response.status = 404;
}

const messageParam = Astro.url.searchParams.get('m');
const redirectMessage =
  messageParam && messageParam in ADMIN_PRODUCT_MESSAGES
    ? (messageParam as AdminProductMessage)
    : null;

const message = banner ?? redirectMessage;

/** A refusal earns colour; a success does not — the saved value is on screen. */
const FAILURES = new Set<AdminProductMessage>([
  'slug_taken',
  'sku_taken',
  'last_active_variant',
  'colour_name_required',
  'not_found',
  'conflict',
  'bad_request',
]);
const failed = message !== null && FAILURES.has(message);

const product = detail?.product;
const variants = detail?.variants ?? [];
const images = detail?.images ?? [];

/*
 * File sizes come from the bucket rather than the database, because the database
 * has never held them: `product_images` stores a url, an alt, and the width and
 * height that reserve layout space. R2 is the only thing that knows how heavy a
 * photo is — and since object names are content hashes, its answer for a given
 * url cannot change, so there is nothing to keep in sync and nothing to backfill
 * for the rows that predate this.
 *
 * One `head` per photo, all in flight together. `head` is metadata: it moves no
 * bytes, costs a class-B operation, and this screen is one manager at a time. A
 * failure is silence rather than an error — a size is a line of text, and the
 * editor has to open even when the bucket does not answer.
 */
const imageSizes = new Map<string, number>();

await Promise.all(
  images.map(async (image) => {
    const key = mediaKeyFromUrl(image.url);
    if (key === null) return;

    try {
      const object = await env.MEDIA.head(key);
      if (object) imageSizes.set(image.id, object.size);
    } catch {
      // Left out of the map; the row renders without it.
    }
  }),
);

/* --- what the storefront will actually do with this row -------------------- */

const activeVariants = variants.filter((variant) => variant.isActive);
const displayPrice =
  activeVariants.length > 0 && product
    ? Math.min(...activeVariants.map((variant) => variant.priceOverride ?? product.basePrice))
    : (product?.basePrice ?? 0);
const inStockVariants = activeVariants.filter((variant) => variant.inStock);
/** Resolvable on the storefront: `getProductBySlug` needs both of these. */
const isLive = product?.status === 'active' && activeVariants.length > 0;

/* --- redraw helpers -------------------------------------------------------- */

function toHryvnias(kopiykas: number | null | undefined): string {
  return kopiykas === null || kopiykas === undefined ? '' : String(Math.round(kopiykas / 100));
}

function text(value: string | number | null | undefined): string {
  return value === null || value === undefined ? '' : String(value);
}

/** Submitted values win over stored ones, but only inside the form that failed. */
function redraw(intent: string, name: string, stored: string | number | null | undefined): string {
  if (failedIntent === intent) return body[name] ?? '';
  return text(stored);
}

function redrawVariant(
  variantId: string,
  name: string,
  stored: string | number | null | undefined,
): string {
  if (failedIntent === 'variant_save' && body.variantId === variantId) return body[name] ?? '';
  return text(stored);
}

/**
 * The same, for a checkbox: a refused row is redrawn from its own body, where
 * an unticked box is an *absent* key rather than an empty one — so `=== 'on'`
 * is the whole test, and it correctly reads «not ticked» for a field the body
 * never carried.
 */
function redrawVariantChecked(variantId: string, name: string, stored: boolean): boolean {
  if (failedIntent === 'variant_save' && body.variantId === variantId) return body[name] === 'on';
  return stored;
}

const variantRowFailed = (variantId: string) =>
  failedIntent === 'variant_save' && body.variantId === variantId;

const featured =
  failedIntent === 'product_save' ? body.isFeatured === 'on' : (product?.isFeatured ?? false);
const statusValue = redraw('product_save', 'status', product?.status) || 'draft';

/** Suggested for the next variant, from the slug the product actually has. */
const nextSku = product ? suggestSku(product.slug, body.colorName) : '';

const variantLabel = (variant: (typeof variants)[number]) =>
  variant.colorName ?? variant.sku;

/**
 * «1440×1920 px · 204 КБ» — the two facts about the file under its url, either
 * of which can be missing on its own. Dimensions are absent on a row stored
 * before they could be read; a size is absent when the object is not in the
 * bucket, which is worth seeing as a gap rather than papering over.
 */
function imageMeta(image: (typeof images)[number]): string {
  const parts: string[] = [];

  if (image.width && image.height) parts.push(`${image.width}×${image.height} px`);

  const size = imageSizes.get(image.id);
  if (size !== undefined) parts.push(formatFileSize(size));

  return parts.length > 0 ? parts.join(' · ') : 'розмір невідомий';
}
---

<AdminLayout title={detail?.translation?.title ?? 'Товар'}>
  {/*
    Everything the server can change lives inside this one element, because
    everything the server can change *does* change together: saving «Основне»
    moves the price in «На вітрині», renaming a variant relabels every «Належить»
    select, adding a photo rewrites which rows have «Вище» and «Нижче». So the
    swap below is the whole editor rather than a section, and the id is the only
    thing the script needs to find it in the response.
  */}
  <div
    id="product-editor"
    class="aria-busy:pointer-events-none aria-busy:opacity-60 transition-opacity"
  >
    {
      !detail ? (
        <>
          <nav class="text-fg-subtle text-sm">
            <a href="/products" class="underline-offset-2 hover:underline">
              ← Товари
            </a>
          </nav>
          <h1 class="text-fg mt-3 text-2xl font-semibold sm:text-3xl">Товар не знайдено</h1>
          <p class="text-fg-muted mt-2">Можливо, його видалили або адреса неправильна.</p>
        </>
      ) : (
        <>
          <nav class="text-fg-subtle text-sm">
            <a href="/products" class="underline-offset-2 hover:underline">
              ← Товари
            </a>
          </nav>

          <header class="mt-3 flex flex-wrap items-start justify-between gap-x-4 gap-y-3">
            <div class="min-w-0">
              <h1 class="text-fg text-2xl font-semibold sm:text-3xl">
                {detail.translation?.title ?? product!.slug}
              </h1> 
              <p class="text-fg-subtle mt-1 mb-2 font-mono text-sm">/products/{product!.slug}</p>
              <ProductStatusBadge status={product!.status} />
            </div>
            <div class="flex flex-wrap items-center gap-2">
              
              {/* Absolute on purpose: the storefront is another host since the
                  split, and a relative `/products/<slug>` stays on this one. */}
              {isLive && (
                <a
                  href={`${env.SITE_ORIGIN}/products/${product!.slug}`}
                  target="_blank"
                  rel="noreferrer"
                  class="admin-btn admin-btn-secondary"
                >
                  Переглянути
                </a>
              )}
            </div>
          </header>

          {/* The id is what the script moves into the toast host; `data-tone` is
              what tells it whether the sentence may expire. Both are inert
              without script, and this stays a banner above the form. */}
          {message && (
            <p
              id="editor-message"
              data-tone={failed ? 'bad' : 'ok'}
              role={failed ? 'alert' : 'status'}
              class:list={[
                'rounded-card mt-5 p-3 text-sm',
                failed ? 'admin-tone-negative' : 'admin-card text-fg-muted',
              ]}
            >
              {ADMIN_PRODUCT_MESSAGES[message]}
            </p>
          )}

          {/* --------------------------------------------------- на вітрині --- */}
          <section class="admin-card mt-6 p-5">
            <h2 class="text-fg text-base font-semibold">На вітрині</h2>

            <dl class="mt-3 grid grid-cols-2 gap-x-6 gap-y-3 sm:grid-cols-4">
              <div>
                <dt class="text-fg-subtle text-xs">Ціна на картці</dt>
                <dd class="text-fg mt-0.5 font-medium tabular-nums">{formatPrice(displayPrice)}</dd>
              </div>
              <div>
                <dt class="text-fg-subtle text-xs">У продажу</dt>
                <dd class="text-fg mt-0.5 font-medium tabular-nums">
                  {activeVariants.length} / {variants.length}
                </dd>
              </div>
              <div>
                <dt class="text-fg-subtle text-xs">В наявності</dt>
                <dd
                  class:list={[
                    'mt-0.5 font-medium tabular-nums',
                    inStockVariants.length === 0 ? 'text-danger' : 'text-fg',
                  ]}
                >
                  {inStockVariants.length} / {activeVariants.length}
                </dd>
              </div>
              <div>
                <dt class="text-fg-subtle text-xs">Оновлено</dt>
                <dd class="text-fg-muted mt-0.5 text-sm">
                  {formatAdminDateTime(product!.updatedAt)}
                </dd>
              </div>
            </dl>

            {/* The three facts the form itself cannot show, each shown only when
                it currently applies to this product. */}
            <ul class="text-fg-subtle mt-4 space-y-1.5 text-xs">
              <li>{ADMIN_STOREFRONT_NOTES.price}</li>
              {images.length > 0 && <li>{ADMIN_STOREFRONT_NOTES.leadImage}</li>}
            </ul>

            {product!.status === 'active' && activeVariants.length === 0 && (
              <p role="alert" class="rounded-card admin-tone-negative mt-3 p-3 text-xs">
                {ADMIN_STOREFRONT_NOTES.noVariants}
              </p>
            )}
            {product!.status === 'active' &&
              activeVariants.length > 0 &&
              inStockVariants.length === 0 && (
                <p class="rounded-card admin-tone-attention mt-3 p-3 text-xs">
                  {ADMIN_STOREFRONT_NOTES.noneInStock}
                </p>
              )}
            {images.length === 0 && (
              <p class="rounded-card admin-tone-attention mt-3 p-3 text-xs">
                {ADMIN_STOREFRONT_NOTES.noImages}
              </p>
            )}
          </section>

          {/* ------------------------------------------------------ основне --- */}
          <section class="admin-card mt-6 p-5">
            <h2 class="text-fg text-base font-semibold">Основне</h2>

            {/* `data-form` is a name for this form that survives the swap, so the
                script can hand the keyboard back to the button that was pressed.
                Anything unique will do; these read as what they are. */}
            <form method="post" action={selfUrl} data-form="product" class="mt-4">
              <input type="hidden" name="intent" value="product_save" />

              <div>
                <label for="title" class="text-fg-subtle text-xs">Назва</label>
                <input
                  id="title"
                  name="title"
                  type="text"
                  value={redraw('product_save', 'title', detail.translation?.title)}
                  maxlength={200}
                  autocomplete="off"
                  class:list={['admin-field mt-1', invalid.has('title') && 'border-danger']}
                />
                {invalid.has('title') && (
                  <p class="text-danger mt-1 text-xs">{ADMIN_CATALOG_ERRORS.title}</p>
                )}
              </div>

              <div class="mt-4">
                <label for="slug" class="text-fg-subtle text-xs">Адреса сторінки</label>
                <div class="mt-1 flex items-center gap-2">
                  <span class="text-fg-subtle shrink-0 font-mono text-sm">/products/</span>
                  <input
                    id="slug"
                    name="slug"
                    type="text"
                    value={redraw('product_save', 'slug', product!.slug)}
                    maxlength={60}
                    autocomplete="off"
                    spellcheck="false"
                    class:list={['admin-field font-mono', invalid.has('slug') && 'border-danger']}
                  />
                </div>
                {invalid.has('slug') ? (
                  <p class="text-danger mt-1 text-xs">{ADMIN_CATALOG_ERRORS.slug}</p>
                ) : (
                  product!.status === 'active' && (
                    <p class="text-fg-subtle mt-1 text-xs">{ADMIN_STOREFRONT_NOTES.slugChange}</p>
                  )
                )}
              </div>

              <div class="mt-4">
                <label for="description" class="text-fg-subtle text-xs">Опис</label>
                <textarea
                  id="description"
                  name="description"
                  rows="4"
                  maxlength={4000}
                  class:list={[
                    'admin-field admin-textarea mt-1',
                    invalid.has('description') && 'border-danger',
                  ]}
                  set:text={redraw('product_save', 'description', detail.translation?.description)}
                />
              </div>

              <div class="mt-4">
                <label for="details" class="text-fg-subtle text-xs">Деталі</label>
                <textarea
                  id="details"
                  name="details"
                  rows="4"
                  maxlength={2000}
                  class:list={[
                    'admin-field admin-textarea mt-1',
                    invalid.has('details') && 'border-danger',
                  ]}
                  set:text={redraw('product_save', 'details', detail.translation?.details)}
                />
                <p class="text-fg-subtle mt-1 text-xs">
                  Один рядок — один пункт списку на сторінці товару.
                </p>
              </div>

              <div class="mt-4 flex flex-wrap gap-4">
                <div class="w-full sm:w-40">
                  <label for="basePrice" class="text-fg-subtle text-xs">Ціна</label>
                  <div class="relative mt-1">
                    <input
                      id="basePrice"
                      name="basePrice"
                      type="text"
                      inputmode="numeric"
                      value={redraw('product_save', 'basePrice', toHryvnias(product!.basePrice))}
                      autocomplete="off"
                      class:list={['admin-field pr-10', invalid.has('basePrice') && 'border-danger']}
                    />
                    <span
                      class="text-fg-subtle pointer-events-none absolute inset-y-0 right-4.5 flex items-center text-base sm:text-sm"
                      aria-hidden="true"
                    >
                      ₴
                    </span>
                  </div>
                  {invalid.has('basePrice') && (
                    <p class="text-danger mt-1 text-xs">{ADMIN_CATALOG_ERRORS.basePrice}</p>
                  )}
                </div>

                <div class="w-full sm:w-44">
                  <label for="dimensions" class="text-fg-subtle text-xs">Розміри</label>
                  <input
                    id="dimensions"
                    name="dimensions"
                    type="text"
                    value={redraw('product_save', 'dimensions', product!.dimensions)}
                    maxlength={100}
                    autocomplete="off"
                    placeholder="30х17х10 см"
                    class:list={['admin-field mt-1', invalid.has('dimensions') && 'border-danger']}
                  />
                </div>

                {/* Which Nova Poshta box the waybill form preselects — the
                    tier is what the carrier charges by; the box's own
                    numbers live in `PARCEL_SIZES`. */}
                <div class="w-full sm:w-40">
                  <label for="parcelSize" class="text-fg-subtle text-xs">Коробка для ТТН</label>
                  <select id="parcelSize" name="parcelSize" class="admin-field admin-select mt-1">
                    {parcelSize.enumValues.map((value) => (
                      <option
                        value={value}
                        selected={value === (redraw('product_save', 'parcelSize', product!.parcelSize) || 'small')}
                      >
                        {PARCEL_SIZE_LABELS[value]}
                      </option>
                    ))}
                  </select>
                  {invalid.has('parcelSize') && (
                    <p class="text-danger mt-1 text-xs">{ADMIN_CATALOG_ERRORS.parcelSize}</p>
                  )}
                </div>
              </div>

              <div class="mt-4 flex flex-wrap gap-4">
                <div class="w-full flex-1">
                  <label for="categoryId" class="text-fg-subtle text-xs">Категорія</label>
                  <div class="relative mt-1">
