                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="m4 6 4 4 4-4" />
                </svg>
              </summary>

              <form method="post" action={selfUrl} data-form="variant-add" class="mt-3">
                <input type="hidden" name="intent" value="variant_add" />

                <div class="flex flex-wrap gap-3">
                  <div class="w-full sm:w-52">
