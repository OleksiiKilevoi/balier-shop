---
import { env } from 'cloudflare:workers';
import AdminLayout from '~/layouts/AdminLayout.astro';
import {
  OTP_RESEND_INTERVAL_SECONDS,
  OTP_TTL_SECONDS,
  SESSION_COOKIE,
  generateOtpCode,
  hashOtp,
  sessionCookieOptions,
  signSession,
  verifyOtpHash,
  verifySession,
} from '@balier/lib/auth';
import { createDb } from '@balier/lib/db';
import {
  claimOtpAttempt,
  clearOtp,
  findOtpAccountByEmail,
  issueOtp,
} from '@balier/lib/db/queries/adminTelegram';
import { recordAdminLogin } from '@balier/lib/db/queries/adminUsers';
import {
  ADMIN_AUTH_MESSAGES,
  telegramOtpText,
  type AdminAuthMessage,
} from '@balier/lib/i18n/admin';
import { sendTelegramMessage } from '@balier/lib/notify/telegram';
import { peekRateLimit, recordRateLimitHit } from '@balier/lib/rateLimit';
import { adminOtpRequestSchema, adminOtpVerifySchema } from '@balier/lib/validation/admin';
import { safeNext } from '~/lib/safeNext';

/**
 * The panel's other door: email → a six-digit code in the operator's own
 * Telegram chat → the same session cookie `/login` mints. No password
 * involved; what stands in for it is possession of a chat that was bound to
 * the account by the `/settings` handshake.
 *
 * Two steps, one page, both plain forms in `/login`'s mould — and **every POST
 * answers with a 303 back to this page** (PRG), success and failure alike, so
 * a refresh on either step is always a harmless GET: it cannot re-ask for a
 * code, re-spend a guess attempt, or reset the resend countdown. Which step a
 * GET renders lives in a short cookie (`admin_otp_email`, the code's own
 * lifetime); what it says arrives in `?message=`, the same channel `/login`
 * uses for `signed_out`.
 *
 * THE ANSWER IS ALWAYS «НАДІСЛАНО»
 * Step one answers with the same sentence — and sets the step cookie —
 * whether a code went out, the address matched nothing, or the account never
 * linked Telegram: `invalid_credentials`' anti-enumeration rule, applied
 * here. The real work happens off the response path (`waitUntil`) for the
 * same reason: a reply whose *timing* says "that one exists" would undo what
 * the wording hides.
 */
export const prerender = false;

/**
 * One budget for both steps, spent differently: every send-shaped POST costs
 * (each one may fire a Telegram message — the form must not be anyone's free
 * notification cannon), but only a *wrong* code costs, so a person slow to
 * retype six digits is never locked out by their own successes. Ten per
 * quarter-hour is invisible to a person; five wrong codes already kill a code
 * on their own (`claimOtpAttempt`), so the budget is the outer fence.
 */
const OTP_LIMIT = 10;
const OTP_WINDOW_SECONDS = 900;

/**
 * The step marker a redirect cannot carry in a form body: its presence means
 * "render the code form", its value fills the verify form's hidden email.
 * Scoped to this page and given the code's own lifetime, so an abandoned
 * attempt falls back to the email form on its own. Not `__Host-` — that
 * prefix forbids a `path`, and this cookie has no business travelling with
 * every panel request.
 */
const EMAIL_COOKIE = 'admin_otp_email';
const emailCookieOptions = {
  path: '/login/telegram',
  httpOnly: true,
  secure: true,
  sameSite: 'lax',
  maxAge: OTP_TTL_SECONDS,
} as const;

/** Never cache a page that is either a login form or a fresh `Set-Cookie`. */
Astro.response.headers.set('cache-control', 'no-store');

const next = safeNext(Astro.url.searchParams.get('next'));

/** Back to the password form, destination in hand. */
const passwordLoginHref = `/login${next !== '/' ? `?next=${encodeURIComponent(next)}` : ''}`;

/** Where every POST bounces back to, `?next=` preserved, message on board. */
const selfHref = (message?: AdminAuthMessage) => {
  const params = new URLSearchParams();
  if (next !== '/') params.set('next', next);
  if (message) params.set('message', message);
  const qs = params.toString();
  return `/login/telegram${qs ? `?${qs}` : ''}`;
};

// Already signed in? Same as `/login`: this page is a dead end, move along.
const existing = await verifySession(
  env.ADMIN_SESSION_SECRET,
  Astro.cookies.get(SESSION_COOKIE)?.value,
);
if (existing && Astro.request.method === 'GET') return Astro.redirect(next, 303);

const budgetKey = `admin-otp:${Astro.request.headers.get('cf-connecting-ip') ?? 'unknown'}`;

if (Astro.request.method === 'POST') {
  if (!env.ADMIN_SESSION_SECRET) {
    // Nothing can be hashed or signed without it. Say so plainly — the gate
    // would refuse the session this page minted anyway.
    return Astro.redirect(selfHref('unavailable'), 303);
  }

  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? '');

  if (intent === 'otp_change') {
    // A typo'd address must not hold the code form for the cookie's five
    // minutes. Costs nothing, so it sits above the budget check — being
    // locked out of *sending* is no reason to be locked onto a step.
    Astro.cookies.delete(EMAIL_COOKIE, { path: emailCookieOptions.path });
    return Astro.redirect(selfHref(), 303);
  }

  const limit = await peekRateLimit(env.RATE_LIMIT, budgetKey, OTP_LIMIT, OTP_WINDOW_SECONDS);
  if (!limit.allowed) return Astro.redirect(selfHref('too_many_attempts'), 303);

  if (intent === 'otp_send') {
    // Spent before anything is looked up: the cost is the *ask*, not the
    // outcome — an outcome-priced budget would price the two answers apart.
    await recordRateLimitHit(env.RATE_LIMIT, budgetKey, OTP_WINDOW_SECONDS);

    const parsed = adminOtpRequestSchema.safeParse(Object.fromEntries(form));
    // A body only a hand-made request can produce still gets the neutral
    // answer — it will fail step two the same as any wrong guess.
    const email = parsed.success ? parsed.data.email : '';

    const db = createDb(env.DATABASE_URL);
    const account = email === '' ? null : await findOtpAccountByEmail(db, email);

    if (account?.telegramChatId) {
      /*
       * The resend throttle, derived rather than stored: a code's send
       * moment is its expiry minus its lifetime. Inside the window the
       * form answers «надіслано» and sends nothing — true enough, since
       * the code it refers to is still on its way or already there.
       */
      const sentAt = account.otpExpiresAt
        ? account.otpExpiresAt.getTime() - OTP_TTL_SECONDS * 1000
        : 0;

      if (Date.now() - sentAt >= OTP_RESEND_INTERVAL_SECONDS * 1000) {
        const code = generateOtpCode();
        const otpHash = await hashOtp(env.ADMIN_SESSION_SECRET, account.id, code);
        const chatId = account.telegramChatId;

        /*
         * Off the response path — see the header. The row is written before
         * the message goes out, so a code that arrives is always one the
         * database can honour; the reverse order could hand somebody six
         * digits the verify step has never heard of.
         */
        const dispatch = (async () => {
          await issueOtp(db, account.id, otpHash, new Date(Date.now() + OTP_TTL_SECONDS * 1000));
          await sendTelegramMessage(env.TELEGRAM_BOT_TOKEN, chatId, telegramOtpText(code));
        })().catch(() => {});
        Astro.locals.cfContext?.waitUntil?.(dispatch);
      }
    }

    // Unconditional, like the message it travels with: a cookie only real
    // sends produced would betray exactly what «надіслано» hides.
    Astro.cookies.set(EMAIL_COOKIE, email, emailCookieOptions);
    return Astro.redirect(selfHref('otp_sent'), 303);
  }

  if (intent === 'otp_verify') {
    /** A wrong answer, and the only verify outcome that costs budget. */
    const reject = async () => {
      await recordRateLimitHit(env.RATE_LIMIT, budgetKey, OTP_WINDOW_SECONDS);
      return Astro.redirect(selfHref('invalid_code'), 303);
    };

    const parsed = adminOtpVerifySchema.safeParse(Object.fromEntries(form));
    if (!parsed.success) return reject();

    const db = createDb(env.DATABASE_URL);
    const account = await findOtpAccountByEmail(db, parsed.data.email);
    // One claimed attempt per guess, counted in SQL — `claimOtpAttempt`
    // is what makes five mean five even for parallel guesses.
    const storedHash = account ? await claimOtpAttempt(db, account.id) : null;

    if (
      !account ||
      !storedHash ||
      !(await verifyOtpHash(env.ADMIN_SESSION_SECRET, account.id, parsed.data.code, storedHash))
    ) {
      return reject();
    }

    // Spent before the redirect: a code that signed somebody in is dead.
    await clearOtp(db, account.id);

    const token = await signSession(env.ADMIN_SESSION_SECRET, {
      sub: account.id,
      email: account.email,
    });
    if (!token) return Astro.redirect(selfHref('unavailable'), 303);

    Astro.cookies.set(SESSION_COOKIE, token, sessionCookieOptions());
    Astro.cookies.delete(EMAIL_COOKIE, { path: emailCookieOptions.path });

    // Bookkeeping, never a reason to delay or fail a login — same as `/login`.
    Astro.locals.cfContext?.waitUntil?.(recordAdminLogin(db, account.id).catch(() => {}));

    return Astro.redirect(next, 303);
  }

  // An intent no form on this page renders: nothing to do, nothing to say.
  return Astro.redirect(selfHref(), 303);
}

/* From here down only GETs render — every POST above returned a redirect. */

const pendingEmail = Astro.cookies.get(EMAIL_COOKIE)?.value;
/** Which of the two forms to render. `code` after any send, however it went. */
const step: 'email' | 'code' = pendingEmail !== undefined ? 'code' : 'email';
/** Fills the verify form's hidden field, the same job `/login` gives `email`. */
const email = pendingEmail ?? '';

const queryMessage = Astro.url.searchParams.get('message');
let message: AdminAuthMessage | null =
  queryMessage && queryMessage in ADMIN_AUTH_MESSAGES ? (queryMessage as AdminAuthMessage) : null;

/** Minutes left on the lockout, so the message can name a number. */
let retryAfterMinutes = 0;
if (message === 'too_many_attempts') {
  // The number belongs to *now*, not to the POST that minted the URL — a
  // refresh must count down, and once the window has passed the message goes
  // with it rather than warning about a lockout that no longer exists.
  const limit = await peekRateLimit(env.RATE_LIMIT, budgetKey, OTP_LIMIT, OTP_WINDOW_SECONDS);
  if (limit.allowed) message = null;
  else retryAfterMinutes = Math.max(1, Math.ceil(limit.retryAfterSeconds / 60));
}

/** `otp_sent` is information, not a refusal — the only grey message here. */
const failed = message !== null && message !== 'otp_sent';
---

<AdminLayout title="Вхід через Telegram" bare>
  <div class="mx-auto w-full max-w-sm py-8 sm:py-16">
    <h1 class="text-fg text-center text-2xl font-semibold">Вхід через Telegram</h1>
    <p class="text-fg-muted mt-2 text-center text-sm">
      {
        step === 'email'
          ? 'Введіть пошту — бот надішле одноразовий код у прив’язаний Telegram.'
          : 'Введіть код із повідомлення бота.'
      }
    </p>

    {
      message && (
        <p
          class:list={[
            'admin-card mt-6 px-4 py-3 text-sm',
            failed ? 'admin-tone-negative' : 'admin-tone-neutral',
          ]}
          role={failed ? 'alert' : 'status'}
        >
          {ADMIN_AUTH_MESSAGES[message]}
          {retryAfterMinutes > 0 && ` Спробуйте за ${retryAfterMinutes} хв.`}
        </p>
      )
    }

    {
      step === 'email' ? (
        <form method="post" class="mt-6 space-y-4" data-otp-send>
          <input type="hidden" name="intent" value="otp_send" />
          <div>
            <label for="otp-email" class="text-fg mb-1.5 block text-sm font-medium">Пошта</label>
            <input
              id="otp-email"
              name="email"
              type="email"
              value={email}
              required
              autocomplete="username"
              autocapitalize="none"
              spellcheck="false"
              maxlength={320}
              class="admin-field"
            />
          </div>
          <button type="submit" class="admin-btn admin-btn-primary w-full">Надіслати код</button>
        </form>
      ) : (
        <>
          <form method="post" class="mt-6 space-y-4">
            <input type="hidden" name="intent" value="otp_verify" />
            <input type="hidden" name="email" value={email} />
            <div>
              <label for="otp-code" class="text-fg mb-1.5 block text-sm font-medium">
                Код із Telegram
              </label>
              {/* `one-time-code` lets a phone offer the six digits it can see;
                  `text` + numeric keypad for the same reasons every numeric
                  field in the panel is. */}
              <input
                id="otp-code"
                name="code"
                type="text"
                inputmode="numeric"
                autocomplete="one-time-code"
                required
                maxlength={6}
                pattern="\d{6}"
                autofocus
                class="admin-field text-center tracking-[0.5em]"
              />
            </div>
            <button type="submit" class="admin-btn admin-btn-primary w-full">Увійти</button>
          </form>

          {/* A fresh code, same neutral answer. The throttle upstream decides
              whether anything is actually sent; the countdown the script draws
              on this button is that throttle's cosmetic half — script-off, the
              button stays active and the server swallows early asks silently. */}
          <form method="post" class="mt-3" data-otp-send>
            <input type="hidden" name="intent" value="otp_send" />
            <input type="hidden" name="email" value={email} />
            <button
              type="submit"
              id="otp-resend"
              data-interval={OTP_RESEND_INTERVAL_SECONDS}
              class="admin-btn admin-btn-secondary w-full"
            >
              Надіслати новий код
            </button>
          </form>

          {/* The way off a mistyped address — without it the step cookie holds
              this form up for its full five minutes. */}
          <form method="post" class="mt-4 text-center">
            <input type="hidden" name="intent" value="otp_change" />
            <button
              type="submit"
              class="text-fg-muted hover:text-fg text-sm underline underline-offset-2"
            >
              Змінити пошту
            </button>
          </form>
        </>
      )
    }

    <p class="mt-6 text-center text-sm">
      <a href={passwordLoginHref} class="text-fg-muted hover:text-fg underline underline-offset-2">
        Увійти з паролем
      </a>
    </p>
  </div>

  <script>
    /*
     * The resend countdown — cosmetics over the server's 60-second throttle,
     * never the throttle itself. Its start is stamped into sessionStorage the
     * moment either send-shaped form is *submitted* — unconditionally, before
     * any outcome is known, because a timer that only real sends produced
     * would leak what the neutral «надіслано» hides — so it survives the 303
     * that answers the POST and any number of reloads after it. Where storage
     * is unavailable, the button simply stays active — the server swallows
     * early asks either way.
     */
    const KEY = 'otp-sent-at';

    for (const form of document.querySelectorAll<HTMLFormElement>('form[data-otp-send]')) {
      form.addEventListener('submit', () => {
        try {
          sessionStorage.setItem(KEY, String(Date.now()));
        } catch {
          // Storage refused (locked-down browser): no countdown, active button.
        }
      });
    }

    const button = document.getElementById('otp-resend') as HTMLButtonElement | null;

    if (button) {
      const label = button.textContent!.trim();
      const intervalMs = Number(button.dataset.interval ?? '60') * 1000;

      let sentAt = 0;
      try {
        sentAt = Number(sessionStorage.getItem(KEY) ?? '0');
      } catch {
        // Same locked-down browser as above.
      }

      const tick = () => {
        const left = Math.ceil((sentAt + intervalMs - Date.now()) / 1000);
        if (left > 0) {
          button.disabled = true;
          button.textContent = `${label} (${left})`;
        } else {
          button.disabled = false;
          button.textContent = label;
          clearInterval(timer);
        }
      };
      const timer = setInterval(tick, 250);
      tick();
    }
  </script>
</AdminLayout>
