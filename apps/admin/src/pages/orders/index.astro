---
import { env } from 'cloudflare:workers';
import OrderStatusBadge from '~/components/OrderStatusBadge.astro';
import AdminLayout from '~/layouts/AdminLayout.astro';
import { createDb } from '@balier/lib/db';
import { listOrders } from '@balier/lib/db/queries/orders';
import { orderStatus } from '@balier/lib/db/schema';
import type { OrderStatus } from '@balier/lib/db/schema';
import { ORDER_STATUS_LABELS, formatAdminDateTime } from '@balier/lib/i18n/admin';
import { pluralUk } from '@balier/lib/i18n/plural';
import { formatPrice } from '@balier/lib/money';
import { DELIVERY_METHOD_LABELS, PAYMENT_METHOD_LABELS } from '@balier/lib/notify/format';

/**
 * The order list. Filter and search are a plain GET form, so the view lives in
 * the URL and works before any script does — the same call `/search` makes, and
 * it matters more here: the panel has no client-side JavaScript at all.
 */
export const prerender = false;

const PAGE_SIZE = 25;
const MAX_QUERY = 100;

const params = Astro.url.searchParams;

// An unknown `?status=` is ignored rather than 404ing — it can only come from a
// hand-edited URL, and showing every order is the harmless reading.
const status = orderStatus.enumValues.find(
  (value): value is OrderStatus => value === params.get('status'),
);
const query = (params.get('q') ?? '').trim().slice(0, MAX_QUERY);
const page = Math.max(1, Number.parseInt(params.get('page') ?? '1', 10) || 1);

const { rows, total } = await listOrders(createDb(env.DATABASE_URL), {
  status,
  query: query || undefined,
  limit: PAGE_SIZE,
  offset: (page - 1) * PAGE_SIZE,
});

const pageCount = Math.max(1, Math.ceil(total / PAGE_SIZE));

function pageHref(next: number): string {
  const url = new URL(Astro.url);
  url.searchParams.set('page', String(next));
  return `${url.pathname}${url.search}`;
}

const countLabel = `${total} ${pluralUk(total, {
  one: 'замовлення',
  few: 'замовлення',
  many: 'замовлень',
})}`;
---

<AdminLayout title="Замовлення">
  <header class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
      <h1 class="text-fg text-2xl font-semibold sm:text-3xl">Замовлення</h1>
      <p class="text-fg-muted text-sm">{countLabel}</p>
    </div>
    {/* For an order that arrived in a chat rather than through the shop. */}
    <a href="/orders/new" class="admin-btn admin-btn-primary">Створити замовлення</a>
  </header>

  {/*
    Search and the status filter are one form and one action: the status was a
    row of nine pills, which is a third of the viewport on a phone and pushed the
    table off the first screen. A `<select>` is the same nine choices in one
    control, and folding it into the search row means both parts of the view are
    chosen in one place and applied in one submit. Submitting drops `page` on its
    own — a new filter is a new result set, and page 2 of the old one means
    nothing in it.
  */}
  <form method="get" action="/orders" class="mt-5 flex max-w-3xl flex-col gap-2 sm:flex-row">
    <label for="orders-q" class="sr-only">Номер, ім’я або телефон</label>
    <input
      id="orders-q"
      name="q"
      type="search"
      value={query}
      placeholder="B260804-XXXXX, ім’я або телефон"
      maxlength={MAX_QUERY}
      autocomplete="off"
      class="admin-field sm:flex-1"
    />

    <div class="relative sm:w-52">
      <label for="orders-status" class="sr-only">Статус</label>
      <select id="orders-status" name="status" class="admin-field admin-select">
        <option value="">Усі статуси</option>
        {
          orderStatus.enumValues.map((value) => (
            <option value={value} selected={value === status}>
              {ORDER_STATUS_LABELS[value]}
            </option>
          ))
        }
      </select>
      {/* The chevron is a sibling, not a pseudo-element: `appearance: none` takes
          the native arrow away, and `select::after` is not rendered. */}
      <svg
        class="text-fg-subtle pointer-events-none absolute top-1/2 right-4 h-4 w-4 -translate-y-1/2"
        viewBox="0 0 16 16"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="m4 6 4 4 4-4" />
      </svg>
    </div>

    <button type="submit" class="admin-btn admin-btn-primary shrink-0">Знайти</button>
  </form>

  {
    rows.length === 0 ? (
      <p class="text-fg-muted mt-8">
        {query || status
          ? 'За цим фільтром замовлень немає.'
          : 'Замовлень поки немає.'}
      </p>
    ) : (
      <>
        {/* Phone: one card per order, the number and status on the first line —
            a table at 320px either scrolls sideways or crushes every column. */}
        <ul class="mt-6 space-y-3 md:hidden">
          {rows.map((row) => (
            <li class="admin-card hover:border-border-strong transition-colors">
              <a href={`/orders/${row.orderNumber}`} class="block p-4">
                <div class="flex items-start justify-between gap-3">
                  <span class="text-fg font-mono text-sm font-medium whitespace-nowrap">
                    {row.orderNumber}
                  </span>
                  <OrderStatusBadge status={row.status} />
                </div>
                <p class="text-fg mt-2 text-sm">
                  {row.customerName} · {row.customerPhone}
                </p>
                <p class="text-fg-subtle mt-1 text-sm">
                  {formatAdminDateTime(row.createdAt)} ·{' '}
                  {PAYMENT_METHOD_LABELS[row.paymentMethod]}
                </p>
                <p class="text-fg mt-2 font-medium tabular-nums">{formatPrice(row.total)}</p>
              </a>
            </li>
          ))}
        </ul>

        <div class="admin-card mt-6 hidden overflow-x-auto md:block">
          <table class="w-full border-collapse text-sm">
            <thead class="text-fg-subtle border-border border-b text-left text-xs">
              <tr>
                <th scope="col" class="px-4 py-3 font-medium">Номер</th>
                <th scope="col" class="px-4 py-3 font-medium">Дата</th>
                <th scope="col" class="px-4 py-3 font-medium">Клієнт</th>
                <th scope="col" class="px-4 py-3 font-medium">Доставка</th>
                <th scope="col" class="px-4 py-3 font-medium">Оплата</th>
                <th scope="col" class="px-4 py-3 text-right font-medium">Сума</th>
                <th scope="col" class="px-4 py-3 font-medium">Статус</th>
              </tr>
            </thead>
            <tbody>
              {rows.map((row) => (
                <tr class="border-border hover:bg-surface-hover border-b transition-colors last:border-b-0">
                  <td class="px-4 py-3 whitespace-nowrap">
                    <a
                      href={`/orders/${row.orderNumber}`}
                      class="text-fg font-mono font-medium underline-offset-2 hover:underline"
                    >
                      {row.orderNumber}
                    </a>
                    <span class="text-fg-subtle block text-xs">
                      {row.itemCount} шт.
                    </span>
                  </td>
                  <td class="text-fg-muted px-4 py-3 whitespace-nowrap">
                    {formatAdminDateTime(row.createdAt)}
                  </td>
                  <td class="text-fg px-4 py-3">
                    {row.customerName}
                    <span class="text-fg-subtle block text-xs">{row.customerPhone}</span>
                  </td>
                  <td class="text-fg-muted px-4 py-3">
                    {DELIVERY_METHOD_LABELS[row.deliveryMethod]}
                    {row.npTtn && (
                      <span class="text-fg-subtle block font-mono text-xs">ТТН {row.npTtn}</span>
                    )}
                  </td>
                  <td class="text-fg-muted px-4 py-3">
                    {PAYMENT_METHOD_LABELS[row.paymentMethod]}
                  </td>
                  <td class="text-fg px-4 py-3 text-right font-medium tabular-nums whitespace-nowrap">
                    {formatPrice(row.total)}
                  </td>
                  <td class="px-4 py-3">
                    <OrderStatusBadge status={row.status} />
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </>
    )
  }

  {
    pageCount > 1 && (
      <nav class="mt-6 flex items-center justify-between gap-3" aria-label="Сторінки">
        <a
          href={pageHref(page - 1)}
          aria-disabled={page === 1}
          class:list={[
            'admin-btn admin-btn-secondary',
            page === 1 && 'pointer-events-none opacity-40',
          ]}
        >
          Назад
        </a>
        <span class="text-fg-muted text-sm tabular-nums">
          {page} / {pageCount}
        </span>
        <a
          href={pageHref(page + 1)}
          aria-disabled={page === pageCount}
          class:list={[
            'admin-btn admin-btn-secondary',
            page === pageCount && 'pointer-events-none opacity-40',
          ]}
        >
          Далі
        </a>
      </nav>
    )
  }
</AdminLayout>
