---
import { env } from 'cloudflare:workers';
import OrderStatusBadge from '~/components/OrderStatusBadge.astro';
import AdminLayout from '~/layouts/AdminLayout.astro';
import { createDb, createTxDb } from '@balier/lib/db';
import { getWarehouseCityRef } from '@balier/lib/db/queries/novaposhta';
import { findAdminOrder, getOrderItemWeights } from '@balier/lib/db/queries/orders';
import { getNpSenderSettings, getReservationTtlMinutes } from '@balier/lib/db/queries/settings';
import {
  ADMIN_CARD_LINK_EXPIRED,
  ADMIN_ORDER_MESSAGES,
  ADMIN_STATUS_CARRIER_HINT,
  ADMIN_WAYBILL_BLOCKERS,
  ADMIN_WAYBILL_ERRORS,
  ADMIN_WAYBILL_MANUAL_NOTE,
  ADMIN_WAYBILL_UNWEIGHED,
  ORDER_REVERT_FROM_REFUNDED_WARNING,
  ORDER_REVERT_HINTS,
  ORDER_REVERT_LABELS,
  ORDER_STATUS_LABELS,
  ORDER_TRANSITION_HINTS,
  ORDER_TRANSITION_LABELS,
  cardLinkExpiryText,
  formatAdminDateTime,
  npErrorText,
} from '@balier/lib/i18n/admin';
import type { AdminOrderMessage } from '@balier/lib/i18n/admin';
import { formatPrice } from '@balier/lib/money';
import { createMonobankPayment } from '@balier/lib/monobank';
import { DELIVERY_METHOD_LABELS, PAYMENT_METHOD_LABELS, deliveryDestination } from '@balier/lib/notify/format';
import { createNovaPoshtaShipping } from '@balier/lib/novaposhta/shipping';
import { splitRecipientName } from '@balier/lib/novaposhta/waybill';
import { allowedTransitions, orderDetailsLock, revertTarget } from '@balier/lib/orders/status';
import { removeCancelledOrderInvoices, updateOrderStatus } from '@balier/lib/orders/updateStatus';
import { attachWaybill, detachWaybill } from '@balier/lib/orders/waybill';
import type { NpSenderSettings } from '@balier/lib/db/queries/settings';
import { NP_CARGO_DESCRIPTION_MAX, adminOrderActionSchema } from '@balier/lib/validation/admin';

/**
 * One order: what it is, and the two things an operator may do to it — move it
 * along the state machine, and manage its Nova Poshta waybill.
 *
 * Every action is a plain form POST back to this same URL, answered with a 303
 * to it. Post/redirect/get, so a refresh after acting re-reads the order
 * instead of re-firing the action, and the page works with no script at all —
 * `enhanceAdminForms` (the script at the bottom) then takes the reload out of
 * it, swapping the page in place and showing the answer as a toast.
 */
export const prerender = false;

const orderNumber = Astro.params.orderNumber!;
const selfUrl = `/orders/${encodeURIComponent(orderNumber)}`;

function done(message: AdminOrderMessage): Response {
  return Astro.redirect(`${selfUrl}?m=${message}`, 303);
}

/** Every sender ref the waybill payload needs; the settings screen may hold fewer. */
function senderComplete(np: NpSenderSettings): boolean {
  return Boolean(np.counterpartyRef && np.contactRef && np.phone && np.cityRef && np.warehouseRef);
}

/**
 * A refused «Створити ТТН» is answered in place, not by redirect: the form
 * holds nine values, five of which the operator should not have to retype, and
 * the carrier's own refusal text cannot ride a `?m=` key.
 */
let waybillBanner: string | null = null;
let waybillInvalid = new Set<string>();
let waybillBody: Record<string, string> = {};

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const rawIntent = String(form.get('intent') ?? '');
  const parsed = adminOrderActionSchema.safeParse(Object.fromEntries(form));

  if (!parsed.success) {
    if (rawIntent === 'waybill_create') {
      waybillBody = Object.fromEntries(form) as Record<string, string>;
      for (const issue of parsed.error.issues) {
        const head = issue.path[0];
        if (typeof head === 'string') waybillInvalid.add(head);
      }
      // Field refusals render under their controls; the banner is only for a
      // body whose failure no control explains (a tampered hidden field).
      if (waybillInvalid.size === 0) waybillBanner = ADMIN_ORDER_MESSAGES.bad_request;
    } else {
      return done('bad_request');
    }
  } else if (parsed.data.intent === 'waybill_create') {
    const db = createDb(env.DATABASE_URL);
    const current = await findAdminOrder(db, orderNumber);
    if (!current) return new Response('Замовлення не знайдено', { status: 404 });

    /*
     * The cheap refusals happen BEFORE the carrier call, in the order of how
     * confusing the alternative would be: a carrier document for an order
     * that moved on is a real parcel to explain, not an error message.
     */
    if (current.npTtn !== null) return done('ttn_exists');
    if (current.status !== 'paid' && current.status !== 'confirmed') {
      return done('waybill_invalid_state');
    }

    const np = (await getNpSenderSettings(db)).values;
    const cityRef = current.npWarehouseRef
      ? await getWarehouseCityRef(db, current.npWarehouseRef)
      : null;
    if (
      !env.NOVAPOSHTA_API_KEY ||
      !senderComplete(np) ||
      !cityRef ||
      !current.npWarehouseRef ||
      (current.deliveryMethod !== 'np_warehouse' && current.deliveryMethod !== 'np_postomat')
    ) {
      // The GET below re-derives the exact blocker and names it; a body posted
      // past a blocked form is answered generically.
      return done('bad_request');
    }

    // Guaranteed by the schema's own refine — split again for the parts.
    const name = splitRecipientName(parsed.data.recipientName)!;
    const shipping = createNovaPoshtaShipping(env.NOVAPOSHTA_API_KEY);

    let created: Awaited<ReturnType<typeof shipping.createWaybill>> | null = null;
    try {
      created = await shipping.createWaybill({
        sender: {
          counterpartyRef: np.counterpartyRef!,
          contactRef: np.contactRef!,
          phone: np.phone!,
          cityRef: np.cityRef!,
          warehouseRef: np.warehouseRef!,
        },
        recipient: {
          lastName: name.lastName,
          firstName: name.firstName,
          middleName: name.middleName,
          phone: current.customerPhone,
          cityRef,
          warehouseRef: current.npWarehouseRef,
        },
        weightGrams: parsed.data.weightGrams,
        seats: parsed.data.seats,
        dimensionsCm: {
          length: parsed.data.seatLength,
          width: parsed.data.seatWidth,
          height: parsed.data.seatHeight,
        },
        description: parsed.data.description,
        declaredValueKopiykas: parsed.data.declaredValue,
        /* The server's own total, never the client's — and only for COD, where
           the carrier collects it (hard rule 1 does not bend for shipping). */
        codKopiykas: current.paymentMethod === 'cod' ? current.total : null,
      });
    } catch (err) {
      waybillBody = Object.fromEntries(form) as Record<string, string>;
      waybillBanner = npErrorText(err instanceof Error ? err.message : String(err));
    }

    if (created) {
      const { db: txDb, close } = createTxDb(env.DATABASE_URL);
      try {
        const result = await attachWaybill(txDb, orderNumber, {
          ttn: created.number,
          ttnRef: created.ref,
        });
        if (result.ok) return done('waybill_created');

        /*
         * The order moved between the pre-check and the lock — a second
         * operator, a webhook, a double submit. The carrier document exists
         * and must not: best-effort delete, off the response path, logged on
         * failure (a stray waybill on the account is visible in the cabinet
         * and deletable by hand; a second parcel sent is not undoable).
         */
        Astro.locals.cfContext.waitUntil(
          shipping.deleteWaybill(created.ref).catch((err) => {
            console.error(`Failed to delete orphaned waybill ${created!.number}`, err);
          }),
        );
        if (result.reason === 'not_found') {
          return new Response('Замовлення не знайдено', { status: 404 });
        }
        return done(result.reason);
      } finally {
        Astro.locals.cfContext.waitUntil(close());
      }
    }
  } else if (parsed.data.intent === 'waybill_delete') {
    const db = createDb(env.DATABASE_URL);
    const current = await findAdminOrder(db, orderNumber);
    if (!current) return new Response('Замовлення не знайдено', { status: 404 });
    // A hand-entered number has no ref — there is nothing of ours at the
    // carrier to delete. Since manual entry was removed (2026-08-07) such
    // legacy rows have no panel delete path at all; dev-only data, accepted.
    if (!current.npTtnRef) return done(current.npTtn ? 'bad_request' : 'no_waybill');
    if (!env.NOVAPOSHTA_API_KEY) return done('bad_request');

    const shipping = createNovaPoshtaShipping(env.NOVAPOSHTA_API_KEY);
    try {
      // Carrier first: their refusal (say, the branch already accepted the
      // parcel) must leave our record standing — the waybill still exists.
      await shipping.deleteWaybill(current.npTtnRef);
    } catch (err) {
      /*
       * One refusal is not like the others: a waybill already deleted *in the
       * NP cabinet* refuses deletion here forever («No document changed
       * DeletionMark») while our record still shows it — a dead end, found
       * live. Tracking is asked rather than the error text parsed: code 2 is
       * «видалено», 3 is «номер не знайдено», and both mean there is nothing
       * left at the carrier for our record to describe — so the detach below
       * proceeds. Any other answer keeps the refusal, verbatim.
       */
      let documentGone = false;
      try {
        const [tracked] = await shipping.trackWaybills([current.npTtn ?? '']);
        documentGone =
          tracked !== undefined && (tracked.statusCode === '2' || tracked.statusCode === '3');
      } catch {
        /* Tracking failed too — the original refusal is the better message. */
      }
      if (!documentGone) {
        waybillBanner = npErrorText(err instanceof Error ? err.message : String(err));
      }
    }

    if (!waybillBanner) {
      const { db: txDb, close } = createTxDb(env.DATABASE_URL);
      try {
        const result = await detachWaybill(txDb, orderNumber);
        if (result.ok) return done('waybill_deleted');
        if (result.reason === 'not_found') {
          return new Response('Замовлення не знайдено', { status: 404 });
        }
        return done(result.reason);
      } finally {
        Astro.locals.cfContext.waitUntil(close());
      }
    }
  } else {
    const { db: txDb, close } = createTxDb(env.DATABASE_URL);
    try {
      const result = await updateOrderStatus(txDb, {
        orderNumber,
        from: parsed.data.from,
        next: parsed.data.next,
      });

      if (result.ok) {
        // Cancelling an order whose card payment hasn't happened yet leaves its
        // Monobank link payable until the invoice's own validity runs out — kill
        // it now, after the transition committed, off the response path.
        if (result.order.status === 'cancelled' && result.order.paidAt === null) {
          Astro.locals.cfContext.waitUntil(
            removeCancelledOrderInvoices(
              createDb(env.DATABASE_URL),
              createMonobankPayment(env.MONOBANK_TOKEN),
              result.order.id,
            ),
          );
        }
        return done('status_updated');
      }
      if (result.reason === 'not_found') {
        return new Response('Замовлення не знайдено', { status: 404 });
      }
      return done(result.reason);
    } finally {
      Astro.locals.cfContext.waitUntil(close());
    }
  }
}

const db = createDb(env.DATABASE_URL);
const order = await findAdminOrder(db, orderNumber);

if (!order) Astro.response.status = 404;

/**
 * The Monobank payment link, for a card order that has not been paid yet.
 *
 * This exists for orders created in the panel: the customer is in a Telegram
 * chat, not in a browser being redirected, so somebody has to send them the
 * link — and possibly send it again. A storefront order shows it too, which is
 * the useful side effect: a customer who closed the payment tab used to be
 * unreachable, and now the link is simply here. `pageUrl` is NULL for anything
 * created before the column existed, and the block hides itself.
 */
const unpaidCard =
  order?.paymentMethod === 'card' &&
  (order.status === 'pending' || order.status === 'awaiting_payment');
const cardPayment = unpaidCard ? order.payments.find((payment) => payment.pageUrl) : undefined;

/**
 * When the invoice stops being payable. Monobank was handed the reservation TTL
 * as the invoice's own validity, and the cron cancels the order once the
 * reservation lapses — so this one moment is both deadlines, and it is worth
 * showing as a clock time rather than as "30 minutes from some earlier point".
 */
const linkExpiresAt = cardPayment
  ? new Date(cardPayment.createdAt.getTime() + (await getReservationTtlMinutes(db)) * 60_000)
  : null;
const linkExpired = linkExpiresAt !== null && linkExpiresAt.getTime() <= Date.now();

const messageParam = Astro.url.searchParams.get('m');
const message =
  messageParam && messageParam in ADMIN_ORDER_MESSAGES
    ? (messageParam as AdminOrderMessage)
    : null;

/** The keys that report a refusal rather than a success. */
const FAILURES = new Set<AdminOrderMessage>([
  'invalid_transition',
  'insufficient_stock',
  'stale',
  'bad_request',
  'edit_ttn_exists',
  'edit_locked',
  'ttn_exists',
  'waybill_invalid_state',
  'no_waybill',
]);

/** Whether the customer/delivery cards offer the edit page. */
const detailsEditable = order !== null && orderDetailsLock(order) === null;
const editUrl = `${selfUrl}/edit`;

/* --- the waybill ----------------------------------------------------------- */

const isNpDelivery =
  order?.deliveryMethod === 'np_warehouse' || order?.deliveryMethod === 'np_postomat';

/** The create form belongs on exactly the orders whose forward step is `packed`. */
const waybillEligible =
  order != null &&
  isNpDelivery &&
  order.npTtn === null &&
  (order.status === 'paid' || order.status === 'confirmed');

const npSender = waybillEligible ? (await getNpSenderSettings(db)).values : null;
const itemWeights = waybillEligible && order ? await getOrderItemWeights(db, order.id) : [];
const deliveryCityRef =
  waybillEligible && order?.npWarehouseRef
    ? await getWarehouseCityRef(db, order.npWarehouseRef)
    : null;

const unweighed = itemWeights.filter((item) => item.weightGrams === null);
const weightTotalGrams =
  itemWeights.length > 0 && unweighed.length === 0
    ? itemWeights.reduce((total, item) => total + (item.weightGrams ?? 0) * item.quantity, 0)
    : null;

/**
 * Why the form is absent, each one naming its fix — states, not errors. The
 * unweighed variants are listed separately with the lines themselves.
 */
const waybillBlockers: string[] = [];
if (waybillEligible && npSender) {
  if (!env.NOVAPOSHTA_API_KEY) waybillBlockers.push(ADMIN_WAYBILL_BLOCKERS.noApiKey);
  /* One message for both payment methods: NP-3's live driving proved a COD
     waybill creates fine on a personal key (`docs/plans/novaposhta.md`, live
     finding 2), so the fix here is always the same — fill in the sender.
     Whether the money transfer pays out at handover on a personal account is
     still the plan's open «Constraints» question, but it is not this form's. */
  if (!senderComplete(npSender)) waybillBlockers.push(ADMIN_WAYBILL_BLOCKERS.senderIncomplete);
  if (!deliveryCityRef) waybillBlockers.push(ADMIN_WAYBILL_BLOCKERS.noDeliveryCity);
}

const showWaybillForm = waybillEligible && waybillBlockers.length === 0 && unweighed.length === 0;

/** Submitted values win over the prefill, but only when the form was refused. */
const waybillRedrawing = waybillBanner !== null || waybillInvalid.size > 0;
const wv = (name: string, fallback: string): string =>
  waybillRedrawing && name in waybillBody ? (waybillBody[name] ?? '') : fallback;

const seatDims = npSender?.seatDimensionsCm ?? null;

/** The message under the form for each control the schema refused. */
const WAYBILL_FIELD_ERRORS: Record<string, string> = {
  recipientName: ADMIN_WAYBILL_ERRORS.invalid_recipient_name,
  weightGrams: ADMIN_WAYBILL_ERRORS.invalid_waybill_weight,
  seats: ADMIN_WAYBILL_ERRORS.invalid_seats,
  seatLength: ADMIN_WAYBILL_ERRORS.invalid_waybill_dimensions,
  seatWidth: ADMIN_WAYBILL_ERRORS.invalid_waybill_dimensions,
  seatHeight: ADMIN_WAYBILL_ERRORS.invalid_waybill_dimensions,
  description: ADMIN_WAYBILL_ERRORS.invalid_waybill_description,
  declaredValue: ADMIN_WAYBILL_ERRORS.invalid_declared_value,
};
const waybillFieldMessages = [
  ...new Set([...waybillInvalid].map((field) => WAYBILL_FIELD_ERRORS[field]).filter(Boolean)),
] as string[];

const transitions = order ? allowedTransitions(order) : [];
/*
 * No forward buttons since NP-4: `packed` is «Створити ТТН»'s to set,
 * `shipped`/`delivered` are the tracking cron's, and the forward-chain
 * reverts died with them — undoing `packed` is deleting its waybill, and
 * un-marking `shipped` by hand would be re-applied by the next tick. What the
 * state machine still offers is the exit, and — from `cancelled`/`refunded`
 * only — the revert that undoes the exit. Gated by `allowedTransitions`
 * rather than read off `revertTarget` directly, so this page cannot render a
 * button the server would refuse.
 */
const revertCandidate = order ? revertTarget(order) : null;
const revert =
  revertCandidate !== null && transitions.includes(revertCandidate) ? revertCandidate : null;
const exits = transitions.filter((next) => next === 'cancelled' || next === 'refunded');
const revertFromRefundedWarning =
  order && revert && order.status === 'refunded' ? ORDER_REVERT_FROM_REFUNDED_WARNING : null;
/** Statuses whose next movement belongs to the carrier — say so, since the
 * buttons that used to imply otherwise are gone. */
const carrierDriven =
  order?.status === 'packed' || order?.status === 'shipped' || order?.status === 'arrived';
---

<AdminLayout title={order ? `Замовлення ${order.orderNumber}` : 'Замовлення не знайдено'}>
  <a href="/orders" class="text-fg-muted hover:text-fg text-sm">← До списку</a>

  {
    !order ? (
      <p class="text-fg mt-6">Замовлення «{orderNumber}» не знайдено.</p>
    ) : (
      <div
        id="order-editor"
        class="aria-busy:pointer-events-none aria-busy:opacity-60 transition-opacity"
      >
        {/* Everything an action can change lives inside this element, and it
            is what `enhanceAdminForms` swaps in place. `id` is how the same
            element is found again in the response. */}
        <header class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-2">
          <h1 class="text-fg font-mono text-2xl font-semibold sm:text-3xl">
            {order.orderNumber}
          </h1>
          <OrderStatusBadge status={order.status} />
        </header>
        <p class="text-fg-subtle mt-1 text-sm">
          Створено {formatAdminDateTime(order.createdAt)}
          {order.paidAt && <> · оплачено {formatAdminDateTime(order.paidAt)}</>}
          {order.cancelledAt && <> · скасовано {formatAdminDateTime(order.cancelledAt)}</>}
        </p>

        {/* A refusal is the only thing that earns colour on this page — the
            successes are confirmed by the row itself having changed. The id is
            what the script moves into the toast host; `data-tone` tells it
            whether the sentence may expire. Both are inert without script, and
            this stays a banner at the top. */}
        {message && (
          <p
            id="order-message"
            data-tone={FAILURES.has(message) ? 'bad' : 'ok'}
            role={FAILURES.has(message) ? 'alert' : 'status'}
            class:list={[
              'rounded-card mt-5 p-3 text-sm',
              FAILURES.has(message)
                ? 'admin-tone-negative'
                : 'admin-card text-fg-muted',
            ]}
          >
            {ADMIN_ORDER_MESSAGES[message]}
          </p>
        )}

        {/* ------------------------------------------------------- actions */}
        <section class="admin-card mt-6 p-5">
          <h2 class="text-fg text-base font-semibold">Статус</h2>
          <p class="text-fg-muted mt-1 text-sm">
            Зараз: <strong class="text-fg font-medium">{ORDER_STATUS_LABELS[order.status]}</strong>
          </p>

          {/* The forward chain moves itself now — «Створити ТТН» below sets
              «ТТН створено», the tracking cron moves the rest — so this card
              says so where the buttons used to be, and keeps only the way
              out (and, from a terminal status, the way back). */}
          {carrierDriven && (
            <p class="text-fg-subtle mt-2 text-sm">{ADMIN_STATUS_CARRIER_HINT}</p>
          )}

          {transitions.length === 0 ? (
            <p class="text-fg-subtle mt-2 text-sm">
              Замовлення завершене — далі статус не змінюється.
            </p>
          ) : (
            <>
              {/* A disclosure rather than a confirm dialog: these are terminal
                  (or undo a terminal state, which re-touches stock the same way
                  exiting it did) and there is no script on this page. Two
                  deliberate clicks. */}
              {/* The disclosure ids keep them open across the enhancement
                  layer's swaps — a refused action must not fold away the
                  warning it was refused under. */}
              {(exits.length > 0 || revert) && (
                <details id="order-exits" class="admin-disclosure border-border mt-4 border-t pt-4">
                  <summary>
                    Інші дії
                    <svg
                      class="h-4 w-4 shrink-0"
                      viewBox="0 0 16 16"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="m4 6 4 4 4-4" />
                    </svg>
                  </summary>
                  {revert && (
                    <form method="post" action={selfUrl} class="mt-3">
                      <input type="hidden" name="intent" value="status" />
                      <input type="hidden" name="from" value={order.status} />
                      <input type="hidden" name="next" value={revert} />
                      {ORDER_REVERT_HINTS[revert] && (
                        <p class="text-fg-subtle mb-2 text-sm">{ORDER_REVERT_HINTS[revert]}</p>
                      )}
                      {revertFromRefundedWarning && (
                        <p class="text-fg-subtle mb-2 text-sm">{revertFromRefundedWarning}</p>
                      )}
                      {/* Secondary, not danger: this one *undoes* a terminal
                          state. It shares the disclosure with the exits because
                          it moves stock, not because it is destructive. */}
                      <button type="submit" class="admin-btn admin-btn-secondary w-full sm:w-auto">
                        {ORDER_REVERT_LABELS[revert]}
                      </button>
                    </form>
                  )}
                  {exits.map((next) => (
                    <form method="post" action={selfUrl} class="mt-3">
                      <input type="hidden" name="intent" value="status" />
                      <input type="hidden" name="from" value={order.status} />
                      <input type="hidden" name="next" value={next} />
                      {ORDER_TRANSITION_HINTS[next] && (
                        <p class="text-fg-subtle mb-2 text-sm">{ORDER_TRANSITION_HINTS[next]}</p>
                      )}
                      <button type="submit" class="admin-btn admin-btn-danger w-full sm:w-auto">
                        {ORDER_TRANSITION_LABELS[next]}
                      </button>
                    </form>
                  ))}
                </details>
              )}
            </>
          )}
        </section>

        {/* ------------------------------------------------- customer, delivery */}
        <div class="mt-6 grid gap-6 md:grid-cols-2">
          <section class="admin-card p-5">
            <div class="flex items-baseline justify-between gap-x-4">
              <h2 class="text-fg text-base font-semibold">Клієнт</h2>
              {detailsEditable && (
                <a href={editUrl} class="text-fg-muted hover:text-fg text-sm underline underline-offset-2">
                  Редагувати
                </a>
              )}
            </div>
            <dl class="mt-3 space-y-2 text-sm">
              <div>
                <dt class="text-fg-subtle text-xs">Ім’я</dt>
                <dd class="text-fg">{order.customerName}</dd>
              </div>
              <div>
                <dt class="text-fg-subtle text-xs">Телефон</dt>
                <dd class="text-fg">
                  <a href={`tel:${order.customerPhone}`} class="underline-offset-2 hover:underline">
                    {order.customerPhone}
                  </a>
                </dd>
              </div>
              {order.customerEmail && (
                <div>
                  <dt class="text-fg-subtle text-xs">Email</dt>
                  <dd class="text-fg">
                    <a
                      href={`mailto:${order.customerEmail}`}
                      class="underline-offset-2 hover:underline"
                    >
                      {order.customerEmail}
                    </a>
                  </dd>
                </div>
              )}
              {order.comment && (
                <div>
                  <dt class="text-fg-subtle text-xs">Коментар</dt>
                  <dd class="text-fg whitespace-pre-line">{order.comment}</dd>
                </div>
              )}
            </dl>
          </section>

          <section class="admin-card p-5">
            <div class="flex items-baseline justify-between gap-x-4">
              <h2 class="text-fg text-base font-semibold">Доставка й оплата</h2>
              {detailsEditable && (
                <a href={editUrl} class="text-fg-muted hover:text-fg text-sm underline underline-offset-2">
                  Редагувати
                </a>
              )}
            </div>
            <dl class="mt-3 space-y-2 text-sm">
              <div>
                <dt class="text-fg-subtle text-xs">Спосіб доставки</dt>
                <dd class="text-fg">{DELIVERY_METHOD_LABELS[order.deliveryMethod]}</dd>
              </div>
              <div>
                <dt class="text-fg-subtle text-xs">Куди</dt>
                <dd class="text-fg">{deliveryDestination(order)}</dd>
              </div>
              <div>
                <dt class="text-fg-subtle text-xs">Оплата</dt>
                <dd class="text-fg">{PAYMENT_METHOD_LABELS[order.paymentMethod]}</dd>
              </div>
              {order.payments.map((payment) => (
                <div>
                  <dt class="text-fg-subtle text-xs">Monobank</dt>
                  <dd class="text-fg">
                    {payment.status} · {formatPrice(payment.amount)}
                    <span class="text-fg-subtle block font-mono text-xs break-all">
                      {payment.invoiceId}
                    </span>
                  </dd>
                </div>
              ))}
            </dl>

            {/* The link to send the customer. `select-all` for the same reason
                the tracking number below has it: the only thing anyone does
                with this is copy it into a chat — which is also why the copy
                button below exists. The link stays selectable so that with
                script off (or the clipboard refused) nothing is lost. */}
            {cardPayment?.pageUrl && (
              <div class="border-border mt-4 border-t pt-4">
                <p class="text-fg-subtle text-xs">Посилання на оплату</p>
                <a
                  href={cardPayment.pageUrl}
                  rel="noreferrer"
                  target="_blank"
                  class="text-fg mt-1 block text-sm break-all underline underline-offset-2 select-all"
                >
                  {cardPayment.pageUrl}
                </a>
                <p
                  class:list={['mt-2 text-xs', linkExpired ? 'text-danger' : 'text-fg-subtle']}
                >
                  {linkExpired
                    ? ADMIN_CARD_LINK_EXPIRED
                    : cardLinkExpiryText(formatAdminDateTime(linkExpiresAt!))}
                </p>
                {/* Ships `hidden`; the script at the bottom reveals it only
                    once the clipboard API is known to exist, so it can never
                    render and then not work. Not offered for an expired link —
                    nothing about it is worth sending. The swap to «Скопійовано»
                    stays in the page's own foreground colour on purpose: on
                    this page only refusals earn colour. */}
                {!linkExpired && (
                  <button
                    type="button"
                    id="copy-pay-link"
                    data-url={cardPayment.pageUrl}
                    hidden
                    aria-live="polite"
                    class="admin-btn admin-btn-secondary mt-3 w-full sm:w-auto"
                  >
                    <span data-copy="idle" class="inline-flex items-center gap-x-2">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <rect
                          x="9"
                          y="9"
                          width="12"
                          height="12"
                          rx="2"
                          stroke="currentColor"
                          stroke-width="1.5"
                        />
                        <path
                          d="M5.5 15H4.75A1.75 1.75 0 0 1 3 13.25v-8.5C3 3.784 3.784 3 4.75 3h8.5C14.216 3 15 3.784 15 4.75v.75"
                          stroke="currentColor"
                          stroke-width="1.5"
                        />
                      </svg>
                      Копіювати посилання
                    </span>
                    <span data-copy="done" hidden class="inline-flex items-center gap-x-2">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path
                          d="m5 12.5 4.5 4.5L19 7.5"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                      Скопійовано
                    </span>
                  </button>
                )}
              </div>
            )}

          </section>
        </div>

        {/* ------------------------------------------------------ nova poshta */}
        {/* Everything about the physical parcel, in one card: the waybill (or
            the form that makes one), printing, deletion, and the hand-entry
            fallback for a waybill made in the NP cabinet. Courier orders from
            before 2026-08-06 have no branch to ship from and skip the card. */}
        {isNpDelivery && (
          <section class="admin-card mt-6 p-5">
            <h2 class="text-fg text-base font-semibold">Нова Пошта</h2>

            {/* The carrier's own refusal, verbatim — an operator can act on
                «Sender address is invalid» and cannot act on «щось пішло не
                так». */}
            {waybillBanner && (
              <p role="alert" class="admin-tone-negative rounded-card mt-4 p-3 text-sm">
                {waybillBanner}
              </p>
            )}

            {order.npTtn ? (
              <>
                <p class="text-fg-subtle mt-3 text-xs">Номер накладної</p>
                <p class="text-fg font-mono text-sm break-all select-all">{order.npTtn}</p>
                {order.npTtnCreatedAt && (
                  <p class="text-fg-subtle mt-1 text-xs">
                    Створено {formatAdminDateTime(order.npTtnCreatedAt)}.
                  </p>
                )}
                {/* NP-4 fills these; until then the row simply has no line. */}
                {order.npStatusText && (
                  <p class="text-fg-muted mt-2 text-sm">
                    {order.npStatusText}
                    {order.npStatusAt && (
                      <span class="text-fg-subtle"> · {formatAdminDateTime(order.npStatusAt)}</span>
                    )}
                  </p>
                )}
                {/* Code 11 — the COD payout credited. The one line that says
                    the money actually arrived, since `delivered` deliberately
                    means the handover, not the credit. */}
                {order.npMoneyTransferAt && (
                  <p class="text-fg-muted mt-1 text-sm">
                    Грошовий переказ зараховано
                    <span class="text-fg-subtle"> · {formatAdminDateTime(order.npMoneyTransferAt)}</span>
                  </p>
                )}

                {order.npTtnRef ? (
                  <>
                    <div class="mt-4">
                      {/* The proxy route — the carrier's print URL carries the
                          API key and never reaches this page. */}
                      <a
                        href={`${selfUrl}/marking`}
                        target="_blank"
                        rel="noreferrer"
                        class="admin-btn admin-btn-secondary w-full sm:w-auto"
                      >
                        Друк маркування
                      </a>
                    </div>

                    <details
                      id="order-waybill-delete"
                      class="admin-disclosure border-border mt-4 border-t pt-4"
                    >
                      <summary>
                        Видалити ТТН
                        <svg
                          class="h-4 w-4 shrink-0"
                          viewBox="0 0 16 16"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                        >
                          <path d="m4 6 4 4 4-4" />
                        </svg>
                      </summary>
                      <form method="post" action={selfUrl} class="mt-3">
                        <input type="hidden" name="intent" value="waybill_delete" />
                        <p class="text-fg-subtle mb-2 text-sm">
                          Накладна видалиться і в Новій Пошті — це можливо, доки посилку не
                          прийняли у відділенні. Замовлення повернеться до попереднього статусу.
                        </p>
                        <button type="submit" class="admin-btn admin-btn-danger w-full sm:w-auto">
                          Видалити ТТН
                        </button>
                      </form>
                    </details>
                  </>
                ) : (
                  <p class="text-fg-subtle mt-2 text-xs">{ADMIN_WAYBILL_MANUAL_NOTE}</p>
                )}
              </>
            ) : waybillEligible ? (
              <>
                {waybillBlockers.map((text) => (
                  <p class="text-fg-muted mt-3 text-sm">{text}</p>
                ))}

                {unweighed.length > 0 && (
                  <div class="mt-3 text-sm">
                    <p class="text-fg-muted">{ADMIN_WAYBILL_UNWEIGHED}</p>
                    <ul class="text-fg mt-1 list-disc pl-5">
                      {unweighed.map((item) => (
                        <li>
                          {item.productTitle}
                          {item.variantName && <span class="text-fg-muted"> · {item.variantName}</span>}
                        </li>
                      ))}
                    </ul>
                  </div>
                )}

                {showWaybillForm && order.npWarehouseRef && (
                  <form method="post" action={selfUrl} class="mt-4">
                    <input type="hidden" name="intent" value="waybill_create" />

                    {/* Where it goes is the order's word, restated rather than
                        editable: changing it here would mean shipping somewhere
                        the customer did not ask. */}
                    <p class="text-fg-muted text-sm">
                      До: {deliveryDestination(order)} · {order.customerPhone}
                    </p>
                    {order.paymentMethod === 'cod' && (
                      <p class="text-fg-muted mt-1 text-sm">
                        Післяплата: {formatPrice(order.total)} — збере Нова Пошта при видачі.
                      </p>
                    )}

                    <div class="mt-3 flex flex-wrap gap-3">
                      <div class="w-full sm:w-72">
                        <label for="wb-name" class="text-fg-subtle text-xs">
                          Одержувач — Прізвище Ім’я
                        </label>
                        <input
                          id="wb-name"
                          name="recipientName"
                          type="text"
                          value={wv('recipientName', order.customerName)}
                          autocomplete="off"
                          class:list={[
                            'admin-field mt-1',
                            waybillInvalid.has('recipientName') && 'border-danger',
                          ]}
                        />
                      </div>

                      <div class="w-full sm:w-36">
                        <label for="wb-weight" class="text-fg-subtle text-xs">Вага, г</label>
                        <input
                          id="wb-weight"
                          name="weightGrams"
                          type="text"
                          inputmode="numeric"
                          value={wv(
                            'weightGrams',
                            weightTotalGrams === null ? '' : String(weightTotalGrams),
                          )}
                          autocomplete="off"
                          class:list={[
                            'admin-field mt-1',
                            waybillInvalid.has('weightGrams') && 'border-danger',
                          ]}
                        />
                      </div>

                      <div class="w-full sm:w-24">
                        <label for="wb-seats" class="text-fg-subtle text-xs">Місць</label>
                        <input
                          id="wb-seats"
                          name="seats"
                          type="text"
                          inputmode="numeric"
                          value={wv('seats', '1')}
                          autocomplete="off"
                          class:list={[
                            'admin-field mt-1',
                            waybillInvalid.has('seats') && 'border-danger',
                          ]}
                        />
                      </div>

                      <div class="w-full sm:w-40">
                        <label for="wb-declared" class="text-fg-subtle text-xs">
                          Оголошена вартість
                        </label>
                        <div class="relative mt-1">
                          <input
                            id="wb-declared"
                            name="declaredValue"
                            type="text"
                            inputmode="numeric"
                            value={wv('declaredValue', String(Math.round(order.itemsTotal / 100)))}
                            autocomplete="off"
                            class:list={[
                              'admin-field pr-10',
                              waybillInvalid.has('declaredValue') && 'border-danger',
                            ]}
                          />
                          <span
                            class="text-fg-subtle pointer-events-none absolute inset-y-0 right-4.5 flex items-center text-base sm:text-sm"
                            aria-hidden="true"
                          >
                            ₴
                          </span>
                        </div>
                      </div>
                    </div>

                    <fieldset class="mt-3">
                      <legend class="text-fg-subtle text-xs">Розміри місця, см</legend>
                      <div class="mt-1 flex flex-wrap gap-3">
                        <div class="w-28">
                          <label for="wb-length" class="text-fg-subtle text-xs">Довжина</label>
                          <input
                            id="wb-length"
                            name="seatLength"
                            type="text"
                            inputmode="numeric"
                            value={wv('seatLength', seatDims ? String(seatDims.length) : '')}
                            autocomplete="off"
                            class:list={[
                              'admin-field mt-1',
                              waybillInvalid.has('seatLength') && 'border-danger',
                            ]}
                          />
                        </div>
                        <div class="w-28">
                          <label for="wb-width" class="text-fg-subtle text-xs">Ширина</label>
                          <input
                            id="wb-width"
                            name="seatWidth"
                            type="text"
                            inputmode="numeric"
                            value={wv('seatWidth', seatDims ? String(seatDims.width) : '')}
                            autocomplete="off"
                            class:list={[
                              'admin-field mt-1',
                              waybillInvalid.has('seatWidth') && 'border-danger',
                            ]}
                          />
                        </div>
                        <div class="w-28">
                          <label for="wb-height" class="text-fg-subtle text-xs">Висота</label>
                          <input
                            id="wb-height"
                            name="seatHeight"
                            type="text"
                            inputmode="numeric"
                            value={wv('seatHeight', seatDims ? String(seatDims.height) : '')}
                            autocomplete="off"
                            class:list={[
                              'admin-field mt-1',
                              waybillInvalid.has('seatHeight') && 'border-danger',
                            ]}
                          />
                        </div>

                        <div class="w-full sm:w-72">
                          <label for="wb-description" class="text-fg-subtle text-xs">
                            Опис вантажу
                          </label>
                          <input
                            id="wb-description"
                            name="description"
                            type="text"
                            maxlength={NP_CARGO_DESCRIPTION_MAX}
                            value={wv('description', npSender?.cargoDescription ?? '')}
                            autocomplete="off"
                            class:list={[
                              'admin-field mt-1',
                              waybillInvalid.has('description') && 'border-danger',
                            ]}
                          />
                        </div>
                      </div>
                    </fieldset>

                    {waybillFieldMessages.length > 0 && (
                      <ul class="text-danger mt-3 space-y-0.5 text-xs">
                        {waybillFieldMessages.map((text) => (
                          <li>{text}</li>
                        ))}
                      </ul>
                    )}

                    <div class="mt-4">
                      <button type="submit" class="admin-btn admin-btn-primary w-full sm:w-auto">
                        Створити ТТН
                      </button>
                    </div>
                    <p class="text-fg-subtle mt-2 text-xs">
                      Створення упакує замовлення. Доставку сплачує одержувач за тарифами
                      перевізника.
                    </p>
                  </form>
                )}
              </>
            ) : (
              <p class="text-fg-subtle mt-2 text-sm">
                ТТН створюється, коли замовлення оплачене або підтверджене.
              </p>
            )}

          </section>
        )}

        {/* -------------------------------------------------------- the goods */}
        <section class="admin-card mt-6 p-5">
          <h2 class="text-fg text-base font-semibold">Товари</h2>

          {/* Snapshotted at order time — never joined back to the catalog
              (`docs/CONVENTIONS.md`), so this is what was actually bought, at
              the price it was actually bought for. */}
          <ul class="divide-border mt-3 divide-y text-sm">
            {order.items.map((item) => (
              <li class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 py-3 first:pt-0">
                <div class="min-w-0">
                  <p class="text-fg">
                    {item.productTitle}
                    {item.variantName && <span class="text-fg-muted"> · {item.variantName}</span>}
                  </p>
                  <p class="text-fg-subtle text-xs">
                    <span class="font-mono">{item.sku}</span> · {item.quantity} ×{' '}
                    {formatPrice(item.unitPrice)}
                  </p>
                </div>
                <p class="text-fg font-medium tabular-nums whitespace-nowrap">
                  {formatPrice(item.lineTotal)}
                </p>
              </li>
            ))}
          </ul>

          {/* `gap-x-4`: at 320px «за тарифами перевізника» wraps, and without a
              gap the wrapped line runs straight into its own term. */}
          <dl class="border-border mt-4 space-y-1 border-t pt-4 text-sm">
            <div class="flex justify-between gap-x-4">
              <dt class="text-fg-muted">Товари</dt>
              <dd class="text-fg tabular-nums whitespace-nowrap">{formatPrice(order.itemsTotal)}</dd>
            </div>
            <div class="flex justify-between gap-x-4">
              <dt class="text-fg-muted shrink-0">Доставка</dt>
              <dd class="text-fg-subtle text-right">за тарифами перевізника</dd>
            </div>
            <div class="text-fg flex justify-between gap-x-4 font-medium">
              <dt>Разом</dt>
              <dd class="tabular-nums whitespace-nowrap">{formatPrice(order.total)}</dd>
            </div>
          </dl>
        </section>
      </div>
    )
  }

  {/*
    Empty until script has something to put in it, and hidden the rest of the
    time by having nothing to lay out. The message it receives is the one
    rendered inside the editor, moved rather than rebuilt.
  */}
  <div id="order-toast" class="admin-toast-host" aria-live="polite" aria-atomic="true"></div>

  <script>
    import { enhanceAdminForms } from '@balier/lib/admin/forms';

    /*
     * The payment link's one purpose is being pasted into a chat, and the
     * `select-all` link covers that with script off. The button ships `hidden`
     * and is revealed here, only when the clipboard API exists — a copy button
     * that renders and then fails would be worse than none. A function rather
     * than top-level statements because every swap by the enhancement layer
     * replaces the button node, listener and all.
     */
    function wireCopyButton() {
      const copyButton = document.getElementById('copy-pay-link');
      if (!(copyButton instanceof HTMLButtonElement) || !navigator.clipboard) return;

      copyButton.hidden = false;

      const idle = copyButton.querySelector<HTMLElement>('[data-copy="idle"]');
      const done = copyButton.querySelector<HTMLElement>('[data-copy="done"]');
      let revert: ReturnType<typeof setTimeout> | undefined;

      copyButton.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(copyButton.dataset.url ?? '');
        } catch {
          /* Clipboard permission refused — the select-all link still works. */
          return;
        }
        if (idle && done) {
          idle.hidden = true;
          done.hidden = false;
          clearTimeout(revert);
          revert = setTimeout(() => {
            idle.hidden = false;
            done.hidden = true;
          }, 2000);
        }
      });
    }

    wireCopyButton();

    const editor = document.getElementById('order-editor');
    const toastHost = document.getElementById('order-toast');

    if (editor && toastHost) {
      enhanceAdminForms({
        root: editor,
        toastHost,
        messageId: 'order-message',
        onRender: wireCopyButton,
      });
    }
  </script>
</AdminLayout>
