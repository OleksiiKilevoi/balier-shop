# Copy to `.dev.vars` and fill in. Read by wrangler for local dev of the cron
# Worker (`pnpm cron:dev`). `.dev.vars` is gitignored — never commit it.
#
# In production these are set with: wrangler secret put <NAME>  (from this dir)

# Neon pooled connection string (EU Frankfurt project)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/balier?sslmode=require"

# Nova Poshta API key — the daily settlement/warehouse sync
NOVAPOSHTA_API_KEY=""

# Monobank Acquiring — the reservation sweep reconciles awaiting_payment
# orders against invoice status before cancelling anything
MONOBANK_TOKEN=""

# Telegram — paid-order notifications the lost webhook would have sent
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
