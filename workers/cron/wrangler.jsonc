{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "balier-cron",
  "main": "./index.ts",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // Two consumers: Cloudflare deminifies its own Workers Logs traces, and
  // `deploy.mjs` finds the emitted `.map` in its `--outdir` to upload the same
  // maps to Sentry (`docs/plans/sentry.md` Phase 3).
  "upload_source_maps": true,
  "triggers": {
    "crons": [
      // Release stock reserved by orders that were never paid, reconcile
      // `awaiting_payment` orders against Monobank before cancelling them,
      // and follow every live waybill's carrier status (NP-4).
      "*/15 * * * *",
      // Refresh the Nova Poshta settlement/warehouse cache.
      "0 4 * * *"
    ]
  },
  // Same binding and address as the site Worker (`apps/site/wrangler.jsonc`):
  // the reconciliation sweep sends the order-paid email the lost webhook would
  // have sent. Fails closed until the Email Sending DNS records exist, exactly
  // like the app's sends.
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    "ORDER_EMAIL_FROM": "noreply@mail.balier.com.ua",
    // Sentry (`docs/plans/sentry.md`) — a DSN is a public project identifier,
    // not a secret. Same single project as the site and admin Workers; the
    // `withSentry` wrapper in `index.ts` tags events `worker:cron`.
    "SENTRY_DSN": "https://10cc802695139cc28dd32cf305de6f34@o4504565189378049.ingest.us.sentry.io/4511881341370368",
    "SENTRY_ENVIRONMENT": "production"
  }
  // Secrets this Worker needs (its own copies — secrets are per-Worker), set
  // with `wrangler secret put <NAME>` from this directory:
  //   DATABASE_URL, NOVAPOSHTA_API_KEY (the sync job) and, for the
  // reservation-sweep reconciliation (added 2026-08-05): MONOBANK_TOKEN,
  // TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID. Without MONOBANK_TOKEN every status
  // check throws and the sweep leaves `awaiting_payment` orders untouched —
  // fail closed, an order is never cancelled on a guess.
}
