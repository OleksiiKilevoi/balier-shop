{
  "name": "balier",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "pnpm --filter @balier/site run dev",
    "dev:site": "pnpm --filter @balier/site run dev",
    "dev:admin": "pnpm --filter @balier/admin run dev",
    "check": "pnpm -r run check",
    "build": "pnpm -r run build",
    "test": "pnpm --filter @balier/lib run test",
    "test:watch": "pnpm --filter @balier/lib run test:watch",
    "deploy:site": "pnpm --filter @balier/site run deploy",
    "deploy:admin": "pnpm --filter @balier/admin run deploy",
    "cf-typegen": "pnpm -r run cf-typegen",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "admin:user": "tsx scripts/admin-user.ts",
    "metrics": "tsx scripts/metrics.ts",
    "media:ingest": "tsx scripts/ingest-images.ts",
    "media:push": "tsx scripts/media-push.ts",
    "np:sync": "tsx scripts/sync-novaposhta.ts",
    "tg:webhook": "tsx scripts/telegram-webhook.ts",
    "cron:dev": "pnpm --filter @balier/cron run dev",
    "cron:deploy": "pnpm --filter @balier/cron run deploy"
  },
  "dependencies": {
    "@balier/lib": "workspace:*",
    "@neon/config": "^1.3.0",
    "@neon/env": "^1.2.1",
    "@neondatabase/serverless": "^1.1.0",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.135.0"
  }
}
