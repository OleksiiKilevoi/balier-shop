---
import { env } from 'cloudflare:workers';
import OrderStatusBadge from '~/components/admin/OrderStatusBadge.astro';
import AdminLayout from '~/layouts/AdminLayout.astro';
import { createDb, createTxDb } from '~/lib/db';
import { findAdminOrder } from '~/lib/db/queries/orders';
import {
  ADMIN_ORDER_MESSAGES,
  ORDER_REVERT_FROM_REFUNDED_WARNING,
  ORDER_REVERT_HINTS,
  ORDER_REVERT_LABELS,
  ORDER_REVERT_PAYMENT_WARNING,
  ORDER_STATUS_LABELS,
  ORDER_TRANSITION_HINTS,
  ORDER_TRANSITION_LABELS,
  formatAdminDateTime,
} from '~/lib/i18n/admin';
import type { AdminOrderMessage } from '~/lib/i18n/admin';
import { formatPrice } from '~/lib/money';
import { DELIVERY_METHOD_LABELS, PAYMENT_METHOD_LABELS, deliveryDestination } from '~/lib/notify/format';
import { allowedTransitions, revertCrossesPayment, revertTarget } from '~/lib/orders/status';
import { setOrderTrackingNumber, updateOrderStatus } from '~/lib/orders/updateStatus';
import { TRACKING_NUMBER_LENGTH, adminOrderActionSchema } from '~/lib/validation/admin';

/**
 * One order: what it is, and the two things an operator may do to it — move it
 * along the state machine, and record the Nova Poshta tracking number.
 *
 * Both are plain form POSTs back to this same URL, answered with a 303 to it.
 * Post/redirect/get, so a refresh after acting re-reads the order instead of
 * re-firing the action, and the whole page needs no client-side script.
 */
export const prerender = false;

const orderNumber = Astro.params.orderNumber!;
const selfUrl = `/admin/orders/${encodeURIComponent(orderNumber)}`;

function done(message: AdminOrderMessage): Response {
  return Astro.redirect(`${selfUrl}?m=${message}`, 303);
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const parsed = adminOrderActionSchema.safeParse(Object.fromEntries(form));

  if (!parsed.success) {
    const invalidTtn = parsed.error.issues.some(
      (issue) => issue.message === 'invalid_tracking_number',
    );
    return done(invalidTtn ? 'invalid_tracking_number' : 'bad_request');
  }

  if (parsed.data.intent === 'ttn') {
    const updated = await setOrderTrackingNumber(
      createDb(env.DATABASE_URL),
      orderNumber,
      parsed.data.ttn,
    );
    if (!updated) return new Response('Замовлення не знайдено', { status: 404 });
    return done(parsed.data.ttn ? 'ttn_updated' : 'ttn_cleared');
  }

  const { db: txDb, close } = createTxDb(env.DATABASE_URL);
  try {
    const result = await updateOrderStatus(txDb, {
      orderNumber,
      from: parsed.data.from,
      next: parsed.data.next,
    });

    if (result.ok) return done('status_updated');
    if (result.reason === 'not_found') {
      return new Response('Замовлення не знайдено', { status: 404 });
    }
    return done(result.reason);
  } finally {
    Astro.locals.cfContext.waitUntil(close());
  }
}

const order = await findAdminOrder(createDb(env.DATABASE_URL), orderNumber);

if (!order) Astro.response.status = 404;

const messageParam = Astro.url.searchParams.get('m');
const message =
  messageParam && messageParam in ADMIN_ORDER_MESSAGES
    ? (messageParam as AdminOrderMessage)
    : null;

/** The keys that report a refusal rather than a success. */
const FAILURES = new Set<AdminOrderMessage>([
  'invalid_transition',
  'insufficient_stock',
  'stale',
  'invalid_tracking_number',
  'bad_request',
]);

const transitions = order ? allowedTransitions(order) : [];
const revert = order ? revertTarget(order) : null;
const forward = transitions.filter(
  (next) => next !== 'cancelled' && next !== 'refunded' && next !== revert,
);
const exits = transitions.filter((next) => next === 'cancelled' || next === 'refunded');
const revertWarning = order && revert && revertCrossesPayment(order) ? ORDER_REVERT_PAYMENT_WARNING : null;
const revertFromRefundedWarning =
  order && revert && order.status === 'refunded' ? ORDER_REVERT_FROM_REFUNDED_WARNING : null;
/**
 * Undoing `cancelled`/`refunded` re-decrements stock and can fail — a real
 * side effect, unlike the plain forward-chain revert — so it gets the same
 * two-click disclosure gate as the exits it undoes, rather than sitting next
 * to the ungated `packed`/`shipped`/`delivered` revert button.
 */
const leavingTerminal = order?.status === 'cancelled' || order?.status === 'refunded';
---

<AdminLayout title={order ? `Замовлення ${order.orderNumber}` : 'Замовлення не знайдено'}>
  <a href="/admin/orders" class="text-fg-muted hover:text-fg text-sm">← До списку</a>

  {
    !order ? (
      <p class="text-fg mt-6">Замовлення «{orderNumber}» не знайдено.</p>
    ) : (
      <>
        <header class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-2">
          <h1 class="text-fg font-mono text-2xl font-semibold sm:text-3xl">
            {order.orderNumber}
          </h1>
          <OrderStatusBadge status={order.status} />
        </header>
        <p class="text-fg-subtle mt-1 text-sm">
          Створено {formatAdminDateTime(order.createdAt)}
          {order.paidAt && <> · оплачено {formatAdminDateTime(order.paidAt)}</>}
          {order.cancelledAt && <> · скасовано {formatAdminDateTime(order.cancelledAt)}</>}
        </p>

        {/* A refusal is the only thing that earns colour on this page — the
            successes are confirmed by the row itself having changed. */}
        {message && (
          <p
            role="status"
            class:list={[
              'rounded-card mt-5 p-3 text-sm',
              FAILURES.has(message)
                ? 'admin-tone-negative'
                : 'admin-card text-fg-muted',
            ]}
          >
            {ADMIN_ORDER_MESSAGES[message]}
          </p>
        )}

        {/* ------------------------------------------------------- actions */}
        <section class="admin-card mt-6 p-5">
          <h2 class="text-fg text-base font-semibold">Статус</h2>
          <p class="text-fg-muted mt-1 text-sm">
            Зараз: <strong class="text-fg font-medium">{ORDER_STATUS_LABELS[order.status]}</strong>
          </p>

          {transitions.length === 0 ? (
            <p class="text-fg-subtle mt-2 text-sm">
              Замовлення завершене — далі статус не змінюється.
            </p>
          ) : (
            <>
              {forward.map((next) => (
                <form method="post" action={selfUrl} class="mt-3">
                  <input type="hidden" name="intent" value="status" />
                  {/* The status this page was rendered from: the server refuses
                      the move if the row has changed since, so a stale tab
                      cannot fire a transition nobody chose. */}
                  <input type="hidden" name="from" value={order.status} />
                  <input type="hidden" name="next" value={next} />
                  <button type="submit" class="admin-btn admin-btn-primary w-full sm:w-auto">
                    {ORDER_TRANSITION_LABELS[next]}
                  </button>
                </form>
              ))}

              {/* Undoing a wrong click, not a sale — no stock or reservation
                  moves, so unlike the exits below this needs no disclosure
                  gate. Only ever rendered here for `packed`/`shipped`/
                  `delivered`; leaving `cancelled`/`refunded` renders its own
                  gated form below instead (`leavingTerminal`). */}
              {revert && !leavingTerminal && (
                <form method="post" action={selfUrl} class="mt-3">
                  <input type="hidden" name="intent" value="status" />
                  <input type="hidden" name="from" value={order.status} />
                  <input type="hidden" name="next" value={revert} />
                  {ORDER_REVERT_HINTS[revert] && (
                    <p class="text-fg-subtle mb-2 text-sm">{ORDER_REVERT_HINTS[revert]}</p>
                  )}
                  {revertWarning && (
                    <p class="text-fg-subtle mb-2 text-sm">{revertWarning}</p>
                  )}
                  <button type="submit" class="admin-btn admin-btn-secondary w-full sm:w-auto">
                    {ORDER_REVERT_LABELS[revert]}
                  </button>
                </form>
              )}

              {/* A disclosure rather than a confirm dialog: these are terminal
                  (or undo a terminal state, which re-touches stock the same way
                  exiting it did) and there is no script on this page. Two
                  deliberate clicks. */}
              {(exits.length > 0 || (revert && leavingTerminal)) && (
                <details class="border-border mt-4 border-t pt-4">
                  <summary class="text-fg-muted hover:text-fg min-h-touch flex cursor-pointer items-center text-sm">
                    Інші дії
                  </summary>
                  {revert && leavingTerminal && (
                    <form method="post" action={selfUrl} class="mt-3">
                      <input type="hidden" name="intent" value="status" />
                      <input type="hidden" name="from" value={order.status} />
                      <input type="hidden" name="next" value={revert} />
                      {ORDER_REVERT_HINTS[revert] && (
                        <p class="text-fg-subtle mb-2 text-sm">{ORDER_REVERT_HINTS[revert]}</p>
                      )}
                      {revertFromRefundedWarning && (
                        <p class="text-fg-subtle mb-2 text-sm">{revertFromRefundedWarning}</p>
                      )}
                      {/* Secondary, not danger: this one *undoes* a terminal
                          state. It shares the disclosure with the exits because
                          it moves stock, not because it is destructive. */}
                      <button type="submit" class="admin-btn admin-btn-secondary w-full sm:w-auto">
                        {ORDER_REVERT_LABELS[revert]}
                      </button>
                    </form>
                  )}
                  {exits.map((next) => (
                    <form method="post" action={selfUrl} class="mt-3">
                      <input type="hidden" name="intent" value="status" />
                      <input type="hidden" name="from" value={order.status} />
                      <input type="hidden" name="next" value={next} />
                      {ORDER_TRANSITION_HINTS[next] && (
                        <p class="text-fg-subtle mb-2 text-sm">{ORDER_TRANSITION_HINTS[next]}</p>
                      )}
                      <button type="submit" class="admin-btn admin-btn-danger w-full sm:w-auto">
                        {ORDER_TRANSITION_LABELS[next]}
                      </button>
                    </form>
                  ))}
                </details>
              )}
            </>
          )}
        </section>

        {/* ------------------------------------------------- customer, delivery */}
        <div class="mt-6 grid gap-6 md:grid-cols-2">
          <section class="admin-card p-5">
            <h2 class="text-fg text-base font-semibold">Клієнт</h2>
            <dl class="mt-3 space-y-2 text-sm">
              <div>
                <dt class="text-fg-subtle text-xs">Ім’я</dt>
                <dd class="text-fg">{order.customerName}</dd>
              </div>
              <div>
                <dt class="text-fg-subtle text-xs">Телефон</dt>
                <dd class="text-fg">
                  <a href={`tel:${order.customerPhone}`} class="underline-offset-2 hover:underline">
                    {order.customerPhone}
                  </a>
                </dd>
              </div>
              {order.customerEmail && (
                <div>
                  <dt class="text-fg-subtle text-xs">Email</dt>
                  <dd class="text-fg">
                    <a
                      href={`mailto:${order.customerEmail}`}
                      class="underline-offset-2 hover:underline"
                    >
                      {order.customerEmail}
                    </a>
                  </dd>
                </div>
              )}
              {order.comment && (
                <div>
                  <dt class="text-fg-subtle text-xs">Коментар</dt>
                  <dd class="text-fg whitespace-pre-line">{order.comment}</dd>
                </div>
              )}
            </dl>
          </section>

          <section class="admin-card p-5">
            <h2 class="text-fg text-base font-semibold">Доставка й оплата</h2>
            <dl class="mt-3 space-y-2 text-sm">
              <div>
                <dt class="text-fg-subtle text-xs">Спосіб доставки</dt>
                <dd class="text-fg">{DELIVERY_METHOD_LABELS[order.deliveryMethod]}</dd>
              </div>
              <div>
                <dt class="text-fg-subtle text-xs">Куди</dt>
                <dd class="text-fg">{deliveryDestination(order)}</dd>
              </div>
              <div>
                <dt class="text-fg-subtle text-xs">Оплата</dt>
                <dd class="text-fg">{PAYMENT_METHOD_LABELS[order.paymentMethod]}</dd>
              </div>
              {order.payments.map((payment) => (
                <div>
                  <dt class="text-fg-subtle text-xs">Monobank</dt>
                  <dd class="text-fg">
                    {payment.status} · {formatPrice(payment.amount)}
                    <span class="text-fg-subtle block font-mono text-xs break-all">
                      {payment.invoiceId}
                    </span>
                  </dd>
                </div>
              ))}
            </dl>

            {/* The tracking number is a *value* until someone asks to change it.
                A live input alongside read-only fields reads as something that
                still needs filling in, and invites an accidental edit of a
                number the carrier already has.

                Not a `<details>`, unlike «Інші дії» above: a `<summary>` toggles
                on a click *anywhere* inside itself, so the number could not sit
                in it and still be selectable — every attempt to copy it would
                open the editor instead. A checkbox carries the toggle alone, the
                number lives outside it, and `group-has-[:checked]` reveals the
                form. Still no script on the page. */}
            <div class="border-border group mt-4 border-t pt-4">
              {/* The label is its own line: at 320px it wraps to two, and in the
                  row below it would push the button between the label and the
                  value it belongs to. */}
              <p class="text-fg-subtle text-xs">Номер накладної Нової Пошти</p>

              <div class="min-h-touch flex items-center gap-x-4">
                {/* `select-all`: one click takes the whole number, which is the
                    only reason to touch it without editing. */}
                <span class="text-fg min-w-0 font-mono text-sm break-all select-all">
                  {order.npTtn ?? <span class="text-fg-subtle font-sans select-none">—</span>}
                </span>
                {/* `ml-auto` rather than `justify-between` on the row: it keeps
                    the button at the right edge whatever the value's width. The
                    checkbox is `sr-only`, not hidden, so it stays keyboard
                    reachable — and since the global `:focus-visible` outline
                    would then land on a clipped 1px box, the ring is drawn on
                    this label instead. */}
                <label class="text-fg-muted hover:text-fg has-[:focus-visible]:outline-fg-subtle ml-auto shrink-0 cursor-pointer rounded-full text-sm underline underline-offset-2 has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2">
                  {/* Checked from the server when the last attempt was rejected,
                      so the correction happens where the error message points. */}
                  <input
                    type="checkbox"
                    class="sr-only"
                    checked={message === 'invalid_tracking_number'}
                  />
                  <span class="group-has-[:checked]:hidden">
                    {order.npTtn ? 'Змінити' : 'Додати'}
                  </span>
                  <span class="hidden group-has-[:checked]:inline">Згорнути</span>
                </label>
              </div>

              <form
                method="post"
                action={selfUrl}
                class="group-has-[:checked]:block mt-1 hidden"
              >
                <input type="hidden" name="intent" value="ttn" />
                <label for="ttn" class="sr-only">Номер накладної Нової Пошти</label>
                <div class="flex flex-col gap-2 sm:flex-row">
                  <input
                    id="ttn"
                    name="ttn"
                    type="text"
                    maxlength="14"
                    inputmode="numeric"
                    value={order.npTtn ?? ''}
                    placeholder={'0'.repeat(TRACKING_NUMBER_LENGTH)}
                    autocomplete="off"
                    class="admin-field font-mono sm:flex-1"
                  />
                  <button type="submit" class="admin-btn admin-btn-primary shrink-0">
                    Зберегти
                  </button>
                </div>
                <p class="text-fg-subtle mt-2 text-xs">
                  {TRACKING_NUMBER_LENGTH} цифр. Порожнє поле видаляє номер.
                </p>
              </form>
            </div>
          </section>
        </div>

        {/* -------------------------------------------------------- the goods */}
        <section class="admin-card mt-6 p-5">
          <h2 class="text-fg text-base font-semibold">Товари</h2>

          {/* Snapshotted at order time — never joined back to the catalog
              (`docs/CONVENTIONS.md`), so this is what was actually bought, at
              the price it was actually bought for. */}
          <ul class="divide-border mt-3 divide-y text-sm">
            {order.items.map((item) => (
              <li class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 py-3 first:pt-0">
                <div class="min-w-0">
                  <p class="text-fg">
                    {item.productTitle}
                    {item.variantName && <span class="text-fg-muted"> · {item.variantName}</span>}
                  </p>
                  <p class="text-fg-subtle text-xs">
                    <span class="font-mono">{item.sku}</span> · {item.quantity} ×{' '}
                    {formatPrice(item.unitPrice)}
                  </p>
                </div>
                <p class="text-fg font-medium tabular-nums whitespace-nowrap">
                  {formatPrice(item.lineTotal)}
                </p>
              </li>
            ))}
          </ul>

          {/* `gap-x-4`: at 320px «за тарифами перевізника» wraps, and without a
              gap the wrapped line runs straight into its own term. */}
          <dl class="border-border mt-4 space-y-1 border-t pt-4 text-sm">
            <div class="flex justify-between gap-x-4">
              <dt class="text-fg-muted">Товари</dt>
              <dd class="text-fg tabular-nums whitespace-nowrap">{formatPrice(order.itemsTotal)}</dd>
            </div>
            <div class="flex justify-between gap-x-4">
              <dt class="text-fg-muted shrink-0">Доставка</dt>
              <dd class="text-fg-subtle text-right">за тарифами перевізника</dd>
            </div>
            <div class="text-fg flex justify-between gap-x-4 font-medium">
              <dt>Разом</dt>
              <dd class="tabular-nums whitespace-nowrap">{formatPrice(order.total)}</dd>
            </div>
          </dl>
        </section>
      </>
    )
  }
</AdminLayout>
