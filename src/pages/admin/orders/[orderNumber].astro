---
import { env } from 'cloudflare:workers';
import OrderStatusBadge from '~/components/admin/OrderStatusBadge.astro';
import AdminLayout from '~/layouts/AdminLayout.astro';
import { createDb, createTxDb } from '~/lib/db';
import { findAdminOrder } from '~/lib/db/queries/orders';
import {
  ADMIN_ORDER_MESSAGES,
  ORDER_REVERT_LABELS,
  ORDER_REVERT_PAYMENT_WARNING,
  ORDER_STATUS_LABELS,
  ORDER_TRANSITION_HINTS,
  ORDER_TRANSITION_LABELS,
  formatAdminDateTime,
} from '~/lib/i18n/admin';
import type { AdminOrderMessage } from '~/lib/i18n/admin';
import { formatPrice } from '~/lib/money';
import { DELIVERY_METHOD_LABELS, PAYMENT_METHOD_LABELS, deliveryDestination } from '~/lib/notify/format';
import { allowedTransitions, revertCrossesPayment, revertTarget } from '~/lib/orders/status';
import { setOrderTrackingNumber, updateOrderStatus } from '~/lib/orders/updateStatus';
import { TRACKING_NUMBER_LENGTH, adminOrderActionSchema } from '~/lib/validation/admin';

/**
 * One order: what it is, and the two things an operator may do to it — move it
 * along the state machine, and record the Nova Poshta tracking number.
 *
 * Both are plain form POSTs back to this same URL, answered with a 303 to it.
 * Post/redirect/get, so a refresh after acting re-reads the order instead of
 * re-firing the action, and the whole page needs no client-side script.
 */
export const prerender = false;

const orderNumber = Astro.params.orderNumber!;
const selfUrl = `/admin/orders/${encodeURIComponent(orderNumber)}`;

function done(message: AdminOrderMessage): Response {
  return Astro.redirect(`${selfUrl}?m=${message}`, 303);
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const parsed = adminOrderActionSchema.safeParse(Object.fromEntries(form));

  if (!parsed.success) {
    const invalidTtn = parsed.error.issues.some(
      (issue) => issue.message === 'invalid_tracking_number',
    );
    return done(invalidTtn ? 'invalid_tracking_number' : 'bad_request');
  }

  if (parsed.data.intent === 'ttn') {
    const updated = await setOrderTrackingNumber(
      createDb(env.DATABASE_URL),
      orderNumber,
      parsed.data.ttn,
    );
    if (!updated) return new Response('Замовлення не знайдено', { status: 404 });
    return done(parsed.data.ttn ? 'ttn_updated' : 'ttn_cleared');
  }

  const { db: txDb, close } = createTxDb(env.DATABASE_URL);
  try {
    const result = await updateOrderStatus(txDb, {
      orderNumber,
      from: parsed.data.from,
      next: parsed.data.next,
    });

    if (result.ok) return done('status_updated');
    if (result.reason === 'not_found') {
      return new Response('Замовлення не знайдено', { status: 404 });
    }
    return done(result.reason === 'stale' ? 'stale' : 'invalid_transition');
  } finally {
    Astro.locals.cfContext.waitUntil(close());
  }
}

const order = await findAdminOrder(createDb(env.DATABASE_URL), orderNumber);

if (!order) Astro.response.status = 404;

const messageParam = Astro.url.searchParams.get('m');
const message =
  messageParam && messageParam in ADMIN_ORDER_MESSAGES
    ? (messageParam as AdminOrderMessage)
    : null;

/** The keys that report a refusal rather than a success. */
const FAILURES = new Set<AdminOrderMessage>([
  'invalid_transition',
  'stale',
  'invalid_tracking_number',
  'bad_request',
]);

const transitions = order ? allowedTransitions(order) : [];
const revert = order ? revertTarget(order.status) : null;
const forward = transitions.filter(
  (next) => next !== 'cancelled' && next !== 'refunded' && next !== revert,
);
const exits = transitions.filter((next) => next === 'cancelled' || next === 'refunded');
const revertWarning = order && revert && revertCrossesPayment(order) ? ORDER_REVERT_PAYMENT_WARNING : null;
---

<AdminLayout title={order ? `Замовлення ${order.orderNumber}` : 'Замовлення не знайдено'}>
  <a href="/admin/orders" class="text-ink-muted hover:text-ink text-sm">← До списку</a>

  {
    !order ? (
      <p class="text-ink mt-6">Замовлення «{orderNumber}» не знайдено.</p>
    ) : (
      <>
        <header class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-2">
          <h1 class="font-display text-ink text-2xl font-bold sm:text-3xl">
            {order.orderNumber}
          </h1>
          <OrderStatusBadge status={order.status} />
        </header>
        <p class="text-ink-muted mt-1 text-sm">
          Створено {formatAdminDateTime(order.createdAt)}
          {order.paidAt && <> · оплачено {formatAdminDateTime(order.paidAt)}</>}
          {order.cancelledAt && <> · скасовано {formatAdminDateTime(order.cancelledAt)}</>}
        </p>

        {message && (
          <p
            role="status"
            class:list={[
              'rounded-card mt-5 border p-3 text-sm',
              FAILURES.has(message)
                ? 'border-brand text-brand bg-paper-raised'
                : 'border-line bg-paper-raised text-ink-soft',
            ]}
          >
            {ADMIN_ORDER_MESSAGES[message]}
          </p>
        )}

        {/* ------------------------------------------------------- actions */}
        <section class="border-line bg-paper-raised rounded-card mt-6 border p-5">
          <h2 class="font-display text-ink text-lg font-bold">Статус</h2>
          <p class="text-ink-muted mt-1 text-sm">
            Зараз: <strong class="text-ink-soft">{ORDER_STATUS_LABELS[order.status]}</strong>
          </p>

          {transitions.length === 0 ? (
            <p class="text-ink-muted mt-2 text-sm">
              Замовлення завершене — далі статус не змінюється.
            </p>
          ) : (
            <>
              {forward.map((next) => (
                <form method="post" action={selfUrl} class="mt-3">
                  <input type="hidden" name="intent" value="status" />
                  {/* The status this page was rendered from: the server refuses
                      the move if the row has changed since, so a stale tab
                      cannot fire a transition nobody chose. */}
                  <input type="hidden" name="from" value={order.status} />
                  <input type="hidden" name="next" value={next} />
                  <button
                    type="submit"
                    class="bg-brand hover:bg-brand-hover rounded-btn h-touch w-full cursor-pointer px-6 text-sm font-medium text-white sm:w-auto"
                  >
                    {ORDER_TRANSITION_LABELS[next]}
                  </button>
                </form>
              ))}

              {/* Undoing a wrong click, not a sale — no stock or reservation
                  moves either way (see `revertTarget`'s doc), so unlike the
                  exits below this needs no disclosure gate. */}
              {revert && (
                <form method="post" action={selfUrl} class="mt-3">
                  <input type="hidden" name="intent" value="status" />
                  <input type="hidden" name="from" value={order.status} />
                  <input type="hidden" name="next" value={revert} />
                  {revertWarning && (
                    <p class="text-ink-muted mb-2 text-sm">{revertWarning}</p>
                  )}
                  <button
                    type="submit"
                    class="border-line-strong text-ink hover:border-ink rounded-btn h-touch w-full cursor-pointer border px-6 text-sm font-medium sm:w-auto"
                  >
                    {ORDER_REVERT_LABELS[revert]}
                  </button>
                </form>
              )}

              {/* A disclosure rather than a confirm dialog: these are terminal
                  and there is no script on this page. Two deliberate clicks. */}
              {exits.length > 0 && (
                <details class="border-line mt-4 border-t pt-4">
                  <summary class="text-ink-muted hover:text-ink min-h-touch flex cursor-pointer items-center text-sm">
                    Інші дії
                  </summary>
                  {exits.map((next) => (
                    <form method="post" action={selfUrl} class="mt-3">
                      <input type="hidden" name="intent" value="status" />
                      <input type="hidden" name="from" value={order.status} />
                      <input type="hidden" name="next" value={next} />
                      {ORDER_TRANSITION_HINTS[next] && (
                        <p class="text-ink-muted mb-2 text-sm">{ORDER_TRANSITION_HINTS[next]}</p>
                      )}
                      <button
                        type="submit"
                        class="border-line-strong text-ink hover:border-ink rounded-btn h-touch w-full cursor-pointer border px-6 text-sm font-medium sm:w-auto"
                      >
                        {ORDER_TRANSITION_LABELS[next]}
                      </button>
                    </form>
                  ))}
                </details>
              )}
            </>
          )}
        </section>

        {/* ------------------------------------------------- customer, delivery */}
        <div class="mt-6 grid gap-6 md:grid-cols-2">
          <section class="border-line bg-paper-raised rounded-card border p-5">
            <h2 class="font-display text-ink text-lg font-bold">Клієнт</h2>
            <dl class="mt-3 space-y-2 text-sm">
              <div>
                <dt class="text-ink-muted">Ім’я</dt>
                <dd class="text-ink">{order.customerName}</dd>
              </div>
              <div>
                <dt class="text-ink-muted">Телефон</dt>
                <dd class="text-ink">
                  <a href={`tel:${order.customerPhone}`} class="underline-offset-2 hover:underline">
                    {order.customerPhone}
                  </a>
                </dd>
              </div>
              {order.customerEmail && (
                <div>
                  <dt class="text-ink-muted">Email</dt>
                  <dd class="text-ink">
                    <a
                      href={`mailto:${order.customerEmail}`}
                      class="underline-offset-2 hover:underline"
                    >
                      {order.customerEmail}
                    </a>
                  </dd>
                </div>
              )}
              {order.comment && (
                <div>
                  <dt class="text-ink-muted">Коментар</dt>
                  <dd class="text-ink whitespace-pre-line">{order.comment}</dd>
                </div>
              )}
            </dl>
          </section>

          <section class="border-line bg-paper-raised rounded-card border p-5">
            <h2 class="font-display text-ink text-lg font-bold">Доставка й оплата</h2>
            <dl class="mt-3 space-y-2 text-sm">
              <div>
                <dt class="text-ink-muted">Спосіб доставки</dt>
                <dd class="text-ink">{DELIVERY_METHOD_LABELS[order.deliveryMethod]}</dd>
              </div>
              <div>
                <dt class="text-ink-muted">Куди</dt>
                <dd class="text-ink">{deliveryDestination(order)}</dd>
              </div>
              <div>
                <dt class="text-ink-muted">Оплата</dt>
                <dd class="text-ink">{PAYMENT_METHOD_LABELS[order.paymentMethod]}</dd>
              </div>
              {order.payments.map((payment) => (
                <div>
                  <dt class="text-ink-muted">Monobank</dt>
                  <dd class="text-ink">
                    {payment.status} · {formatPrice(payment.amount)}
                    <span class="text-ink-muted block text-xs break-all">
                      {payment.invoiceId}
                    </span>
                  </dd>
                </div>
              ))}
            </dl>

            <form method="post" action={selfUrl} class="border-line mt-4 border-t pt-4">
              <input type="hidden" name="intent" value="ttn" />
              <label for="ttn" class="text-ink-muted block text-sm">
                Номер накладної Нової Пошти
              </label>
              <div class="mt-2 flex flex-col gap-2 sm:flex-row">
                <input
                  id="ttn"
                  name="ttn"
                  type="text"
                  inputmode="numeric"
                  value={order.npTtn ?? ''}
                  placeholder={'0'.repeat(TRACKING_NUMBER_LENGTH)}
                  autocomplete="off"
                  class="border-line-strong bg-paper-raised text-ink placeholder:text-ink-muted rounded-btn h-touch w-full min-w-0 appearance-none border px-4 text-base sm:flex-1 sm:text-sm"
                />
                <button
                  type="submit"
                  class="border-line-strong text-ink hover:border-ink rounded-btn h-touch shrink-0 cursor-pointer border px-6 text-sm font-medium sm:w-auto"
                >
                  Зберегти
                </button>
              </div>
              <p class="text-ink-muted mt-2 text-xs">
                {TRACKING_NUMBER_LENGTH} цифр. Порожнє поле видаляє номер.
              </p>
            </form>
          </section>
        </div>

        {/* -------------------------------------------------------- the goods */}
        <section class="border-line bg-paper-raised rounded-card mt-6 border p-5">
          <h2 class="font-display text-ink text-lg font-bold">Товари</h2>

          {/* Snapshotted at order time — never joined back to the catalog
              (`docs/CONVENTIONS.md`), so this is what was actually bought, at
              the price it was actually bought for. */}
          <ul class="mt-3 divide-line divide-y text-sm">
            {order.items.map((item) => (
              <li class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 py-3 first:pt-0">
                <div class="min-w-0">
                  <p class="text-ink">
                    {item.productTitle}
                    {item.variantName && <span class="text-ink-muted"> · {item.variantName}</span>}
                  </p>
                  <p class="text-ink-muted text-xs">
                    {item.sku} · {item.quantity} × {formatPrice(item.unitPrice)}
                  </p>
                </div>
                <p class="text-ink font-medium whitespace-nowrap">{formatPrice(item.lineTotal)}</p>
              </li>
            ))}
          </ul>

          {/* `gap-x-4`: at 320px «за тарифами перевізника» wraps, and without a
              gap the wrapped line runs straight into its own term. */}
          <dl class="border-line mt-4 space-y-1 border-t pt-4 text-sm">
            <div class="flex justify-between gap-x-4">
              <dt class="text-ink-muted">Товари</dt>
              <dd class="text-ink whitespace-nowrap">{formatPrice(order.itemsTotal)}</dd>
            </div>
            <div class="flex justify-between gap-x-4">
              <dt class="text-ink-muted shrink-0">Доставка</dt>
              <dd class="text-ink-muted text-right">за тарифами перевізника</dd>
            </div>
            <div class="text-ink flex justify-between gap-x-4 font-medium">
              <dt>Разом</dt>
              <dd class="whitespace-nowrap">{formatPrice(order.total)}</dd>
            </div>
          </dl>
        </section>
      </>
    )
  }
</AdminLayout>
