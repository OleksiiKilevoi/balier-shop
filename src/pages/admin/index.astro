---
import AdminLayout from '~/layouts/AdminLayout.astro';

/**
 * Home of the panel. Orders are built; products, images and the
 * cash-on-delivery limit are the remaining Phase 4 items.
 */
export const prerender = false;

const admin = Astro.locals.admin;
---

<AdminLayout title="Панель">
  <h1 class="font-display text-ink text-2xl font-bold sm:text-3xl">Панель керування</h1>

  <p class="text-ink-muted mt-2">
    Ви увійшли як <strong class="text-ink-soft">{admin?.email ?? 'сервісний токен'}</strong>.
  </p>

  <div class="border-line bg-paper-raised rounded-card mt-8 border p-5">
    <h2 class="font-display text-ink text-lg font-bold">Розділи</h2>
    <ul class="mt-2 space-y-1">
      <li>
        <a href="/admin/orders" class="text-ink underline-offset-2 hover:underline">Замовлення</a>
      </li>
    </ul>

    <h2 class="font-display text-ink mt-5 text-lg font-bold">Далі</h2>
    <ul class="text-ink-muted mt-2 list-disc space-y-1 pl-5">
      <li>Товари та зображення</li>
      <li>Ліміт післяплати</li>
    </ul>
  </div>
</AdminLayout>
