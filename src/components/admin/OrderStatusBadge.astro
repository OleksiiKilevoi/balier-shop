---
import type { OrderStatus } from '~/lib/db/schema';
import { ORDER_STATUS_LABELS } from '~/lib/i18n/admin';

/**
 * The order's status, scannable down a list.
 *
 * There is no admin mockup and no state palette in `global.css`, so this reads
 * on weight rather than on invented colour: the two statuses that need an
 * operator now are solid, the ones in progress are outlined, and the two dead
 * ends are faded back. Nothing here introduces a colour value.
 */

interface Props {
  status: OrderStatus;
  class?: string;
}

const { status, class: className } = Astro.props;

const TONES: Record<OrderStatus, string> = {
  // Needs attention: money has landed, or is still expected.
  paid: 'bg-espresso text-paper',
  confirmed: 'bg-espresso text-paper',
  awaiting_payment: 'bg-tag text-tag-ink',
  pending: 'bg-tag text-tag-ink',
  // In progress.
  packed: 'border border-line-strong text-ink-soft',
  shipped: 'border border-line-strong text-ink-soft',
  // Done, either way.
  delivered: 'border border-line text-ink-muted',
  cancelled: 'border border-line text-ink-muted line-through',
  refunded: 'border border-line text-ink-muted line-through',
};
---

<span
  class:list={[
    'inline-flex items-center rounded-btn px-2 py-0.5 text-xs font-medium whitespace-nowrap',
    TONES[status],
    className,
  ]}
>
  {ORDER_STATUS_LABELS[status]}
</span>
