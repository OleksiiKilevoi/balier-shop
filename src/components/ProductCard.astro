---
import Price from './Price.astro';
import type { Kopiykas } from '~/lib/money';

interface Props {
  slug: string;
  title: string;
  /** Category name, shown under the title. */
  category?: string | null;
  price: Kopiykas;
  compareAtPrice?: Kopiykas | null;
  imageUrl?: string | null;
  imageAlt?: string | null;
  /** Colour swatches, rendered only when the product genuinely has a choice. */
  swatches?: readonly { name: string; hex: string | null }[];
  soldOut?: boolean;
  /** Set on the first row of the grid so the LCP image is not lazy. */
  eager?: boolean;
}

const {
  slug,
  title,
  category,
  price,
  compareAtPrice,
  imageUrl,
  imageAlt,
  swatches = [],
  soldOut = false,
  eager = false,
} = Astro.props;
---

<article
  class="border-line bg-paper-raised rounded-card group overflow-hidden border transition-shadow hover:shadow-md"
>
  <a href={`/products/${slug}`} class="block">
    <div class="bg-line/50 relative aspect-square overflow-hidden">
      {
        imageUrl ? (
          <img
            src={imageUrl}
            alt={imageAlt ?? title}
            loading={eager ? 'eager' : 'lazy'}
            fetchpriority={eager ? 'high' : undefined}
            decoding="async"
            class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
          />
        ) : (
          <div class="text-ink-muted flex h-full w-full items-center justify-center text-xs">
            Фото незабаром
          </div>
        )
      }
      {/* 17 characters do not fit on one 12px line inside a 320px two-column card,
          and a wrapped pill reads as a broken badge — so the badge shrinks instead. */}
      {
        soldOut && (
          <span class="bg-paper/95 text-ink absolute top-2 left-2 rounded-full px-2 py-0.5 text-[0.625rem] whitespace-nowrap sm:top-3 sm:left-3 sm:px-2.5 sm:py-1 sm:text-xs">
            Немає в наявності
          </span>
        )
      }
    </div>

    {/* A two-column phone grid leaves ~135px per card at 320px, so the padding
        and the title step down rather than eating the line. */}
    <div class="space-y-1 p-3 sm:p-4">
      <h3 class="font-display text-ink text-base leading-snug font-bold sm:text-lg">{title}</h3>
      {category && <p class="text-ink-muted text-xs sm:text-sm">{category}</p>}

      <Price amount={price} compareAt={compareAtPrice} class="pt-1.5" />

      {
        swatches.length > 1 && (
          <ul class="flex gap-1.5 pt-1" aria-label="Доступні кольори">
            {swatches.map((swatch) => (
              <li
                class="border-line-strong h-3.5 w-3.5 rounded-full border"
                style={swatch.hex ? `background-color:${swatch.hex}` : undefined}
                title={swatch.name}
              />
            ))}
          </ul>
        )
      }
    </div>
  </a>
</article>
