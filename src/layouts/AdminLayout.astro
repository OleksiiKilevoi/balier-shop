---
import { Font } from 'astro:assets';

import '~/styles/admin.css';

/**
 * Shell for `/admin/**`. Deliberately not `BaseLayout` — the storefront header,
 * footer and cart popup have no place in the panel, and the admin pages must not
 * inherit the shop chrome as it changes.
 *
 * That separation is total: the panel loads `admin.css` and Geist, and the
 * storefront loads `global.css` with Playfair and Inter — no token, no font and
 * no component crosses between them, and no page loads both sides. `Container`
 * is not imported for the same reason — its `container-page` utility lives in
 * `global.css`; the panel has `admin-container`.
 *
 * Everything under `/admin` is gated by `src/middleware.ts`, so the signed-in
 * identity is present on every screen except the login form itself — which is
 * what `bare` below is for. `noindex` is belt-and-braces on top of that.
 *
 * The theme switch below is the panel's *only* client-side JavaScript, and the
 * reason the old "no script at all" property no longer holds: a chosen theme has
 * to be remembered across requests, and nothing but `localStorage` remembers it.
 * It is one inline script — no framework, no hydration, no extra request — so
 * the panel still ships no JavaScript assets, and every other page here is still
 * plain forms and links. With JavaScript off the switch hides itself and the
 * panel follows the operating system exactly as it did before.
 */

interface Props {
  title: string;
  /**
   * The login screen. Drops the section nav, the signed-in address and the
   * sign-out button — none of them mean anything before there is a session, and
   * a nav that bounces every link back to this page is worse than no nav. The
   * theme switch stays: it is a browser preference, not an admin one.
   */
  bare?: boolean;
}

const { title, bare = false } = Astro.props;
const admin = Astro.locals.admin;

/** The one business-specific string in the panel. Change it, and nothing else. */
const PANEL_NAME = 'Balier';

/** Grows a row per section as Phase 4 lands them (products, content, settings). */
const NAV = [{ href: '/admin/orders', label: 'Замовлення' }];

const pathname = Astro.url.pathname;
---

<html lang="uk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {/* Paints the browser UI to match before the page does. The media queries
        are the no-JavaScript default; the script below re-points them at the
        chosen theme, which is why each carries the scheme it stands for. */}
    <meta name="theme-color" data-scheme="light" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" data-scheme="dark" content="#09090b" media="(prefers-color-scheme: dark)" />
    <title>{title} — {PANEL_NAME} admin</title>

    {/* The panel's one face. Downloaded and self-hosted at build time by Astro's
        font pipeline (see `astro.config.mjs`), so there is no request to Google
        and no third party in front of a signed-in screen. Preloaded because it
        is the only font here — every character on the page waits on it. */}
    <Font cssVariable="--font-geist" preload />

    {/* Inline and blocking on purpose: the stored theme has to be on <html>
        before the first paint, or the page shows the other one and then jumps.
        `is:inline` keeps Astro from turning it into a deferred module, which
        would defeat exactly that. The fade itself lives in `admin.css`. */}
    <script is:inline>
      (() => {
        const KEY = 'admin-theme';
        /** Two states, and that is the whole switch. */
        const NAMES = { light: 'світла', dark: 'темна' };

        const root = document.documentElement;
        const themeColors = document.querySelectorAll('meta[name="theme-color"][data-scheme]');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)');

        /** Storage throws when the browser blocks it; then the panel simply forgets. */
        const chosen = () => {
          try {
            const stored = localStorage.getItem(KEY);
            return stored === 'light' || stored === 'dark' ? stored : null;
          } catch {
            return null;
          }
        };

        /**
         * Until somebody picks a side, the operating system picks it for them —
         * so a first visit still lands on the right theme without the switch
         * having to carry a third state for it.
         */
        const read = () => chosen() || (prefersDark.matches ? 'dark' : 'light');

        const apply = (mode) => {
          root.dataset.theme = mode;
          // Keep the mobile browser chrome in step: exactly one meta applies.
          for (const meta of themeColors) {
            meta.setAttribute(
              'media',
              meta.getAttribute('data-scheme') === mode ? 'all' : 'not all',
            );
          }
        };

        apply(read());

        document.addEventListener('DOMContentLoaded', () => {
          const toggle = document.getElementById('admin-theme-toggle');
          if (!toggle) return;

          // The icon is CSS's job (it reads the same `data-theme`); the name the
          // control announces is this one's, and has to say where it stands now.
          const label = (mode) => {
            toggle.setAttribute('title', 'Тема: ' + NAMES[mode]);
            toggle.setAttribute('aria-label', 'Перемкнути тему. Зараз: ' + NAMES[mode]);
          };
          label(read());

          const still = window.matchMedia('(prefers-reduced-motion: reduce)');

          // The cross-fade is the browser's, driven by the timing in `admin.css`.
          // Anything that cannot do it — an older browser, or an operator who has
          // asked for less motion — simply gets the swap.
          const change = (mode) => {
            const swap = () => {
              apply(mode);
              label(mode);
            };

            if (document.startViewTransition && !still.matches) {
              document.startViewTransition(swap);
            } else {
              swap();
            }
          };

          // Nothing chosen yet means the operating system is still deciding, so
          // it keeps deciding live, as the panel behaved before the switch
          // existed. The first click ends that for this browser.
          prefersDark.addEventListener('change', () => {
            if (chosen()) return;
            change(prefersDark.matches ? 'dark' : 'light');
          });

          toggle.addEventListener('click', () => {
            const next = read() === 'dark' ? 'light' : 'dark';
            try {
              localStorage.setItem(KEY, next);
            } catch {
              /* Not remembered, but the switch still works for this page. */
            }

            change(next);
          });
        });
      })();
    </script>
  </head>

  <body class="flex min-h-dvh flex-col">
    {/* Sticky: the panel's screens are long, and the section switch should not
        require scrolling back to the top of a 40-row order list. */}
    <header class="border-border bg-canvas/85 sticky top-0 z-10 border-b backdrop-blur">
      <div class="admin-container flex min-h-touch flex-wrap items-center gap-x-6 gap-y-2 py-3">
        <a href="/admin" class="text-fg text-[0.9375rem] font-semibold tracking-tight">
          {PANEL_NAME}<span class="text-fg-subtle font-normal"> / адмін</span>
        </a>

        {
          !bare && (
            <nav aria-label="Розділи">
              <ul class="flex gap-1">
                {NAV.map((item) => {
                  const active = pathname.startsWith(item.href);
                  return (
                    <li>
                      <a
                        href={item.href}
                        aria-current={active ? 'page' : undefined}
                        class:list={[
                          'admin-badge min-h-8 px-3 text-sm',
                          active
                            ? 'bg-accent text-accent-fg'
                            : 'text-fg-muted hover:bg-surface-hover hover:text-fg',
                        ]}
                      >
                        {item.label}
                      </a>
                    </li>
                  );
                })}
              </ul>
            </nav>
          )
        }

        <div class="ml-auto flex min-w-0 items-center gap-3">
          {
            !bare && admin && (
              <span class="text-fg-subtle truncate text-xs">{admin.email}</span>
            )
          }

          {/* Both icons ship and CSS shows the one matching `data-theme`, so the
              control is correct in the first paint rather than after a script
              has had a chance to touch it. `aria-label` is replaced on load with
              one naming the current mode; this is the pre-script fallback. */}
          <button
            type="button"
            id="admin-theme-toggle"
            class="admin-theme-toggle admin-icon-btn"
            aria-label="Перемкнути тему"
          >
            <svg
              data-mode="light"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="4" />
              <path
                d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
              />
            </svg>

            <svg
              data-mode="dark"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
            </svg>
          </button>

          {/* A form, not a link: `GET /admin/logout` would be followed by any
              prefetcher that saw it, and would sign the operator out at random.
              As a POST it also picks up Astro's origin check for free. */}
          {
            !bare && admin && (
              <form method="post" action="/admin/logout">
                <button
                  type="submit"
                  class="admin-icon-btn"
                  aria-label="Вийти з панелі"
                  title="Вийти"
                >
                  <svg
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M15 4h3a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-3" />
                    <path d="M10 8l-4 4 4 4M6 12h9" />
                  </svg>
                </button>
              </form>
            )
          }
        </div>
      </div>
    </header>

    <main class="flex-1 py-8 sm:py-10">
      <div class="admin-container">
        <slot />
      </div>
    </main>
  </body>
</html>
