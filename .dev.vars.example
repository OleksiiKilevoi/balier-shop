# Copy to `.dev.vars` and fill in. This file is read by wrangler for local dev
# and by drizzle-kit for migrations. `.dev.vars` is gitignored — never commit it.
#
# In production these are set with: wrangler secret put <NAME>

# Neon pooled connection string (EU Frankfurt project)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/balier?sslmode=require"

# Monobank Acquiring. Use the TEST token until Phase 5.
# https://api.monobank.ua/docs/acquiring.html
MONOBANK_TOKEN=""

# Nova Poshta API key from the business cabinet
NOVAPOSHTA_API_KEY=""

# Cloudflare Turnstile secret key. The site key is public — it lives in
# wrangler.jsonc's `vars` (`PUBLIC_TURNSTILE_SITE_KEY`), not here.
TURNSTILE_SECRET_KEY=""

# Telegram bot for new-order notifications
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Cloudflare Access — the /admin gate. Neither value is a credential (the gate
# rests on the JWT signature), but both are account-specific, so they are set
# per environment instead of living in wrangler.jsonc. Unset = every /admin
# request is denied. `pnpm dev` bypasses the gate entirely, so these are only
# needed for `pnpm preview` and the deployed Worker.
#   TEAM_DOMAIN: the Zero Trust team, e.g. "balier" or the full
#                "https://balier.cloudflareaccess.com"
#   AUD:         the Access application's Application Audience tag
CF_ACCESS_TEAM_DOMAIN=""
CF_ACCESS_AUD=""
