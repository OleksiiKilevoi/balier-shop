# Copy to `.dev.vars` and fill in. Since the workspace split each Worker reads
# its own `.dev.vars` (apps/site, apps/admin, workers/cron — see the
# `.dev.vars.example` next to each); this root file feeds only the Node-side
# tooling: drizzle-kit (db:migrate / db:studio) and `scripts/*.ts`.
# `.dev.vars` is gitignored — never commit it.

# Neon pooled connection string (EU Frankfurt project)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/balier?sslmode=require"

# Neon direct (non-pooled) connection string — occasionally useful for
# long-running DDL under drizzle-kit; nothing in the code reads it.
DATABASE_URL_NONPOOL=""

# Nova Poshta API key — `pnpm np:sync` (scripts/sync-novaposhta.ts)
NOVAPOSHTA_API_KEY=""

# Sentry sourcemap upload — `pnpm cron:deploy` (workers/cron/deploy.mjs).
# Build-time credentials, not Worker runtime config: the same three values
# also live in the Workers Builds build variables of balier-dev and
# balier-admin-dev, where the site/admin uploads run. Without them the cron
# deploy still works, it just skips the upload (stack traces stay minified).
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT="balier"
