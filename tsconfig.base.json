{
  // Shared compiler baseline. The Astro apps layer `astro/tsconfigs/strict` on
  // top of this; packages/lib and workers/cron extend it directly, so it must
  // carry a full standalone configuration, not just the strictness flags.
  "compilerOptions": {
    "strict": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "forceConsistentCasingInFileNames": true
  }
}
